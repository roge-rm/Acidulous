    <string name="main_scene_page">%1$d–%2$d / %3$d</string>
    <!-- A number of bars, where there is room for a number and a letter: "4b". -->
    <string name="main_bars_short">%dm</string>
    <!-- Which pass of a repeating scene is playing: "r2". -->
    <string name="main_repeat_short">r%d</string>
    <!-- On a clip: it plays once, rather than looping. -->
    <string name="main_clip_once_short">1</string>
    <!-- On a clip: it is muted. -->
    <string name="main_clip_mute_short">M</string>
