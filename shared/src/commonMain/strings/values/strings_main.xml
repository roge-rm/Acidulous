<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ui/MainScreen.kt: the song grid, its header, menus and readout. -->
    <string name="main_freezing">Freezing</string>

    <!-- The readout under the grid -->
    <!-- Clip mode with nothing playing. -->
    <string name="main_where_clips_idle">-</string>
    <!-- Clip mode: one playing track as its name, then bar.beat/bars in its clip's cycle. -->
    <string name="main_where_clip">%1$s %2$d.%3$d/%4$d</string>
    <string name="main_counting_in">counting in… %d</string>
    <!-- The scene\'s number and name as on its header, the pass of its repeats (×1/2), then bar.beat. -->
    <string name="main_where_song">%1$d %2$s \u0020×%3$d/%4$d \u0020bar %5$d.%6$d</string>
    <!-- The time on the right: where the playhead is in the song / the song's length. -->
    <string name="main_time_at">%1$s/%2$s</string>
    <!-- The time left to the end of the song. -->
    <string name="main_time_left">-%s</string>
    <!-- The time since play was pressed. -->
    <string name="main_time_since">+%s</string>
    <!-- What a tap on the time does, for a screen reader. -->
    <string name="main_time_switch">switch the time shown</string>

    <!-- The bar at the foot -->
    <string name="main_quantise_pill">q: %s</string>
    <!-- Play runs to the end of the song and stops. -->
    <string name="main_loop_end">⇥ end</string>
    <string name="main_loop_scene">⟳ scene</string>
    <string name="main_loop_song">⟳ song</string>

    <!-- The header -->
    <string name="main_save">save</string>
    <string name="main_file">file ▾</string>
    <string name="main_new_song">New song…</string>
    <string name="main_save_as">Save as…</string>
    <string name="main_songs">Songs…</string>
    <string name="main_import">Import…</string>
    <string name="main_export">Export…</string>
    <string name="main_share_song">Share song…</string>
    <string name="main_midi">MIDI…</string>
    <string name="main_sound">Sound…</string>
    <string name="main_settings">Settings…</string>
    <string name="main_help">Help…</string>
    <string name="main_about">About…</string>
    <string name="main_mode_clip">▶ clip</string>
    <string name="main_mode_song">☰ song</string>

    <!-- The grid -->
    <string name="main_add_track">+ track</string>
    <string name="main_add_scene">+ scene</string>
    <!-- The scenes on the page, with TalkBack on: first to last, of how many. -->
    <string name="main_scene_page">%1$d–%2$d / %3$d</string>
    <!-- A number of bars, where there is room for a number and a letter: "4b". -->
    <string name="main_bars_short">%db</string>
    <!-- Which pass of a repeating scene is playing: "r2". -->
    <string name="main_repeat_short">r%d</string>
    <!-- On a clip: it plays once, rather than looping. -->
    <string name="main_clip_once_short">1</string>
    <!-- On a clip: it is muted. -->
    <string name="main_clip_mute_short">M</string>
    <string name="main_track_name">Track name</string>
    <string name="main_save_as_title">Save as</string>
    <string name="main_new_song_title">New song</string>
    <string name="main_untitled">Untitled</string>

    <!-- A scene\'s menu -->
    <string name="main_loop_this_scene">Loop this scene</string>
    <string name="main_play_on">Play on from here</string>
    <string name="main_freeze_scene">Freeze scene (%d)</string>
    <string name="main_thaw_scene">Thaw scene (%d)</string>
    <string name="main_insert_after">Insert after</string>
    <string name="main_duplicate">Duplicate</string>
    <string name="main_move_left">Move left</string>
    <string name="main_move_right">Move right</string>
    <string name="main_delete">Delete</string>

    <!-- A track\'s menu -->
    <string name="main_change_machine">Change machine…</string>
    <string name="main_rename">Rename…</string>
    <string name="main_freeze_track">Freeze track (%d)</string>
    <string name="main_thaw_track">Thaw track (%d)</string>

    <!-- Launch quantise -->
    <string name="quantise_title">Launch quantise</string>
    <string name="quantise_clips_start">clips start on</string>
    <string name="quantise_clips_start_note">A tapped clip waits for this line.</string>
    <!-- The same for the desktop build, where the pointer is a mouse. -->
    <string name="quantise_clips_start_note_mouse">A clicked clip waits for this line.</string>
    <string name="quantise_clip_end">clip end</string>
    <!-- A line every so many bars; one word whatever the number. -->
    <string name="quantise_bars" tools:ignore="PluralsCandidate">%d bar</string>
    <string name="quantise_end_short">end</string>
    <string name="quantise_loops_record">loops record for</string>
    <string name="quantise_until_tapped">until tapped</string>
    <string name="quantise_until_tapped_mouse">until clicked</string>

    <!-- The slide-up panel\'s pages, turned on their side. -->
    <string-array name="main_panel_pages">
        <item>mix</item>
        <item>hold</item>
        <item>pad</item>
        <item>live</item>
    </string-array>
    <!-- A line at the top of the song screen when a newer version has been released. -->
    <string name="update_out">Acidulous %1$s is out</string>
    <!-- Opens the release page. -->
    <string name="update_get">get it</string>
    <!-- What TalkBack calls the line's close button. -->
    <string name="update_close">Close</string>
</resources>
