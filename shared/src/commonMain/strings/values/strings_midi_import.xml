<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ui/MidiImportDialog.kt: bringing a MIDI file in as a new song. -->
    <string name="import_title">Import MIDI</string>
    <string name="import_confirm">Import</string>
    <string name="import_arrangement">arrangement · %s</string>
    <string name="import_scenes_of">scenes of</string>
    <plurals name="import_scenes">
        <item quantity="one">%d scene</item>
        <item quantity="other">%d scenes</item>
    </plurals>
    <!-- Scenes, bars, then the tempo and time signature the file set. -->
    <string name="import_summary">%1$s · %2$s · %3$.0f bpm · %4$d/%5$d</string>
    <string name="import_tracks">tracks</string>
    <plurals name="import_notes">
        <item quantity="one">%d note</item>
        <item quantity="other">%d notes</item>
    </plurals>
    <!-- A part: its MIDI channel and how many notes. -->
    <string name="import_part">ch %1$d · %2$s</string>
    <!-- The same, when the chosen machine has no sound for some of them. -->
    <string name="import_part_lost" tools:ignore="PluralsCandidate">ch %1$d · %2$s · %3$d with no sound here</string>
    <string name="import_skip">skip</string>
</resources>
