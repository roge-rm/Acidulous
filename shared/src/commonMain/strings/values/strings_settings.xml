<resources>
    <!-- ui/SettingsDialog.kt. The readings card shows only with diagnostics on and stays in English. -->
    <string name="settings_title">Settings</string>
    <string-array name="settings_tabs">
        <item>display</item>
        <item>audio</item>
        <item>record</item>
        <item>songs</item>
    </string-array>
    <string name="settings_screen">screen</string>
    <string name="settings_theme">theme</string>
    <string name="settings_octaves">keyboard octaves</string>
    <string-array name="settings_octaves_choices">
        <item>auto</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
        <item>5</item>
    </string-array>
    <string name="settings_stay_awake">stay awake</string>
    <string name="settings_language">language</string>
    <!-- The system's language, then each language named in itself, as a menu item starts: these stay as they are in every translation. In the order of UiPrefs.Language. -->
    <string-array name="settings_language_choices">
        <item>system</item>
        <item>English</item>
        <item>Français (Canada)</item>
        <item>Français (France)</item>
    </string-array>
    <string-array name="settings_theme_choices">
        <item>auto</item>
        <item>light</item>
        <item>dark</item>
        <item>high contrast</item>
    </string-array>
    <string name="settings_size">size</string>
    <!-- The desktop build's output choice; the phone has none. -->
    <string name="settings_output">output</string>
    <string name="settings_output_device">play through</string>
    <string name="settings_output_default">system default</string>
    <!-- An audio interface's own driver in a computer's list of outputs: its maker's name for it, marked as the fast option. -->
    <string name="settings_output_driver">%1$s · low latency</string>
    <!-- Desktop build only: how big a dp is on this screen. "system" uses the computer's own value. -->
    <string name="settings_screen_scale">screen scale</string>
    <string-array name="settings_screen_scale_choices">
        <item>system</item>
        <item>1×</item>
        <item>1.5×</item>
        <item>2×</item>
        <item>2.5×</item>
        <item>3×</item>
    </string-array>
    <string-array name="settings_size_choices">
        <item>normal</item>
        <item>large</item>
        <item>larger</item>
        <item>largest</item>
    </string-array>
    <string name="settings_diagnostics">diagnostics</string>
    <string-array name="settings_diagnostics_choices">
        <item>show</item>
        <item>hide</item>
    </string-array>
    <!-- Under the size switch, when the screen is too small for the size chosen. -->
    <string name="settings_size_capped">This screen only has room for %.2fx.</string>
    <string name="settings_engine">engine</string>
    <string name="settings_buffer">buffer</string>
    <string name="settings_buffer_tight">tight</string>
    <string name="settings_buffer_balanced">balanced</string>
    <string name="settings_buffer_safe">safe</string>
    <string name="settings_voices">voices</string>
    <string name="settings_voices_all">all</string>
    <string name="settings_cores">cores</string>
    <string name="settings_cores_auto">auto</string>
    <string name="settings_quality">quality</string>
    <string-array name="settings_quality_choices">
        <item>full</item>
        <item>lean</item>
        <item>auto</item>
    </string-array>
    <string name="settings_recording">recording</string>
    <!-- Bits per sample for recordings and exports. -->
    <string name="settings_depth">depth</string>
    <!-- Bars of clicks before recording starts. -->
    <string name="settings_count_in">count-in</string>
    <!-- Whether recorded notes are moved onto the clip's grid, and how far. -->
    <string name="settings_quantise">quantise</string>
    <string name="settings_amount">amount</string>
    <!-- Whether a take adds to the clip's notes or replaces the ones it plays over. -->
    <string name="settings_take">take</string>
    <string-array name="settings_take_choices">
        <item>add</item>
        <item>replace</item>
    </string-array>
    <!-- Whether recording starts with play, or waits for the first note played. -->
    <string name="settings_start">start</string>
    <string-array name="settings_start_choices">
        <item>on play</item>
        <item>first note</item>
    </string-array>
    <!-- Whether recording carries on round the loop, or stops after one pass. -->
    <string name="settings_passes">passes</string>
    <string-array name="settings_passes_choices">
        <item>loop</item>
        <item>once</item>
    </string-array>
    <string-array name="settings_depth_choices">
        <item>24-bit</item>
        <item>16-bit</item>
    </string-array>
    <string name="settings_new_song">new song</string>
    <string name="settings_tempo">tempo</string>
    <string name="settings_signature">signature</string>
    <string name="settings_machine">machine</string>
    <!-- Under None in the picker, when choosing what a new song starts with. -->
    <string name="settings_machine_none_about">a new song starts with no tracks: add the first yourself</string>
    <string name="settings_track_scale">track scale</string>
    <string name="settings_root">root</string>
    <string name="settings_scale">scale</string>
    <string name="settings_arriving">where arriving notes go</string>
    <string name="settings_arriving_to">to</string>
    <string-array name="settings_arriving_choices">
        <item>follow</item>
        <item>pinned</item>
        <item>by channel</item>
    </string-array>
    <string name="settings_arriving_track">track</string>
</resources>
