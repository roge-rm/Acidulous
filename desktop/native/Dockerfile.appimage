# The toolchain for the AppImages: Ubuntu 22.04, so the engine is linked
# against glibc 2.35 and runs on that and everything newer - Ubuntu 22.04 and
# 24.04, Fedora, Arch, the Steam Deck - where the Debian package's engine,
# built on Trixie, needs 2.41. The C++ runtime is linked in (see
# build.gradle.kts), so the only system library it asks for is glibc.
# Compiles for x86-64 natively and for 64-bit ARM with the cross compiler;
# it runs no ARM code.
FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        g++ gcc g++-aarch64-linux-gnu gcc-aarch64-linux-gnu cmake make ccache openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*
