# One voice playing a chord, fifty times a second. This is where
# chiptune harmony came from - there were not enough channels to hold
# one each, so the channel took turns.
patch "Major Arp" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Wobble"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #2
  mac4_a1  0.4
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  mono           #1
  framerate      50 Hz
  ampattack      0.001 s
  ampdecay       0.5 s
  ampsustain     0.75
  amprelease     0.05 s
  volume         0.72
  set arp "0 4 7"

