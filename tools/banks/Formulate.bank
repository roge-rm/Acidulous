  cutoff         12000 Hz
  ampattack      0.001 s
  ampdecay       0.4 s
  ampsustain     0.7
  amprelease     0.05 s
  volume         0.80

# The noise register on its short loop. It stops being noise and starts
# being a pitch - a very ugly one, which is the point.
