  mac2_a1  0.7
  mac3_d1  #5
  mac3_a1  -0.5
  mac4_d1  #6
  mac4_a1  0.4
  mac5_d1  #22
  mac5_a1  0.12
  mac6_d1  #21
  mac6_a1  0.3
