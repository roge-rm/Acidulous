  mac2_a1  -0.13
  mac3_d1  #2
  mac3_a1  0.25
  mac3_d2  #3
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.3
  mac5_d1  #20
  mac5_a1  -0.25
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #22
  mac6_a1  0.15
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.25
  mono           #1
  ampattack      0.001 s
  ampdecay       0.3 s
  ampsustain     0.6
  amprelease     0.05 s
  volume         0.89
  insert Delay
    time         #3
    feedback     0.4
    tone         4000 Hz
    mode         #1
    mix          0.3
  send reverb    0.1

# Not a chip waveform - the hardware could not make one - which is why
# it is here: the machine is a chip *and* an equation, and this is the
# oscillator being honest about the second part.
patch "Chip Saw" note=60 range=45..84 family=lead
  set macro1 "Tone"
  set macro2 "Sub"
  set macro3 "Crunch"
  set macro4 "Soft"
  set macro5 "Short"
  set macro6 "Glide"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.3
  mac1_d2  #15
  mac1_a2  0.15
  mac2_d1  #4
  mac2_a1  0.5
  mac3_d1  #5
  mac3_a1  -0.5
  mac3_d2  #6
  mac3_a2  0.3
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #20
  mac5_a1  -0.25
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #22
  mac6_a1  0.15
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #2
  mono           #1
  cutoff         8000 Hz
  ampattack      0.001 s
  ampdecay       0.5 s
  ampsustain     0.7
  amprelease     0.06 s
  volume         1.33

# Four levels. Everything quiet in the source becomes a staircase, and
# the distortion is the quantiser rather than a clipper.
patch "Four Level" note=60 range=45..84 family=lead
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Wobble"
  set macro4 "Clean"
  set macro5 "Crush"
  set macro6 "Short"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #2
  mac3_a1  0.25
  mac3_d2  #3
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  0.6
  mac5_d1  #6
  mac5_a1  0.4
  mac6_d1  #20
  mac6_a1  -0.25
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  bits           #1
  mono           #1
  ampattack      0.001 s
  ampdecay       0.6 s
  ampsustain     0.7
  amprelease     0.06 s
  volume         0.99

# Two levels: on and off. Every patch in this bank passes through the
