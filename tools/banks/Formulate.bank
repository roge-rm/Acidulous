# Two steps an octave apart at full rate: not a chord any more, a
# timbre. The pitch you hear is the note; the octave is texture.
patch "Octave Trill" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Wobble"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #2
  mac4_a1  0.4
  mac4_d2  #3
  mac4_a2  0.3
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  mono           #1
  framerate      60 Hz
  ampattack      0.001 s
  ampdecay       0.7 s
  ampsustain     0.8
  amprelease     0.05 s
  volume         0.68
  set arp "0 12"

# The note and the tone above, sixteen times a second. Slow enough to
# hear as a trill rather than a chord.
patch "Tone Trill" note=64 range=48..88 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Fast"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.13
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #13
  mac4_a1  0.2
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.25
  mono           #1
  framerate      16 Hz
  ampattack      0.001 s
  ampdecay       0.6 s
  ampsustain     0.75
  amprelease     0.08 s
  volume         0.70
  set arp "0 2"
  send reverb    0.15

# A volume table with silences in it, so one key gives four hits that
# get quieter. A delay made of a list, and it costs nothing.
patch "Frame Echo" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Wobble"
  set macro5 "Crunch"
  set macro6 "Sub"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.13
  mac3_d1  #13
  mac3_a1  -0.25
  mac4_d1  #2
  mac4_a1  0.4
  mac4_d2  #3
  mac4_a2  0.3
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #4
  mac6_a1  0.5
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.25
  framerate      30 Hz
  ampattack      0.001 s
  ampdecay       4 s
  ampsustain     1
  amprelease     0.05 s
  volume         1.50
  set vol "255 90 0 0 200 60 0 0 150 40 0 0 100 25 0 0 60 12 0 0 |"

# The chord arpeggio with its volume table stepping down, into a
# ping-pong delay, so each note leaves a trail of the chord behind it.
patch "Echo Arp" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Wobble"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #2
  mac4_a1  0.4
  mac4_d2  #3
  mac4_a2  0.3
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  framerate      40 Hz
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.5
  amprelease     0.1 s
  volume         0.9
  set arp "0 4 7 12"
  set vol "255 240 225 210 195 180 165 150 |"
  insert Delay
    time         #3
    feedback     0.45
    tone         3500 Hz
    mode         #1
    mix          0.3
  send reverb    0.15

# The pulse width stepped through a table instead of swept by an LFO.
# Stepped is what the hardware did, and it does not sound the same.
patch "Duty Sweep" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Slow"
  set macro4 "Sub"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #4
  mac4_a1  0.5
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  framerate      36 Hz
  mono           #1
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.8
  amprelease     0.06 s
  volume         0.75
  set duty "32 64 96 128 160 192 160 128 96 64 |"

# Arp, duty and volume tables all moving at once at the same rate: the
# fifth is thin, the octave is wide, and each step is quieter than the
# last, so one key plays a small figure.
patch "Duty Arp" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Slow"
  set macro4 "Sub"
  set macro5 "Crunch"
  set macro6 "Smooth"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #4
  mac4_a1  0.5
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #7
  mac6_a1  0.5
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  mono           #1
  framerate      20 Hz
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.8
  amprelease     0.06 s
  volume         0.91
  set arp "0 7 12 7"
  set duty "128 32 160 64"
  set vol "255 200 230 170 210 150 190 130 |"

# The same arpeggio at twelve steps a second instead of fifty. Slow
# enough to be a riff rather than a chord, which is the whole of the
# frame rate knob.
patch "Slow Frame" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Fast"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.13
  mac3_d1  #13
  mac3_a1  -0.2
  mac4_d1  #13
  mac4_a1  0.2
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.25
  mono           #1
  framerate      12 Hz
  ampattack      0.001 s
  ampdecay       1.2 s
  ampsustain     0.85
  amprelease     0.05 s
  volume         0.73
  set arp "0 7 12 7 3 7 12 19"

# The note in three octaves, up and down, twenty steps a second.
# A triangle, so the low octave has weight and the top one does not
# bite.
patch "Octave Run" note=55 range=40..76 family=arp
  set macro1 "Tone"
  set macro2 "Pluck"
  set macro3 "Slow"
  set macro4 "Fast"
  set macro5 "Crunch"
  set macro6 "Sub"
  set macro7 "Drive"
  set macro8 "Smooth"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.35
  mac2_d2  #16
  mac2_a2  0.3
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #13
  mac4_a1  0.2
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #4
  mac6_a1  0.5
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #7
  mac8_a1  0.5
  wave           #1
  mono           #1
  framerate      20 Hz
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.8
  amprelease     0.06 s
  volume         1.17
  set arp "-12 0 12 24 12 0"

# The tables clocked from the transport rather than from a rate in
# hertz, so the arpeggio stays with the song when the tempo moves.
# No chip could do this; every tracker wished it could.
patch "Locked Arp" note=60 range=45..84 family=arp
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Wobble"
  set macro4 "Crunch"
  set macro5 "Short"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #2
  mac3_a1  0.4
  mac3_d2  #3
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #20
  mac5_a1  -0.3
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  mono           #1
  framesync      #1
  tableretrig    #1
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.8
  amprelease     0.05 s
  volume         0.68
  set arp "0 4 7 12 7 4"

# A minor run up two octaves, locked to the song's sixteenths, with a
# volume table that accents every fourth step and a duty table that
# narrows on the way up.
patch "Locked Run" note=57 range=45..81 family=arp
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Short"
  set macro6 "Smooth"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #20
  mac5_a1  -0.3
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #7
  mac6_a1  0.5
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  mono           #1
  framesync      #1
  tableretrig    #1
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.8
  amprelease     0.05 s
  volume         0.8
  set arp "0 3 7 12 15 19 24 19"
  set duty "128 112 96 80 64 48 32 48"
  set vol "255 150 180 150 255 150 180 150"
  send reverb    0.1

# The chip's own sample multiplied by a sine from the language. Ring
# mode, so what you hear is the hardware being shaped rather than
# replaced - that is what `x` is for.
patch "Ring Chip" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Ring"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #9
  mac3_a1  0.167
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  formula        1
  formulamode    #2
  timescale      0.879
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.6
  amprelease     0.1 s
  volume         1.02
  set formula "sin(t) + 128"

# The same ring, with the sine an octave above the note, so the chip
# picks up a fifth above the octave.
patch "Octave Ring" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Ring"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #9
  mac3_a1  0.167
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  formula        1
  formulamode    #2
  timescale      0.587
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.6
  amprelease     0.1 s
  volume         0.98
  set formula "sin(t) + 128"
  send reverb    0.1

# The chop is a volume table at twenty-four steps a second, which is how
# a tracker did it - the formula's own clock has a floor of 0.125 and
# cannot go that slow. The formula is doing the grit instead.
patch "Gated Grit" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Ring"
  set macro3 "Slow"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #9
  mac2_a1  0.167
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.125
  bits           #4
  formula        1
  formulamode    #4
  timescale      0.147
  framerate      24 Hz
  ampattack      0.001 s
  ampdecay       0.5 s
  ampsustain     0.7
  amprelease     0.1 s
  volume         0.98
  set formula "t & 64 ? 255 : 0"
  set arp "0 0 12 7"
  set vol "255 255 0 0 255 0 255 0"

# A saw let through for the first two thirds of each of its own cycles
# and held at the centre for the rest. The `a` macro sets how much gets
# through, so the knob works like hard sync.
patch "Pulse Gate" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Gate"
  set macro3 "Thin"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #10
  mac2_a1  -0.35
  mac3_d1  #1
  mac3_a1  -0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #2
  formula        1
  formulamode    #3
  timescale      0.293
  a              176
  ampattack      0.001 s
  ampdecay       0.7 s
  ampsustain     0.7
  amprelease     0.08 s
  volume         1.5
  set formula "(t & 255) < a ? 255 : 0"

# The oscillator exclusive-ORed with a ramp. There is no analogue
# equivalent of this at all - it is an arithmetic operation on a number
# that happens to be a sound.
patch "Xor Fold" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Ring"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #9
  mac3_a1  0.167
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #1
  formula        1
  formulamode    #4
  timescale      0.293
  ampattack      0.001 s
  ampdecay       0.7 s
  ampsustain     0.65
  amprelease     0.08 s
  cutoff         9000 Hz
  volume         1.28
  set formula "t & 255"

# The chip's sample with bits knocked out of it by the `a` macro, so
# the knob is a bit pattern rather than a level. Turn it and the timbre
# changes in steps, because bits do.
patch "Bit Mask" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Mask"
  set macro3 "Thin"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #10
  mac2_a1  -0.4
  mac2_d2  #24
  mac2_a2  0.15
  mac3_d1  #1
  mac3_a1  -0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  a              200
  formula        1
  formulamode    #1
  ampattack      0.001 s
  ampdecay       0.9 s
  ampsustain     0.7
  amprelease     0.08 s
  volume         0.88
  set formula "x & (a | 15)"

# The triangle with everything under `a` held at `a`, then stretched
# back to full size. Half-wave rectified at the centre, and the whole
# wave again as the knob comes down.
patch "Half Wave" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Floor"
  set macro3 "Thin"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #10
  mac2_a1  -0.4
  mac3_d1  #1
  mac3_a1  -0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #1
  a              128
  formula        1
  formulamode    #1
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.7
  amprelease     0.08 s
  volume         1.10
  set formula "(max(x, a) - a) * 256 / (256 - a)"

# Full-wave rectification, written as arithmetic: everything below the
# centre is folded above it, which doubles the pitch and fills the
# spectrum with even harmonics.
patch "Fold Over" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Smooth"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #7
  mac3_a1  0.5
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #1
  formula        1
  formulamode    #1
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.7
  amprelease     0.08 s
  cutoff         10000 Hz
  volume         1.12
  set formula "abs(x - 128) * 2"

# **The formula reading the tables.** `s` is the table's step counter,
# so the expression changes with every frame the arpeggio advances -
# the two halves of the machine driving each other rather than sitting
# side by side.
patch "Step Ring" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Slow"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #13
  mac3_a1  -0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  formula        1
  formulamode    #2
  framerate      24 Hz
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.7
  amprelease     0.1 s
  volume         1.13
  set formula "(s * 40 + 80) & 255"
  set arp "0 3 7 10 12 10 7 3"

# `n` is the MIDI note, so the amount of shaping changes as you move up
# the keyboard - bright and clean at the top, mangled at the bottom.
# One patch that is two instruments depending on where you play it.
patch "Note Shape" note=60 range=36..84 family=shape
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Ring"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
