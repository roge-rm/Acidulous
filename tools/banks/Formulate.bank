  formula        1
  formulamode    #4
  timescale      0.587
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.7
  amprelease     0.08 s
  volume         1.29
  set formula "t >> (n >> 4) & 255"

# How hard the key is hit decides how much of the chip survives. Not a
# filter and not a level - the arithmetic itself is velocity sensitive.
patch "Velocity Grit" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Wobble"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #2
  mac3_a1  0.4
  mac3_d2  #3
  mac3_a2  0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.375
  formula        1
  formulamode    #2
  velocity       0
  ampattack      0.001 s
  ampdecay       0.7 s
  ampsustain     0.7
  amprelease     0.08 s
  volume         0.85
  set formula "x * v >> 6"

# Random low bits flipped in the chip's own sample. `c` is the mask,
# so the knob adds static in steps, and the higher it goes the more of
# the pulse is noise.
patch "Static Mask" note=60 range=45..84 family=shape
  set macro1 "Tone"
  set macro2 "Static"
  set macro3 "Thin"
  set macro4 "Plain"
  set macro5 "Crunch"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #12
  mac2_a1  0.4
  mac3_d1  #1
  mac3_a1  -0.3
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.375
  c              15
  formula        1
  formulamode    #4
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.7
  amprelease     0.08 s
  cutoff         9000 Hz
  volume         0.80
  set formula "rnd() & c"

# A sine that no chip ever had, written in four characters and tuned to
# the note by the time scale. `sin()` has a cycle of 256 and one note
# period is 873 units of `t`, so 256/873 = 0.293 puts it on the key.
patch "Pure Sine" note=60 range=36..84 family=formula role=pad
  set macro1 "Grit"
  set macro2 "Crush"
  set macro3 "Swell"
  set macro4 "Short"
  set macro5 "Tail"
  set macro6 "Drive"
  set macro7 "Octave"
  set macro8 "Low"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  -0.6
  mac2_d1  #6
  mac2_a1  0.3
  mac3_d1  #19
  mac3_a1  0.45
  mac4_d1  #20
  mac4_a1  -0.3
  mac4_d2  #21
  mac4_a2  -0.2
  mac5_d1  #21
  mac5_a1  0.3
  mac6_d1  #23
  mac6_a1  0.6
  mac6_d2  #24
  mac6_a2  -0.1
  mac7_d1  #26
  mac7_a1  0.5
  mac8_d1  #26
  mac8_a1  -0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  ampattack      0.02 s
  ampdecay       1 s
  ampsustain     0.85
  amprelease     0.2 s
  volume         0.99
  set formula "sin(t) + 128"

# A ramp up and back down, built from the counter. The cycle is 512,
# so the time scale is 512/873 = 0.587.
patch "Formula Triangle" note=60 range=36..84 family=formula
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.587
  ampattack      0.002 s
  ampdecay       0.8 s
  ampsustain     0.75
  amprelease     0.1 s
  volume         1.27
  set formula "(t & 256) ? 255 - (t & 255) : (t & 255)"

# A square built out of a comparison rather than out of hardware. The
# point is not that it sounds different - it is that the duty is an
# expression, so it can depend on anything.
patch "Formula Square" note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Width"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #11
  mac2_a1  0.4
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  b              96
  ampattack      0.001 s
  ampdecay       0.6 s
  ampsustain     0.7
  amprelease     0.06 s
  volume         0.77
  set formula "(t & 255) < b ? 255 : 0"

# The square again, with its width walking up from an eighth to most
# of the cycle and starting over. The counter does the sweeping, so it
# runs faster on high notes, and `a` sets the speed.
patch "Formula Sweep" note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Speed"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #10
  mac2_a1  0.3
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  a              128
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.75
  amprelease     0.08 s
  volume         0.86
  set formula "((t & 255) < ((((t >> 9) * a >> 9) & 191) + 32)) ? 255 : 0"

# A sine stepped through the note's first four harmonics: root,
# octave, fifth above it, two octaves. An arpeggio written in the
# formula, with `a` for the speed.
patch "Overtone Arp" note=60 range=45..79 family=formula
  set macro1 "Tone"
  set macro2 "Speed"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #10
  mac2_a1  0.3
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  a              128
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.8
  amprelease     0.1 s
  volume         0.87
  set formula "sin(t * ((((t >> 13) * a >> 7) & 3) + 1)) + 128"
  send reverb    0.12

# The AND of a counter with itself shifted, which draws the Sierpinski
# gasket if you plot it and buzzes in a self-similar way if you listen
# to it - bits knocked out of a ramp at nested scales, so it pulses at
# several rates at once. One of the oldest of these and still one of
# the strangest.
# #
# # The doubling matters. Raw, the expression is zero a tenth of the
# # time and under an eighth of full scale for nearly half of it - mean
# # 64 where centre is 128 - so it sits near the negative rail and
# # spikes upward, and the blocker then removes half of full scale. At
# # twice the size it uses the range it was always drawing in.
patch Sierpinski note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      1.174
  ampattack      0.001 s
  ampdecay       0.9 s
  ampsustain     0.7
  amprelease     0.08 s
  cutoff         11000 Hz
  volume         0.89
  set formula "min((t & t >> 8) * 2, 255)"

# A saw whose harmonic counts up, one, two, three, four, and starts
# again. `c` sets how far it counts.
patch "Harmonic Walk" note=55 range=40..79 family=formula
  set macro1 "Tone"
  set macro2 "Reach"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #12
  mac2_a1  0.25
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  c              24
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.75
  amprelease     0.1 s
  cutoff         8000 Hz
  volume         1.22
  set formula "(t * (((t >> 14) & (c >> 3)) + 1)) & 255"

# Shift, mask, multiply: the multiplier *is* the wave's rate of change,
# so it steps between the note and its third, fifth and seventh
# harmonics about three times a second. A melody of timbres, which is
# what these expressions sound like when they are given room.
# #
# # The published ones assume a free-running clock at eight kilohertz
# # where `t >> 12` turns over twice a second. Here `t` is *pitched* and
# # runs at 1.78 a sample, so the same shifts put `t >> 8` at 334 Hz -
# # the pitch being re-rolled three hundred times a second, which is a
# # fizz rather than a sound. Every published formula needs its shifts
# # moved right before it means anything here.
patch "Byte Crunch" note=55 range=40..79 family=formula
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  ampattack      0.001 s
  ampdecay       1.2 s
  ampsustain     0.75
  amprelease     0.1 s
  cutoff         9000 Hz
  volume         1.21
  set formula "(t * (((t >> 16 | t >> 14) & 7) | 1)) & 255"

# An expression that writes its own tune: the shifts pick out different
# bits at different times, so it walks a scale nobody chose. The steps
# are even - two, four, six, eight - where Crunch's are odd, which is
# the difference between a tune in octaves and one in fifths.
# #
# # Two things had to be right. The `+ 1`: without it the mask lets the
# # multiplier reach zero a quarter of the time, and zero is not silence
# # here - centre is 128, so it is full-scale negative. And the melody
# # has to step *slowly*, `t >> 18` rather than `t >> 8`: at the fast
# # rate the changes themselves were a 39 Hz square wave under the tune,
# # and 98% of the patch sat below half the note. Now 0.01% does.
patch "Bit Melody" note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      4.69
  cutoff         5200 Hz
  resonance      0.2
  ampattack      0.001 s
  ampdecay       1.4 s
  ampsustain     0.8
  amprelease     0.1 s
  volume         1.12
  set formula "(t >> 4) * ((t >> 18 & 6) + 2) & 255"

# Eight values in a scrambled order, each held for thirty-two ticks, and
# the set of them repeating exactly once per note. A sample-and-hold
# written as multiplication: `rnd()` cannot do it, being fresh every
# sample with no memory behind it, so the held randomness comes out of
# the arithmetic instead - 97 and 256 are coprime, so multiplying by it
# walks the range in an order that sounds unplanned.
# #
# # In a *pitched* machine a sample-and-hold is a waveform rather than a
# # slow random: eight steps inside four milliseconds is a timbre. What
# # matters is that the pattern closes at the note. It used to step by
# # 37 and wrap after 6.9 holds, which put a saw at 4.62 times the note
# # - between a major third and a fourth, which is not an interval.
patch "Held Steps" note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #14
  mac2_a1  -0.25
  mac2_d2  #15
  mac2_a2  0.6
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  ampattack      0.001 s
  ampdecay       0.5 s
  ampsustain     0.4
  amprelease     0.08 s
  cutoff         7000 Hz
  resonance      0.3
  volume         1.50
  set formula "(((t >> 5) & 7) * 97) & 255"

# A saw ORed with its own third harmonic, masked by a slower copy of
# the counter, so bits of the twelfth flicker through it. Bytebeat as
# it is usually written, with the shifts moved so it stays on the
# note. `a` speeds up the mask.
patch Flicker note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Chaos"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #10
  mac2_a1  0.4
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  a              64
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.75
  amprelease     0.1 s
  cutoff         8000 Hz
  volume         1.21
  set formula "(t | ((t * 3) & (t * a >> 13))) & 255"

# Additive synthesis in one line: a fundamental and its octave, added
# and rescaled to fit. The language has no floating point, so the
# halving is a shift.
patch "Two Sines" note=57 range=40..84 family=formula role=pad
  set macro1 "Tone"
  set macro2 "Grit"
  set macro3 "Crush"
  set macro4 "Swell"
  set macro5 "Short"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #5
  mac2_a1  -0.6
  mac3_d1  #6
  mac3_a1  0.3
  mac4_d1  #19
  mac4_a1  0.45
  mac5_d1  #20
  mac5_a1  -0.3
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  ampattack      0.05 s
  ampdecay       1.2 s
  ampsustain     0.8
  amprelease     0.25 s
  volume         1.44
  set formula "(sin(t) * 5 >> 3) + (sin(t * 2) * 5 >> 4) + 128"

# Three sines at the note, the octave and the twelfth, like an organ's
# first drawbars. `b` pulls out the top one. The sum is clamped, so
# with the top all the way out it clips rather than wraps.
patch "Formula Organ" note=57 range=36..84 family=formula role=pad
  set macro1 "Tone"
  set macro2 "Top"
  set macro3 "Grit"
  set macro4 "Crush"
  set macro5 "Swell"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #11
  mac2_a1  0.5
  mac3_d1  #5
  mac3_a1  -0.6
  mac4_d1  #6
  mac4_a1  0.3
  mac5_d1  #19
  mac5_a1  0.45
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  b              64
  ampattack      0.01 s
  ampdecay       1 s
  ampsustain     0.9
  amprelease     0.12 s
  volume         1.45
  set formula "min(max((sin(t) * 9 >> 4) + (sin(t * 2) * 9 >> 5) + (sin(t * 3) * b >> 9) + 128, 0), 255)"
  insert Rotary
    speed        #0
    distance     0.35
    mix          0.8

# A sine put through a coarse quantiser written in the language rather
# than taken from the `bits` knob - so the number of steps can be an
# expression, and here it is the `c` macro.
patch Stair note=60 range=45..84 family=formula
  set macro1 "Tone"
  set macro2 "Steps"
  set macro3 "Pluck"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #12
  mac2_a1  0.4
  mac3_d1  #14
  mac3_a1  -0.35
  mac3_d2  #16
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  c              48
  ampattack      0.002 s
  ampdecay       1 s
  ampsustain     0.75
  amprelease     0.1 s
  volume         1.02
  set formula "((sin(t) + 128) / max(c, 4)) * max(c, 4)"

# A square and a sine at the note, mixed in the formula by `b`. The duty
# table narrows the square over the first quarter second, so the chip
# half brightens while the sine half stays put.
patch "Sine Blend" note=60 range=45..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Blend"
  set macro3 "Width"
  set macro4 "Wobble"
  set macro5 "Crunch"
  set macro6 "Short"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #11
  mac2_a1  0.4
  mac3_d1  #1
  mac3_a1  -0.3
  mac4_d1  #2
  mac4_a1  0.4
  mac4_d2  #3
  mac4_a2  0.3
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  formula        1
  formulamode    #1
  timescale      0.293
  b              128
  framerate      25 Hz
  ampattack      0.002 s
  ampdecay       0.8 s
  ampsustain     0.7
  amprelease     0.15 s
  volume         0.99
  set formula "(x * b + (sin(t) + 128) * (255 - b)) >> 8"
  set duty "128 112 96 80 64 48 |"
  send reverb    0.1

# Half a quarter pulse, half a sine that jumps an octave on every table
# step, so the frame clock trills the top while the chip holds the note.
patch "Frame Octave" note=60 range=45..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Rate"
  set macro3 "Thin"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Short"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #13
  mac2_a1  0.3
  mac3_d1  #1
  mac3_a1  -0.15
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.25
  formula        1
  formulamode    #1
  timescale      0.293
  framerate      16 Hz
  ampattack      0.002 s
  ampdecay       0.6 s
  ampsustain     0.65
  amprelease     0.12 s
  volume         1.08
  set formula "(x >> 1) + ((sin(t << (s & 1)) + 128) >> 1)"
  send reverb    0.12

# The arpeggio table moves the note, and `s` moves the formula that is
# ringing it. Neither half is an effect on the other - they are clocked
# together and the sound is what happens in between.
patch "Table Ring" note=60 range=45..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Ring"
  set macro3 "Rate"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Short"
  set macro7 "Glide"
  set macro8 "Drive"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #8
  mac2_a1  -0.5
  mac3_d1  #13
  mac3_a1  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #22
  mac7_a1  0.15
  mac8_d1  #23
  mac8_a1  0.6
  mac8_d2  #24
  mac8_a2  -0.1
  wave           #0
  duty           0.5
  formula        1
  formulamode    #2
  framerate      32 Hz
  ampattack      0.001 s
  ampdecay       1.2 s
  ampsustain     0.7
  amprelease     0.1 s
  volume         1.29
  set formula "((s & 3) * 60 + 90) & 255"
  set arp "0 4 7 12"
  set duty "64 96 128 160"

# All three knobs in one expression: `a` sets the pitch of the shaping,
# `b` how much of the chip survives, `c` where it folds. A formula that
# is played rather than only typed - and all three automate.
patch "Macro Morph" note=60 range=45..84 family=hybrid
  set macro1 "Shape"
  set macro2 "Chip"
  set macro3 "Fold"
  set macro4 "Tone"
  set macro5 "Crunch"
  set macro6 "Plain"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #10
  mac1_a1  0.5
  mac2_d1  #11
  mac2_a1  -0.4
  mac3_d1  #12
  mac3_a1  0.4
  mac4_d1  #14
  mac4_a1  -0.4
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #8
  mac6_a1  -0.6
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.375
  a              64
  b              160
  c              96
  formula        1
  formulamode    #1
  timescale      0.293
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.75
  amprelease     0.1 s
  volume         1.02
  set formula "(x * b >> 8) + (sin(t * (a >> 5) + c) >> 1) & 255"

# The triangle folded harder on every table step, so the note starts
# plain and grows brighter for a second and a half, then holds. `c` is
# how fast it folds.
patch "Fold Clock" note=55 range=40..79 family=hybrid
  set macro1 "Tone"
  set macro2 "Fold"
  set macro3 "Speed"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Short"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #12
  mac2_a1  0.5
  mac3_d1  #13
  mac3_a1  0.4
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #1
  formula        1
  formulamode    #1
  c              32
  framerate      30 Hz
  ampattack      0.002 s
  ampdecay       1.5 s
  ampsustain     0.8
  amprelease     0.15 s
  volume         1.10
  set formula "min(abs((((x - 128) * (16 + (min(s, 48) * c >> 5)) >> 4) + 128 & 511) - 256), 255)"

# A saw arpeggio three steps long, and a formula flipping its top two
# bits in a pattern four steps long. Both run on the same frame clock,
# so the shape and the note only line up again every twelve steps.
patch "Three on Four" note=60 range=45..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Rate"
  set macro3 "Mix"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Short"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #13
  mac2_a1  0.3
  mac3_d1  #8
  mac3_a1  -0.6
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #2
  formula        1
  formulamode    #1
  framerate      20 Hz
  cutoff         7000 Hz
  ampattack      0.002 s
  ampdecay       0.5 s
  ampsustain     0.6
  amprelease     0.1 s
  volume         1.41
  set formula "x ^ ((s & 3) << 6)"
  set arp "0 7 12"
  insert Delay
    time         #3
    feedback     0.3
    tone         4000 Hz
    mode         #1
    mix          0.2

# A square trilling a fifth, ringing a saw that climbs the first five
# harmonics of whichever note the table is on. Two loops of different
# lengths on one clock.
patch "Overtone Ring" note=60 range=45..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Rate"
  set macro3 "Ring"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Short"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #13
  mac2_a1  0.3
  mac3_d1  #8
  mac3_a1  -0.5
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  formula        1
  formulamode    #2
  timescale      0.293
  framerate      24 Hz
  smooth         0.2
  ampattack      0.002 s
  ampdecay       0.7 s
  ampsustain     0.6
  amprelease     0.1 s
  volume         1.29
  set formula "(t * ((s >> 1) % 5 + 1)) & 255"
  set arp "0 7"
  send reverb    0.1

# A square with samples dropped at random, more or fewer on each table
# step, so the note crackles in a rhythm of its own. `a` sets how many
# get through.
patch Dropout note=60 range=45..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Keep"
  set macro3 "Rate"
  set macro4 "Crunch"
  set macro5 "Smooth"
  set macro6 "Short"
  set macro7 "Tail"
  set macro8 "Drive"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #10
  mac2_a1  0.4
  mac3_d1  #13
  mac3_a1  0.4
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.25
  mac5_d1  #7
  mac5_a1  0.5
  mac6_d1  #20
  mac6_a1  -0.3
  mac6_d2  #21
  mac6_a2  -0.2
  mac7_d1  #21
  mac7_a1  0.3
  mac8_d1  #23
  mac8_a1  0.6
  mac8_d2  #24
  mac8_a2  -0.1
  wave           #0
  duty           0.5
  formula        1
  formulamode    #3
  framerate      15 Hz
  ampattack      0.002 s
  ampdecay       0.8 s
  ampsustain     0.5
  amprelease     0.12 s
  cutoff         8000 Hz
  volume         0.93
  set formula "min(max(r + (a >> 1) + (s * 37 & 63) - 32, 0), 255)"
  send reverb    0.12

# A saw exclusive-ORed with a number taken from the frequency, so the
# *waveform* is a different permutation at every note while the pitch
# tracks exactly. Play a scale and it is not one sound getting higher.
# #
# # Reading `f` into the wave's *rate* does not work: `f >> 6` is an
# # integer divide, so it is 1 at C2, 4 at C4 and 16 at C6 - the pitch
# # leaps in octaves instead of tracking, and sits at 16 Hz at the
# # bottom of the range. `f` belongs in the timbre, not in the clock.
patch "Keyed Chaos" note=60 range=36..84 family=hybrid
  set macro1 "Tone"
  set macro2 "Peak"
  set macro3 "Crunch"
  set macro4 "Smooth"
  set macro5 "Short"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #15
  mac2_a1  0.5
  mac3_d1  #5
  mac3_a1  -0.5
  mac3_d2  #6
  mac3_a2  0.25
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #20
  mac5_a1  -0.3
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  ampattack      0.001 s
  ampdecay       1 s
  ampsustain     0.7
  amprelease     0.1 s
  cutoff         10000 Hz
  volume         1.22
  set formula "(t & 255) ^ (f & 255)"

# Formula, then three bits, then the sample clock divided by twelve.
# Three destructive things in a row, which is the whole machine pointed
# at one sound - so the formula itself is a plain saw with a slow bit
# flipped through it, and everything you hear happening to it is the
# crushing rather than the arithmetic.
# #
# # It used to be `t * (t >> 9 | 1)`, which sweeps *forever*: the final
# # mask bounds the value but not the rate of change, and by a fifth of
# # a second that term was stepping sixty-seven units a tick, which is
# # aliasing rather than a pitch.
patch "Crush Formula" note=55 range=40..79 family=hybrid
  set macro1 "Tone"
  set macro2 "Clean"
  set macro3 "Clock"
  set macro4 "Smooth"
  set macro5 "Short"
  set macro6 "Tail"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #5
  mac2_a1  0.4
  mac3_d1  #6
  mac3_a1  -0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #20
  mac5_a1  -0.3
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #4
  formula        1
  formulamode    #1
  timescale      0.293
  bits           #2
  crush          12
  smooth         0.2
  ampattack      0.001 s
  ampdecay       1.1 s
  ampsustain     0.75
  amprelease     0.1 s
  drive          0.3
  volume         1.23
  set formula "(t & 255) ^ (t >> 9 & 48)"
