  ampdecay       0.7 s
  ampsustain     0.4
  amprelease     0.1 s
  volume         0.93

# The triangle channel, which on the hardware had no volume control at
# all - it was on or it was off, and that is why chip bass sounds the
# way it does.
patch "Triangle Bass" note=40 range=28..60 family=bass
  set macro1 "Tone"
  set macro2 "Sub"
  set macro3 "Grit"
  set macro4 "Crush"
  set macro5 "Glide"
  set macro6 "Tail"
  set macro7 "Drive"
