  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #13
  mac2_a1  -0.35
  mac3_d1  #4
  mac3_a1  0.5
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.3
  mac5_d1  #20
  mac5_a1  -0.25
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #22
  mac6_a1  0.15
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  mono           #1
  ampattack      0.001 s
  ampdecay       0.5 s
  ampsustain     0.7
  amprelease     0.06 s
  framerate      30 Hz
  volume         0.85
  set duty "128 112 96 80 64 48 40 32 |"

# A quarter pulse into a ping-pong echo, the spare channel's old job.
patch "Echo Lead" note=64 range=48..88 family=lead
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Wobble"
  set macro4 "Crunch"
  set macro5 "Short"
  set macro6 "Glide"
