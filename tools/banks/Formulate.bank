  mac1_d1  #14
  mac1_a1  -0.4
  mac2_d1  #1
  mac2_a1  -0.3
  mac3_d1  #9
  mac3_a1  0.167
  mac4_d1  #8
  mac4_a1  -0.6
  mac5_d1  #5
  mac5_a1  -0.5
  mac5_d2  #6
  mac5_a2  0.25
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
