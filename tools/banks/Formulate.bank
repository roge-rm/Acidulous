  mac7_a1  0.7
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  -0.5
  wave           #1
  mono           #1
  glide          0 s
  ampattack      0.001 s
  ampdecay       1.5 s
  ampsustain     0.9
  amprelease     0.08 s
  volume         1.30

# A square with the sub under it and the top taken off.
