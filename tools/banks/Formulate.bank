# Formulate - the chip and the equation, voiced against the debug build.
#
# Three layers, and the point is that they interlock rather than stack.
#
#   **The chip.** A hardware-style oscillator: pulse with a duty, triangle,
#   saw, noise with a long or a short shift register. Then the limits that
#   made it sound like hardware - `bits` quantises to as few as two levels,
#   `crush` divides the sample clock, `sub` adds the octave below.
#
#   **The tables.** Three lists clocked together at `framerate`, fifty steps
#   a second by default because that is a video frame. `arp` is semitones,
#   so "0 4 7" plays a chord *on one voice* - which is where chiptune's
#   harmony came from, there being no channels to spare. `duty` and `vol`
#   shape the pulse and the level. A `|` marks the loop point: with the bar
#   at the end the table runs out and stops, which is a one-shot.
#
#   **The formula.** A C-style integer expression, per sample, per voice. It
#   reads `t` `f` `n` `v`, the macros `a` `b` `c`, the table step `s`, a
#   random `rnd()` - and **`x`, which is the chip's own sample**, so an
#   expression can shape the hardware instead of replacing it. `formulamode`
#   chooses: replace, ring, gate, or exclusive-or.
#
# **The one number that governs every formula patch.** `t` advances by
# `freq/55` each sample, so a note's period is always `sr/55` = 873 units of
# `t`, whatever pitch is played. An expression whose cycle is P sits at the
# note when `timescale = P/873`. `sin()` has a cycle of 256, so 0.293 puts it
# on the key, 0.587 an octave up, 1.174 two octaves up - measured, not
# reasoned. Without that a formula plays at an arbitrary pitch that does not
# track the keyboard.
#
# **Two more that bite.** The formula's result is masked to 0..255, so an
# expression that goes negative wraps rather than clipping - `sin(t)` returns
# -127..127 and wants its `+ 128`. And centre is 128, not zero: in ring mode
# a formula that reaches 0 slams the output to -1.0 rather than to silence.
#
# Values are in each parameter's own units; `audition params Formulate` lists
# them. A patch names only what it changes.

machine Formulate
# Families in tab order: lead, bass, drum, pad, arp, shape, formula,
# hybrid, plainest to strangest within each.
#
# Demos: `chip` is sixteenths with wide leaps, because the tables run at
# fifty steps a second and every other phrase here is too legato to show
# them; `pad` for the sustained few.
role    chip

patch Init family=lead

# A square, played one note at a time. The whole vocabulary starts here.
patch "Pulse Lead" note=64 range=48..88 family=lead
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Wobble"
  set macro4 "Crunch"
  set macro5 "Short"
  set macro6 "Glide"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #1
  mac2_a1  -0.35
  mac3_d1  #2
  mac3_a1  0.5
  mac3_d2  #3
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.3
  mac5_d1  #20
  mac5_a1  -0.3
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #22
  mac6_a1  0.15
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.5
  mono           #1
  glide          0 s
  ampattack      0.001 s
  ampdecay       0.4 s
  ampsustain     0.7
  amprelease     0.05 s
  volume         0.77

# A quarter duty: thinner, and it leaves room under itself for a bass.
# Three duty settings is most of what a pulse channel had.
patch "Quarter Pulse" note=64 range=48..88 family=lead
  set macro1 "Tone"
  set macro2 "Thin"
  set macro3 "Wobble"
  set macro4 "Crunch"
  set macro5 "Short"
  set macro6 "Glide"
  set macro7 "Drive"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #14
  mac1_a1  -0.4
  mac1_d2  #15
  mac1_a2  0.2
  mac2_d1  #1
  mac2_a1  -0.13
  mac3_d1  #2
  mac3_a1  0.25
  mac3_d2  #3
  mac3_a2  0.3
  mac4_d1  #5
  mac4_a1  -0.5
  mac4_d2  #6
  mac4_a2  0.3
  mac5_d1  #20
  mac5_a1  -0.25
  mac5_d2  #21
  mac5_a2  -0.2
  mac6_d1  #22
  mac6_a1  0.15
  mac7_d1  #23
  mac7_a1  0.6
  mac7_d2  #24
  mac7_a2  -0.1
  mac8_d1  #26
  mac8_a1  0.5
  wave           #0
  duty           0.25
  mono           #1
  ampattack      0.001 s
  ampdecay       0.35 s
  ampsustain     0.7
  amprelease     0.05 s
  volume         0.89

# An eighth: nasal and small, the one that cuts through everything
# because there is nothing else up there.
patch "Thin Pulse" note=67 range=52..91 family=lead
  set macro1 "Tone"
  set macro2 "Wide"
  set macro3 "Wobble"
  set macro4 "Crunch"
  set macro5 "Short"
  set macro6 "Glide"
  set macro7 "Drive"
