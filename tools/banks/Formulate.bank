  cutoff         6000 Hz
  ampattack      0.001 s
  ampdecay       0.8 s
  ampsustain     0.8
  amprelease     0.06 s
  volume         1.42

# The sample clock divided by six, so the high notes fold back down
# into tones that are not in the key.
