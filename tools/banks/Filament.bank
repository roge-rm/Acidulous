  sustain        0.454
  tone           0.4
  velocity       0.4
  volume         0.17

# 48..82 rather than 84: at a kilohertz a string blown at rather than
# struck is nine parts jet noise to one part note, and 84 measured 0.11 on
# the harmonic series with the right pitch underneath it.

patch Blown family=blown  note=67 range=48..82
  vibrate        4.8 Hz
