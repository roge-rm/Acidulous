patch Prepared family=prepared  note=55 range=36..76
  damper         0.4
  # Halfway rather than a third along. A damper nulls the harmonics that
  # have a node under it, and at a third it takes the fundamental with
  # them: from note 64 up, nine notes of this range had almost no energy
  # on the note's own series at all and what was loudest was the body
  # ringing at its own pitch rather than the string at the played one.
  # At a half it nulls the odd harmonics instead, which is a different
  # colour and a real one, and every note of the range comes back.
  "damper at"    0.5
  drive          0.2
  exciter        #2
  rattle         0.55
  "rattle at"    0.208
  stages         #3
  stiffness      0.3
  sustain        0.727
  tone           0.6
  volume         0.44

