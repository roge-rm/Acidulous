patch "Stopped Wood" family=odd  note=55 range=46..68
  set macro1 "Blow"
  set macro2 "Looser"
  set macro3 "Breathy"
  set macro4 "Swell"
  set macro5 "Vibrato"
  set macro6 "Dark"
  set macro7 "Flutter"
  set macro8 "Soft Tongue"
  mac1_d1  #9
  mac1_a1  0.25
  mac1_d2  #10
  mac1_a2  0.15
  mac2_d1  #8
  mac2_a1  -0.25
  mac2_d2  #7
  mac2_a2  0.15
  mac3_d1  #10
  mac3_a1  0.4
  mac4_d1  #35
  mac4_a1  0.2
  mac4_d2  #36
  mac4_a2  0.1
  mac5_d1  #24
  mac5_a1  0.3
  mac5_d2  #26
  mac5_a2  -0.1
  mac6_d1  #27
  mac6_a1  -0.35
  mac7_d1  #17
  mac7_a1  0.5
  mac8_d1  #15
  mac8_a1  -0.4
  mac8_d2  #20
  mac8_a2  0.15
  answer         0.385
  attack         0.05 s
  body           110 Hz
  breath         0.3
  # Dark from the filter now, not from the lattice. A lattice at 420 Hz on
  # a 110 Hz tube is under four times its bottom note - no real woodwind is
  # under six - and with the deep holes it made no note at all from 58 to
  # 64: measured, +18 and +222 cents at -37 dB, breath and nothing else,
  # which is what Dan heard in the top of the phrase. At 700 Hz with plain
  # holes it plays every note from 46 to 68 within five cents.
  cutoff         4000 Hz
  drive          0.2
  embouchure     0.45
  fine           14 cents
  holes          0.5
  lattice        700 Hz
  pressure       1
  tongue         0.5
  volume         0.459

