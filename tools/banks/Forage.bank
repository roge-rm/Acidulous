  mac3_d2  #12
  mac3_a2  0.033
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  set macro5 "Open"
  mac5_d1  #5
  mac5_a1  0.3
  mac5_d2  #12
  mac5_a2  -0.199
  set macro6 "Reso"
  mac6_d1  #6
  mac6_a1  0.25
  set macro7 "Kick"
