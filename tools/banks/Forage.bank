patch Backwards family=shape
  # Every pad played tail first. A sample reversed is a swell that arrives at
  # its own transient instead of starting on it, and thirteen of them is a
  # kit that plays before the beat rather than on it.
  p*_reverse     #1
  volume         0.96
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.043
  set macro2 "Short"
