patch "Choked Hats" family=kit
  # The one convention every drum machine has and this one could not express
  # until it had choke groups: the closed hat cuts the open one. Pads 7 and 8
  # share group 1, so whichever lands last is the one you hear.
  #
  # The first of the four patches here that address pads by number - see the
  # note at the top about what that assumes.
  p07_choke      #1
  p08_choke      #1
