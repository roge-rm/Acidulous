patch Dusty family=tone
  # Heard through a wall. Low-passed hard with a little resonance to stop it
  # being merely quiet, and a touch of crush so the quiet parts get grainy
  # rather than smooth.
  p*_cutoff      2200 Hz
  p*_reso        0.25
  p*_crush       0.25
  volume         1.05
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.09
  set macro2 "Short"
  mac2_d1  #3
