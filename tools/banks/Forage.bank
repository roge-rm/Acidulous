# Forage - thirty-three patches, voiced against the debug build.
#
# **These are not sounds.** Every other bank here stores a voice; Forage's
# pads hold whatever the player loaded, so a patch can only store *a way of
# treating thirteen samples*. Load a different kit and every patch still means
# the same thing. It is the same argument as Dice's, and it is why there are
# thirty-three rather than a hundred: sweeping one knob across its range would be
# near-copies of somebody else's drum kit.
#
# So each patch does something you can name, and almost all of it is said with
# a star: `p*_cutoff` sets that parameter on all thirteen pads at once.
# Thirteen pads of fourteen parameters is a hundred and eighty-two names, and
# a patch that low-passes the kit should not have to say so thirteen times.
#
# **What the per-pad patches assume.** The kit patches address pads by
# number, and they can only do that because the pad order is the app's own
# convention - Hexbeat's voice order, which is what the drum grid draws and
# what the harness mounts: 0 kick, 1 rim, 2 snare, 3 clap, 4-6 toms, 7 closed
# hat, 8 open hat, 9 crash, 10 ride, 11 cowbell, 12 clave. A kit loaded in
# some other order will still play; those patches, and the Kick, Snare, Toms
# and Hats macros, just stop meaning what their names say.
#
# Stepped parameters are written as `#n`, the step *index*:
#   reverse #0 forwards  #1 backwards
#   mode    #0 low-pass  #1 band-pass
#   choke   #0 none      #1..#4 the four groups
#
# `decay` runs the other way from most: 1.0 means *play the sample through*,
# and below that it is an exponential release from four seconds down to twenty
# milliseconds. So a short pad is a low number, and 1.0 is the off position.
#
# The machine gained two things to make this bank possible. It had no level of
# its own at all, so nothing could be levelled; and thirteen pads summed
# straight into a tanh meant every kit came out flattened to within a decibel
# of itself - Init measured thirteen voices all at -2.7 dB and 1.1 dB apart,
# which read as balance and was the clipper. See kDrive in Forage.cpp.
#
# **Do not read the `click` column here.** It is the ratio of the edge on the
# front of the take to the edge just before the note-off, and on a kit those
# are the first drum's attack and the sixth drum's tail - two different sounds.
# Patches with a long smooth tail read in the hundreds and are perfectly
# clean: `Body` reads 1193 and its largest sample-to-sample jump in the first
# five milliseconds is a hundredth of what `Straight` has. The edge ramps
# below are the real fix and they are already in.
#
# Families: straight 6, shape 7, tone 7, motion 6, kit 7.
#
# Every patch but Init has eight macros. The first four are the same on every
# patch: Lower (six semitones down), Short, Dark and Crush. The last four are
# named for the family. Their destinations by step:
#   #1 all start  #2 all end  #3 all decay  #4 all level  #5 all cutoff
#   #6 all reso  #7 all crush  #8 all pitch env  #9 all env decay  #10 pitch
#   #11 accent  #12 volume  #13 vel  #14-26 tune 1-13  #27-39 level 1-13
#   #40-52 decay 1-13  #53-65 cutoff 1-13
# Volume routes, and all-pads level where volume runs out, keep each macro
# within about half a decibel of the patch on `loud`.
#
# `--material dirtykit` is the same kit with room ahead of the kick, DC under
# the snare, the clap 12 dB down and a stereo crash, for checking a patch on
# samples nobody trimmed.

machine Forage
role    beat

patch Init family=straight

patch Straight family=straight
  # The kit as loaded, with the top corner taken off and a little more accent
  # than the default. This is the one to hear your samples on, and the one
  # every other patch here is a departure from.
  p*_cutoff      16000 Hz
  accent         0.7
  volume         0.90
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.034
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.018
  mac2_d3  #12
  mac2_a3  0.367
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.257
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.036
  set macro5 "Kick"
  mac5_d1  #27
  mac5_a1  0.1
  mac5_d2  #14
  mac5_a2  -0.04
  set macro6 "Snare"
  mac6_d1  #29
  mac6_a1  0.1
  mac6_d2  #30
  mac6_a2  0.1
  set macro7 "Hats"
  mac7_d1  #34
  mac7_a1  0.08
  mac7_d2  #35
  mac7_a2  0.08
  set macro8 "Even"
  mac8_d1  #13
  mac8_a1  -1
  mac8_d2  #12
  mac8_a2  -0.226

patch "Same Hits" family=straight
  # Velocity and accent off, so every hit plays at full level, like a sampler
  # with no velocity at all.
  p*_cutoff      16000 Hz
  velocity       0.0
  accent         0.0
  volume         0.9
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.027
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.021
  mac2_d3  #12
  mac2_a3  0.367
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.257
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.036
  set macro5 "Kick"
  mac5_d1  #27
  mac5_a1  0.1
  mac5_d2  #14
  mac5_a2  -0.04
  set macro6 "Snare"
  mac6_d1  #29
  mac6_a1  0.1
  mac6_d2  #30
  mac6_a2  0.1
  set macro7 "Hats"
  mac7_d1  #34
  mac7_a1  0.08
  mac7_d2  #35
  mac7_a2  0.08
  set macro8 "Even"
  mac8_d1  #13
  mac8_a1  -1

patch Softened family=straight
  # The top taken down to 7 kHz with a little resonance and the tails a bit
  # shorter. The kit as loaded, rounded off.
  p*_cutoff      7000 Hz
  p*_reso        0.15
  p*_decay       0.9
  volume         1.0
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.072
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.034
  mac2_d3  #12
  mac2_a3  0.3
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.099
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  -0.023
  set macro5 "Kick"
  mac5_d1  #27
  mac5_a1  0.1
  mac5_d2  #14
  mac5_a2  -0.04
  set macro6 "Snare"
  mac6_d1  #29
  mac6_a1  0.1
  mac6_d2  #30
  mac6_a2  0.1
  set macro7 "Hats"
  mac7_d1  #34
  mac7_a1  0.08
  mac7_d2  #35
  mac7_a2  0.08
  set macro8 "Even"
  mac8_d1  #13
  mac8_a1  -1
  mac8_d2  #12
  mac8_a2  -0.251

patch Soft family=straight
  # A kit that answers quietly. Accent almost off, so a hard hit and a gentle
  # one land close together, and the level down to match - the patch to play
  # under something rather than over it.
  p*_cutoff      9000 Hz
  accent         0.1
  volume         0.86
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.05
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #12
  mac2_a2  0.389
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.148
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  set macro5 "Kick"
  mac5_d1  #27
  mac5_a1  0.1
  mac5_d2  #14
  mac5_a2  -0.04
  set macro6 "Snare"
  mac6_d1  #29
  mac6_a1  0.1
  mac6_d2  #30
  mac6_a2  0.1
  set macro7 "Hats"
  mac7_d1  #34
  mac7_a1  0.08
  mac7_d2  #35
  mac7_a2  0.08
  set macro8 "Even"
  mac8_d1  #13
  mac8_a1  -1
  mac8_d2  #12
  mac8_a2  -0.216

patch Hard family=straight
  # The other way: accent at full, so the loud hits are a long way above the
  # quiet ones and several at once bend the output stage. A sample box that
  # clips when the whole kit lands on one beat is the sound.
  accent         1.0
  volume         1.34
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.03
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.129
  mac2_d3  #12
  mac2_a3  0.073
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #4
  mac3_a2  0.07
  mac3_d3  #12
  mac3_a3  0.073
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.064
  set macro5 "Kick"
  mac5_d1  #27
  mac5_a1  0.1
  mac5_d2  #14
  mac5_a2  -0.04
  set macro6 "Snare"
  mac6_d1  #29
  mac6_a1  0.1
  mac6_d2  #30
  mac6_a2  0.1
  set macro7 "Hats"
  mac7_d1  #34
  mac7_a1  0.08
  mac7_d2  #35
  mac7_a2  0.08
  set macro8 "Even"
  mac8_d1  #13
  mac8_a1  -1
  mac8_d2  #12
  mac8_a2  -0.336

patch Tight family=shape
  # Everything short. A decay of 0.35 is about a tenth of a second, so each
  # pad is its attack and very little else - the difference between a kit you
  # can play sixteenths on and one that smears.
  p*_decay       0.35
  volume         0.90
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #12
  mac2_a2  0.34
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.05
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.043
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  mac6_d3  #12
  mac6_a3  0.05
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
  mac8_a2  0.1
  mac8_d3  #12
  mac8_a3  -0.046

patch Gated family=shape
  # Shorter still, and hard. This is the gate on a room mic: the front of
  # every sample and then nothing, which turns any kit into a tight one
  # whether or not it was recorded that way.
  p*_decay       0.2
  accent         0.85
  volume         1.02
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #12
  mac2_a2  0.157
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  mac7_d3  #12
  mac7_a3  -0.045
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
  mac8_a2  0.1
  mac8_d3  #12
  mac8_a3  -0.108

patch "One Voice" family=shape
  # Every pad in choke group 1, so each hit cuts off the one before and only
  # one sound plays at a time.
  p*_choke       #1
  volume         0.92
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.023
  mac2_d3  #12
  mac2_a3  0.353
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.273
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.044
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  mac6_d3  #12
  mac6_a3  0.036
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
  mac8_a2  0.1

patch Clipped family=shape
  # The front third of each sample and no more, cut by the end point rather
  # than by an envelope - so it stops dead instead of fading. On a long
  # sample this is the transient alone; on a short one it changes nothing,
  # which is the honest behaviour.
  p*_end         0.33
  volume         0.94
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.031
  mac2_d3  #12
  mac2_a3  0.34
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.34
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.045
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  mac5_d2  #12
  mac5_a2  0.34
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  mac6_d3  #12
  mac6_a3  0.037
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
  mac8_a2  0.1

patch Body family=shape
  # The opposite: the first tenth skipped, so what is left is the body without
  # the stick. Under a kit that already has attacks in it, this is the layer
  # that adds weight and nothing else.
  p*_start       0.1
  p*_decay       0.8
  volume         1.13
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.026
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.165
  mac2_d3  #12
  mac2_a3  0.213
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #4
  mac3_a2  0.025
  mac3_d3  #12
  mac3_a3  0.213
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.045
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  mac6_d3  #12
  mac6_a3  0.026
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
