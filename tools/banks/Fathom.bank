  model          #6
  density        0.3
  gust           0.2
  tone           0.2
  volume         1

patch Hearth family=fire note=36 range=24..48
  # A steady fire indoors.
  model          #6
  density        0.5
  gust           0.4
  tone           0.5
  volume         1

patch "Sizzle" family=fire note=60 range=48..72
  # Steam and fat in a hot pan.
  model          #10

patch "Steam" family=fire note=64 range=52..76
  # A kettle's hiss and a few spits.
  model          #10
  density        0.3
  tone           0.8

patch "Frying" family=fire note=60 range=48..72
  # A pan full, loud and busy.
  model          #10
  density        0.8

patch "Ice" family=winter note=48 range=36..60
  # A frozen pond cracking, its sheet ringing.
  model          #11

patch "Ice Groans" family=winter note=40 range=31..52
  # Slow cracks, long glassy rings.
  model          #11
  decay          0.8
  density        0.3

patch "Ice Shards" family=winter note=60 range=48..72
  # Small, quick cracks.
  model          #11
  density        0.7
  decay          0.3

patch "Snow Steps" family=winter note=48 range=36..60
  # Footsteps in fresh snow.
  model          #12

patch "Snow Run" family=winter note=48 range=36..60
  # Running through it, quick and crunchy.
  model          #12
  density        0.8

patch "Packed Snow" family=winter note=52 range=40..64
