# Fathom - water and weather.
#
# Most of the sound of water is bubbles: air caught under the surface rings
# at a pitch set by its size and rises as it nears the top. A drip is a
# bubble and a tap; rain is many drips and what they land on; a stream is a
# cloud of small bubbles and a few big ones; surf is a wave's rush. Wind is
# air rushing past, in gusts, whistling where it's caught; fire is
# crackles, hiss and roar.
#
# A held note keeps it going: the note sets the bubbles' size or the
# wind's whistle, the velocity how much. `density` is how many events,
# `size` how far their pitches spread, `rise` how far a bubble climbs,
# `decay` how long each rings, `surface` what the rain falls on, `gust` how
# much the wind, fire and waves come and go, `whistle` the wind caught in a
# gap, `tone` how bright, `swell` beats from wave to wave, `fade` how long
# it takes to come and go. Pressure and the mod wheel thicken it.
#
# Families: water, rain, weather, fire, winter, kit.

machine Fathom
role pad

patch Init family=water note=48 range=36..60

patch "Fish Tank" family=water note=55 range=43..67
  # A steady line of small bubbles.
  density        0.55
  size           3 st
  rise           0.5

patch "Big Bubbles" family=water note=36 range=24..48
  # Slow, deep bubbles, long and round.
  density        0.35
  size           7 st
  decay          0.8
  rise           0.3

patch "Boiling Pot" family=water note=48 range=36..60
  # Thick and fast.
  density        0.85
  size           9 st
  rise           0.6
  volume         0.6

patch "Bubble Notes" family=water note=48 range=24..72 role=tune
  # One bubble a note, tuned: play a melody.
  density        0
  size           0 st
  rise           0.2
  decay          0.7
  volume         1

patch "Cave Drips" family=water note=43 range=31..55
  # Slow drips into a pool.
  model          #1
  density        0.45
  size           4 st
  decay          0.7

patch "Tap Drip" family=water note=48 range=36..60
  # A leaking tap, steady.
  model          #1
  density        0.55
  size           1 st

patch "Drip Notes" family=water note=43 range=24..60 role=tune
  # One drip a note, tuned.
  model          #1
  density        0
  size           0 st
  volume         1

patch "Gutter" family=water note=40 range=28..52
  # Faster, uneven drips.
  model          #1
  density        0.75
  size           8 st

patch Brook family=water note=48 range=36..60
  # A small stream over stones.
  model          #3
  density        0.4
  size           8 st

patch River family=water note=36 range=24..48
  # Deeper and wider, more of the big bubbles.
  model          #3
  density        0.6
  size           12 st
  volume         0.4

patch Fountain family=water note=55 range=43..67
  # Fine, bright and busy.
  model          #3
  density        0.75
  size           5 st
  volume         0.4

patch Trickle family=water note=52 range=40..64
  # Just a little water.
  model          #3
  density        0.2
  size           6 st

patch Surf family=water note=48 range=36..60
  # Waves every four beats.
  model          #4
  swell          4 beats
  gust           0.8

patch "Slow Swell" family=water note=48 range=36..60
  # Long waves, eight beats apart, dark.
  model          #4
  swell          8 beats
  gust           0.9
  tone           0.3

patch Shore family=water note=52 range=36..60
  # Small waves, bright foam.
  model          #4
  swell          2 beats
  gust           0.6
  tone           0.7
  density        0.7

patch "Calm Sea" family=water note=48 range=36..60
  # Barely moving.
  model          #4
  swell          16 beats
  gust           0.3
  tone           0.25

patch "Waterfall" family=water note=40 range=31..55
  # The roar of falling water and its countless bubbles.
  model          #9

patch "Waterfall Far" family=water note=36 range=28..48
  # Heard from down the valley, dark and steady.
  model          #9
  tone           0.2
  density        0.4

patch "Cascade" family=water note=48 range=36..60
  # A small fall, close by and bright.
  model          #9
  tone           0.7
  density        0.8
  volume         0.4

patch "Splash" family=water note=48 range=36..60
  # A hand in the water and a burst of bubbles.
  model          #13

patch "Paddling" family=water note=48 range=36..60
  # Splashes in a steady rhythm, like paddling.
  model          #13
  density        0.6

patch "Big Splash" family=water note=40 range=31..52
  # Something heavy thrown in.
  model          #13
  size           12 st

patch "Underwater" family=water note=36 range=24..48
  # Below the surface: a dark wash and big, slow bubbles.
  model          #14

patch "Deep Underwater" family=water note=31 range=24..43
  # Deeper still, almost nothing but the wash.
  model          #14
  tone           0.2
  density        0.3

patch "Diver" family=water note=40 range=28..52
  # A diver's breath rising past.
  model          #14
  density        0.7
  rise           0.8
  volume         0.5

patch "Light Rain" family=rain note=48 range=36..60
  # A shower on water.
  model          #2
  density        0.35
  tone           0.4
  volume         1

patch Downpour family=rain note=48 range=36..60
  # Heavy rain, the hiss up.
  model          #2
  density        0.85
  tone           0.6
  volume         0.6

patch "Rain on Leaves" family=rain note=48 range=36..60
  # Drops on leaves: soft taps.
  model          #2
  density        0.6
  surface        #1

patch "Tin Roof" family=rain note=48 range=36..60
  # Rain on a metal roof, ringing.
  model          #2
  density        0.55
  surface        #2

patch "Window" family=rain note=48 range=36..60
  # Rain against glass, close.
  model          #2
  density        0.5
  surface        #3
  tone           0.3
  volume         1

patch "Hail" family=rain note=48 range=36..60
  # Ice on a hard roof, bouncing.
  model          #8

patch "Hail on Tin" family=rain note=52 range=40..64
  # Heavy hail on a tin roof, bright.
  model          #8
  density        0.7
  tone           0.8

patch "Light Hail" family=rain note=48 range=36..60
  # A few hailstones, scattered.
  model          #8
  density        0.3

patch "Rainstick" family=rain note=48 range=36..60
  # Pebbles falling past the pins, thinning out.
  model          #15

patch "Long Rainstick" family=rain note=48 range=36..60
  # A long stick, the fall slowing over seconds.
  model          #15
  decay          0.9

patch "Short Rainstick" family=rain note=52 range=40..64
  # A short stick turned quickly.
  model          #15
  decay          0.2
  density        0.8

patch Breeze family=weather note=36 range=24..48
  # A soft wind coming and going.
  model          #5
  gust           0.6
  tone           0.4

patch Gale family=weather note=43 range=31..55
  # Strong, gusty, bright.
  model          #5
  gust           1
  tone           0.8
  volume         0.85

patch "Whistling Wind" family=weather note=48 range=31..60 role=tune
  # Wind through a gap, whistling the note.
  model          #5
  whistle        0.8
  gust           0.7
  volume         0.4

patch "Moaning Wind" family=weather note=31 range=19..43 role=tune
  # Low, hollow, whistling.
  model          #5
  whistle        0.6
  gust           0.8
  tone           0.25
  volume         1

patch "Thunder" family=weather note=36 range=24..48
  # A crack, then the rumble rolling away.
  model          #7

patch "Distant Thunder" family=weather note=31 range=24..43
  # Far off: no crack to speak of, a low roll coming and going.
  model          #7
  tone           0.2
  fade           1.5 s

patch "Thunder Clap" family=weather note=40 range=28..52
  # Close: a loud crack and a short rumble.
  model          #7
  tone           0.8
  decay          0.3

patch Campfire family=fire note=36 range=24..48
