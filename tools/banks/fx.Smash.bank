# Smash - three bands, each squashed from above and lifted from below.
#
# In each of low, mid and high, whatever is over `threshold` is pushed down
# by `down` and whatever is under it is pulled up by `up`, so every band
# crowds the threshold. `depth` mixes that with the track as it was: a
# little adds density, all of it brings every tail, breath and room up to
# the level of the hits. `time` scales every band's attack and
# release: slow is smooth, fast pumps and grinds. `low`, `mid` and `high`
# set the balance after it, and `in` drives it harder.
#
# Sounds far under the threshold (hiss, hum) are left down.
#
# The beat: each band ducks on a rhythm of its own from the song (`lowduck`,
# `midduck`, `highduck`: #2 beats, #3 offbeats, #4 8ths, #5 16ths, #6 2 and 4,
# #7 halves, #8 3-3-2, #9 dotted) or, at #1 sidechain, under the track picked in
# `sidechain`. `lowdepth` and the others are how far, `recover` how long it
# takes to come back. The sidechain patches leave it on the track's own
# input: point it at the kick.
#
# Families: glue, loud, wide, wreck, beat, sidechain.

machine fx.Smash

patch Init family=loud

patch Touch family=glue
  # A little of it, for a mix bus: denser without sounding processed.
  depth          0.25
  time           1.5
  threshold      -20 dB
  gain           0 dB

patch Bus family=glue
  # Drums or synths as one: the tails come up between the hits.
  depth          0.45
  threshold      -22 dB
  down           0.7
  up             0.6
  gain           0.5 dB

patch Vocal family=glue
  # Every word and breath at one level, the mids a touch forward.
  depth          0.6
  time           0.8
  threshold      -26 dB
  mid            1.5 dB
  high           -1 dB
  gain           2 dB

patch Loud family=loud
  # All of it, fast: basses and leads that jump out of a phone speaker.
  depth          1
  time           0.6
  threshold      -24 dB
  gain           2.5 dB

patch Bright family=loud
  # The top band pushed: hats and air come right up front.
  depth          0.8
  threshold      -24 dB
  high           4 dB
  low            -2 dB
  gain           1 dB

patch Fat family=loud
  # The lows held up, for a bass that stays big at every note.
  depth          0.8
  threshold      -22 dB
  low            4 dB
  high           -2 dB
  gain           -2 dB

patch Squeeze family=loud
  # Fast and deep: the whole track pumping.
  depth          1
  time           0.3
  threshold      -30 dB
  down           1
  up             0.6
  gain           8 dB

patch Air family=wide
  # Only the lift, no squash: reverb tails and room come up, hits untouched.
  depth          0.7
  down           0
  up             1
  threshold      -18 dB
  time           2
  gain           0 dB

patch Pads family=wide
  # Slow and deep on a pad: it breathes instead of fading.
  depth          0.9
  time           4
  threshold      -28 dB
  gain           4 dB

patch Grind family=wreck
  # Driven and fast, squashing the waveform itself: a bass that snarls.
  depth          1
  time           0.15
  in             4 dB
  threshold      -30 dB
  gain           7 dB

patch Pump family=wreck
  # Slow release, hard threshold: the whole track breathes with every kick.
  depth          1
  time           6
  threshold      -30 dB
  down           1
  up             0.4
  gain           5.5 dB

patch "Pump Lows" family=beat
  # The lows go down on every beat and swell back, the mids a little with them.
  depth          0.5
  threshold      -24 dB
  lowduck        #2
  lowdepth       10 dB
  midduck        #2
  middepth       3 dB
  recover        180 ms
  gain           3.5 dB

patch Seesaw family=beat
  # The lows duck on the beat and the highs on the offbeat, so the two trade places.
  depth          0.5
  threshold      -24 dB
  lowduck        #2
  lowdepth       9 dB
  highduck       #3
  highdepth      9 dB
  recover        150 ms
  gain           2.5 dB

patch "Half Time" family=beat
  # A slow sway: the lows down on 1 and 3, the mids on 2 and 4.
  depth          0.5
  threshold      -24 dB
  lowduck        #7
  lowdepth       10 dB
  midduck        #6
  middepth       6 dB
  recover        350 ms
  gain           3.5 dB

patch Tresillo family=beat
  # The lows on 3-3-2, the top flickering on every sixteenth.
  depth          0.5
  threshold      -24 dB
  lowduck        #8
  lowdepth       9 dB
  highduck       #5
  highdepth      4 dB
  recover        90 ms
  gain           2 dB

patch Chop family=beat
  # Every band down hard on every sixteenth and back fast: a pad cut into a rhythm.
  depth          0.6
  threshold      -26 dB
  lowduck        #5
  lowdepth       15 dB
  midduck        #5
  middepth       15 dB
  highduck       #5
  highdepth      15 dB
  recover        45 ms
  gain           6.5 dB

patch "Kick Room" family=sidechain
  # The lows get out of the kick's way and the mids a little: a bass under a kick.
  depth          0.4
  threshold      -24 dB
  lowduck        #1
  lowdepth       12 dB
  midduck        #1
  middepth       3 dB
  recover        160 ms
  gain           3 dB

patch "Under It" family=sidechain
  # The whole track ducks under another, the lows most: a pad that breathes with the drums.
  depth          0.7
  threshold      -26 dB
  lowduck        #1
  lowdepth       14 dB
  midduck        #1
  middepth       8 dB
  highduck       #1
  highdepth      5 dB
  recover        250 ms
  gain           7 dB

patch "Keyed Seesaw" family=sidechain
  # The lows under the kick's track, the highs on the offbeats from the song.
  depth          0.5
  threshold      -24 dB
  lowduck        #1
  lowdepth       11 dB
  highduck       #3
  highdepth      8 dB
  recover        140 ms
  gain           2.5 dB
