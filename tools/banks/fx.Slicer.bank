# Slicer - the track cut on the tempo, some slices replaced as they play.
#
# Every `rate` (a quarter, eighth, sixteenth or thirty-second) is a slice.
# By `chance`, a slice repeats the one before it, plays it backwards, or
# drops out, in the proportions `repeat`, `reverse` and `drop` set. `gate`
# shortens every slice, `pitch` shifts the repeats, and `seed` chooses which
# slices change, the same ones every time the song plays, so a part can be
# written around them.
#
# Families: stutter, glitch, gate.

machine fx.Slicer

patch Init family=stutter

patch Stutter family=stutter
  # Sixteenths that now and then repeat: a drum loop that stammers.
  rate           #2
  chance         0.25
  repeat         1
  reverse        0
  drop           0

patch Rolls family=stutter
  # Thirty-seconds repeated more often: rolls and fills out of a loop.
  rate           #3
  chance         0.35
  repeat         1
  reverse        0
  drop           0.1

patch Climb family=stutter
  # Repeats pitched up a fifth: each one climbs.
  rate           #2
  chance         0.3
  repeat         1
  reverse        0
  drop           0
  pitch          7 st

patch "Light Stutter" family=stutter
  # Now and then a slice repeats.
  chance         0.15
  repeat         0.8
  reverse        0
  drop           0

patch "Machine Gun" family=stutter
  # Fast repeats, often.
  rate           #3
  chance         0.6
  repeat         1
  drop           0

patch Glitch family=glitch
  # A bit of everything, often: the loop torn up and rebuilt.
  rate           #2
  chance         0.5
  repeat         0.5
  reverse        0.4
  drop           0.3
  seed           #5

patch Backwards family=glitch
  # Eighths played backwards now and then: swells where the hits were.
  rate           #1
  chance         0.35
  repeat         0
  reverse        1
  drop           0

patch Tape family=glitch
  # Repeats pitched down an octave: a tape jamming.
  rate           #2
  chance         0.3
  repeat         1
  reverse        0.3
  drop           0
  pitch          -12 st

patch "Reverse Only" family=glitch
  # Slices flipped, never repeated.
  chance         0.4
  repeat         0
  reverse        1
  drop           0

patch "Pitch Glitch" family=glitch
  # Repeats pitched down.
  chance         0.4
  repeat         0.8
  pitch          -7

patch "Up Glitch" family=glitch
  # Repeats an octave up.
  chance         0.3
  repeat         0.8
  pitch          12

patch "Broken Beat" family=glitch
  # Everything at once, a different seed.
  chance         0.6
  repeat         0.5
  reverse        0.5
  drop           0.3
  seed           #7

patch Chop family=gate
  # Nothing replaced, every sixteenth cut to half: a chopped pad.
  rate           #2
  chance         0
  gate           0.5

patch Holes family=gate
  # Eighths dropping out at random: gaps that let the rest breathe.
  rate           #1
  chance         0.3
  repeat         0
  reverse        0
  drop           1
  seed           #9
  gain           2 dB

patch Trance family=gate
  # Short sixteenth gates with a few repeats: a pulsing pad.
  rate           #2
  chance         0.15
  repeat         1
  reverse        0
  drop           0
  gate           0.35
  gain           1.5 dB

patch "Trance Gate Eighths" family=gate
  # Gated on the eighths, short.
  rate           #1
  chance         0
  gate           0.4

patch "Soft Gate" family=gate
  # Gated gently, the slices long.
  chance         0
  gate           0.75

patch Sparse family=gate
  # Many slices dropped: holes in the part.
  chance         0.6
  repeat         0
  reverse        0
  drop           1
  gain           4 dB

patch "Chance Gate" family=gate
  # Gated, some slices skipped.
  chance         0.4
  drop           0.6
  gate           0.5
  repeat         0
  gain           2.5 dB
