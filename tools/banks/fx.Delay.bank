# Delay - the classic in four modes, and the two extras it has that a delay
# usually does not.
#
# `time` is a note value, so it is written as a step index: #0 1/32, #1 1/16,
# #2 1/8, #3 1/8., #4 1/4, #5 1/4., #6 1/2, #7 1 bar.
#
# `mode` is #0 normal, #1 ping-pong, #2 multi-tap, #3 reverse. Multi-tap puts
# `taps` (2 to 4) inside the time, panned outside in, bunched early or late
# by `spacing`; only the last feeds back. Reverse plays each stretch of
# `time` backwards, and feedback turns an echo forwards again.
#
# Values are in each parameter's own units; `audition params fx.Delay` lists
# them. A patch names only what it changes.

effect Delay

patch Init family=short

patch Slapback family=short
  time           #0
  feedback       0.12
  tone           4500 Hz
  mode           #0
  mix            0.28

patch Doubler family=short
  # A thirty-second note: thickens without sounding like an echo.
  time           #0
  feedback       0
  mix            0.3
  mode           #0

patch Rockabilly family=short
  # A quick, bright slap with one repeat.
  time           #1
  feedback       0.2
  tone           7000 Hz
  mode           #0
  mix            0.35

patch "Eighth Sync" family=synced
  time           #2
  feedback       0.38
  tone           7000 Hz
  mode           #0
  mix            0.32

patch "Ping Pong" family=synced
  time           #3
  feedback       0.5
  tone           8000 Hz
  mode           #1
  mix            0.38

patch "Dotted Eighth" family=synced
  # The dotted eighth that makes a guitar line cascade.
  time           #3
  feedback       0.4
  mix            0.3

patch Quarter family=synced
  # On the beat, a few repeats.
  time           #4
  feedback       0.35
  mix            0.3

patch "Half Bar" family=synced
  # Long and spaced, two beats.
  time           #6
  feedback       0.45
  tone           4000 Hz
  mix            0.3

patch Dub family=dub
  # Long, dark and nearly self-sustaining: the feedback is most of the sound
  # and the tone control is what stops it turning into noise.
  time           #5
  feedback       0.82
  tone           2200 Hz
  mode           #1
  mix            0.45

patch Ducked family=dub
  # The extra: echoes sit under the dry signal and swell in the gaps, so a
  # long delay can sit behind a busy part without smearing it.
  time           #4
  feedback       0.55
  tone           5200 Hz
  mode           #1
  mix            0.5
  duck           0.8

patch "Long Dub" family=dub
  # A bar long, feeding back and darkening.
  time           #7
  feedback       0.7
  tone           2000 Hz
  mix            0.4

patch "Wobbly Dub" family=dub
  # Dotted quarters, high feedback, the repeats wobbling.
  time           #5
  feedback       0.75
  tone           2500 Hz
  wobble         0.4
  mix            0.4

patch Tape family=tape
  # The other extra: two sines on the read head. Slow and shallow is a tape
  # machine; further up it is a machine that needs servicing.
  time           #4
  feedback       0.55
  tone           3200 Hz
  mode           #0
  mix            0.36
  wobble         0.35
  gain           -2.5 dB

patch Seasick family=tape
  time           #6
  feedback       0.7
  tone           2800 Hz
  mode           #1
  mix            0.5
  wobble         0.85
  duck           0.3

patch "Melting Tape" family=tape
  # Eighths on a worn tape: they bend as they fade.
  time           #2
  feedback       0.5
  tone           3000 Hz
  wobble         0.8
  mix            0.35

patch "Vocal Echo" family=ambient
  # Ducked under the singer, rising in the gaps.
  time           #4
  feedback       0.35
  duck           0.8
  mix            0.35

patch Wash family=ambient
  # Long and dark under everything, a bed of echoes.
  time           #6
  feedback       0.8
  tone           1500 Hz
  mode           #1
  mix            0.35
  gain           -1 dB

patch "Dark Ping Pong" family=ambient
  # Left and right, the repeats softening.
  time           #2
  feedback       0.5
  tone           2500 Hz
  mode           #1
  mix            0.3

patch "Ghost Notes" family=ambient
  # Quiet sixteenths, a shadow behind the part.
  time           #1
  feedback       0.3
  mix            0.15
  mode           #1

patch "Three Taps" family=taps
  # Three even taps in a quarter: a triplet that answers itself across the
  # field.
  time           #4
  mode           #2
  taps           3
  feedback       0.2
  mix            0.32
  gain           -0.5 dB
patch "Rolling Taps" family=taps
  # Four even taps over a half note, so every eighth comes back.
  time           #6
  mode           #2
  taps           4
  feedback       0.3
  tone           5000 Hz
  mix            0.3
  gain           -1.2 dB
patch "Late Bunch" family=taps
  # Four taps crowding the end of the quarter: a flam before the beat.
  time           #4
  mode           #2
  taps           4
  spacing        0.8
  feedback       0.25
  mix            0.3
  gain           -0.7 dB
patch Scatter family=taps
  # Four taps thrown early in a dotted quarter, then a dark tail.
  time           #5
  mode           #2
  taps           4
  spacing        -0.7
  feedback       0.45
  tone           3000 Hz
  mix            0.32

patch Backwards family=reverse
  # Each quarter played back end first, once.
  time           #4
  mode           #3
  feedback       0.2
  mix            0.45

patch "Reverse Half" family=reverse
  # Half a bar at a time, backwards, swelling into the next one.
  time           #6
  mode           #3
  feedback       0.35
  tone           4000 Hz
  mix            0.42

patch "Swell Back" family=reverse
  # Ducked, so the backwards half notes rise in the gaps.
  time           #6
  mode           #3
  feedback       0.5
  tone           5000 Hz
  duck           0.6
  mix            0.5

patch "Reverse Tape" family=reverse
  # Backwards quarters on a worn tape.
  time           #4
  mode           #3
  feedback       0.45
  tone           3000 Hz
  wobble         0.4
  mix            0.4
