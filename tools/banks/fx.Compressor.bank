# Compressor - the classic four, and a pump that needs no sidechain.
#
# Threshold, ratio, attack and release do what they always do. `pump` is the
# extra: the gain is ducked in time with the transport at `pumprate`, so a pad
# breathes against the beat without anything having to be routed into a
# sidechain input. It is the effect everybody wants and nobody's insert can do
# on its own.
#
# Families: glue, squash, pump.

machine fx.Compressor

patch Init family=glue

patch Glue family=glue
  # The mix-bus setting: a low ratio, a threshold most of the material sits
  # under, and a release slow enough that it never chatters. It should be hard
  # to tell whether it is on, and obvious when it is off.
  threshold      -14 dB
  ratio          2
  attack         20 ms
  release        250 ms
  makeup         3 dB
  gain           -3 dB

patch Bus family=glue
  # Firmer, for a drum bus: fast enough to catch a snare, slow enough to let
  # the transient through first, which is what makes a kit sound bigger rather
  # than flatter.
  threshold      -20 dB
  ratio          4
  attack         5 ms
  release        120 ms
  makeup         6 dB
  gain           -3 dB

patch Gentle family=glue
  # The lightest useful setting. Two decibels of movement at most, which is
  # about what a hand on a fader would do.
  threshold      -10 dB
  ratio          1.8
  attack         30 ms
  release        400 ms
  makeup         2 dB
  gain           -2 dB

patch "Drum Bus" family=glue
  # Slow attack so the hits come through, then held together.
  threshold      -18 dB
  ratio          4
  attack         30 ms
  release        100 ms
  makeup         4 dB
  gain           -4 dB

patch "Mix Glue" family=glue
  # Barely moving, the parts sitting together.
  threshold      -12 dB
  ratio          1.5
  attack         30 ms
  release        300 ms
  makeup         1.5 dB
  gain           -1.5 dB

patch Vocal family=glue
  # Even and present, for a singer.
  threshold      -20 dB
  ratio          3
  attack         5 ms
  release        120 ms
  makeup         5 dB
  gain           -2 dB

patch "Bass Even" family=glue
  # Every note the same weight.
  threshold      -22 dB
  ratio          5
  attack         10 ms
  release        150 ms
  makeup         3 dB

patch "Limiter Soft" family=glue
  # Catches the peaks and nothing else.
  threshold      -6 dB
  ratio          10
  attack         1 ms
  release        80 ms
  gain           0 dB

patch Limit family=squash
  # A brick wall in all but name: the highest ratio and the fastest attack, set
  # near the top so only the peaks ever see it.
  threshold      -6 dB
  ratio          20
  attack         0.5 ms
  release        60 ms
  makeup         4 dB
  gain           -4 dB

patch Squash family=squash
  # The opposite of transparent. Everything is pinned to the same level and the
  # release is fast enough to hear it breathing - the sound of a compressor
  # rather than the sound of compression.
  threshold      -34 dB
  ratio          14
  # Three milliseconds, not one: at one the first transient is through before
  # the gain has moved, and fourteen decibels of make-up under it turns that
  # into a click rather than a punch.
  attack         3 ms
  release        40 ms
  makeup         12 dB
  gain           2.5 dB

patch Slam family=squash
  # Fast and hard: everything flattened.
  threshold      -35 dB
  ratio          20
  attack         0.5 ms
  release        60 ms
  makeup         14 dB
  gain           4 dB

patch "Room Crush" family=squash
  # The room sound pulled up between the hits.
  threshold      -40 dB
  ratio          12
  attack         1 ms
  release        200 ms
  makeup         16 dB
  gain           8 dB

patch Snap family=squash
  # A fast release so the attack snaps back.
  threshold      -25 dB
  ratio          8
  attack         3 ms
  release        30 ms
  makeup         5 dB

patch Pump family=pump
  # Ducked in time with the transport, on the quarter note. No sidechain, no
  # routing, no kick to trigger it: the compressor already knows where the beat
  # is, so it uses it.
  threshold      -18 dB
  ratio          6
  attack         3 ms
  release        160 ms
  makeup         6 dB
  pump           0.7
  pumprate       #2
  gain           -1 dB

patch "Four Floor" family=pump
  # Deeper and faster, the way a house record ducks - the pad disappears under
  # each beat and swells back before the next. `pumprate` is the note value, so
  # it stays with the song rather than with a number of milliseconds.
  threshold      -22 dB
  ratio          8
  attack         1 ms
  release        90 ms
  makeup         8 dB
  pump           1.0
  pumprate       #2
  gain           0.5 dB

patch "Half Time Pump" family=pump
  # Pumping on the half notes.
  pump           0.8
  pumprate       #1
  gain           4.5 dB

patch "Eighths Pump" family=pump
  # Pumping on every eighth, busy.
  pump           0.7
  pumprate       #3
  gain           3.5 dB

patch "Gentle Pump" family=pump
  # A soft breathing on the beat.
  pump           0.4
  pumprate       #2
  gain           3.5 dB

patch "Sidechain Duck" family=pump
  # Ducks when another track plays: set it under sidechain.
  threshold      -30 dB
  ratio          8
  attack         1 ms
  release        150 ms
  makeup         10 dB
  gain           4 dB
