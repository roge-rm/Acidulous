# The whole instrument at once, which is the thing this machine is for:
# a bright upper with the tap, a soft lower to comp on, and the feet
# on 16' and 8'. One rack, three registrations.
patch "Two Manuals" family=tonewheel note=60 range=29..84 role=gospel
  ua_16          1
  ua_513         1
  ua_8           1
