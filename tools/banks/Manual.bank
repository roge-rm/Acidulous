# Squares divided down from one master oscillator and switched in by
# footage, which is the whole of a combo organ. No drawbars: a tab is
# in or it is out.
patch "Combo Bright" family=combo note=60 range=48..84 role=combo
  model          #1
  combowave      #0
  tab16          0.9
  tab8           1
  tab4           0.75
  tab2           0.15
  tab2r          0
  tab4r          0
  reedy          0.55
  comboatk       0.22
  rotary         #0
  perc           #0
  vibtype        #1
  vibrate        7.2
  vibdepth       0.55
  drive          0.25
  volume         0.93

# The pulse wave through the reedy filter well up, which is the buzz
# that made these things sound like a harmonica with a mains lead.
patch "Combo Reed" family=combo note=60 range=48..84 role=combo
