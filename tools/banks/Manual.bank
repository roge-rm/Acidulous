# Spray wound all the way up, which stops being a worn generator and
# becomes an ensemble. It is a detune across the wheels, so two keys
# sharing a harmonic are detuned by the same amount and stay together.
patch Sprayed family=odd note=60 range=41..84 role=gospel
  set macro1 "Spray"
  set macro2 "Tighten"
  set macro3 "Faster"
  set macro4 "Narrow"
  set macro5 "Top"
  set macro6 "Drive"
  set macro7 "Vibrato"
  set macro8 "Dark"
