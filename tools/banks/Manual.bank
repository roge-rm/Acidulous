# Past where the amplifier is polite. The bias is off centre so the
# clipping is not symmetrical, which is where the even harmonics come
# from and why this is a different sound and not just a louder one.
patch Overdrive family=tonewheel note=64 range=41..84 role=gospel
  ua_16          1
  ua_513         1
  ua_8           1
