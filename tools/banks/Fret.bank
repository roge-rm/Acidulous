patch "Broken Radio" family=odd note=57 range=40..84
  # A bridge pickup through a crushed, narrow speaker: lo-fi and fizzing.
  set macro1 "Round"
  set macro2 "Swell"
  set macro3 "Gain"
  set macro4 "Rattle"
  set macro5 "Dark"
  set macro6 "Vibrato"
  set macro7 "Ring Out"
  set macro8 "Bend Up"
