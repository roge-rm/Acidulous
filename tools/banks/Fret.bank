    midq         1.5
    highgain     -10 dB

patch "Howling Slide" family=odd note=57 range=45..80 role=lead
  # One voice sliding slowly, the amp feeding back on every held note.
  set macro1 "Howl"
  set macro2 "Swell"
  set macro3 "Gain"
