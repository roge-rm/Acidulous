# Subvert - seeded from what shipped, and not yet voiced.
#
# Values are in each parameter's own units; `audition params Subvert` lists
# them. A patch names only what it changes.

machine Subvert

patch Init

patch Classic
  accent         0.7
  cutoff         520.912 Hz
  drive          0.12
  envmod         0.55
  resonance      0.62
  slide          50 ms

patch Rubber
  accent         0.8
  cutoff         294.478 Hz
  decay          150.356 ms
  drive          0.25
  envmod         0.7
  resonance      0.75
  slide          79.2447 ms
  wave           #1

patch "Sub Hollow"
  cutoff         221.41 Hz
  decay          475.468 ms
  drive          0.05
  envmod         0.35
  pw             0.275
  resonance      0.4
  sub            0.6
  wave           #1

patch "Band Squelch"
  accent         0.9
  cutoff         692.82 Hz
  decay          119.432 ms
  drive          0.4
  envmod         0.8
  mode           #1
  resonance      0.85
