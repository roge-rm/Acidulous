  mac5_a2  -0.134
  mac6_d1  #7
  mac6_a1  0.5
  mac7_d1  #16
  mac7_a1  0.6
  mac7_d2  #20
  mac7_a2  0.194
  mac8_d1  #4
  mac8_a1  0.5
  viola          0.7
  cello          0.6
  ensemble       0.8
  volume         0.556

