patch "Warm Wash" family=pad
  # Two slow LFOs on the filter at rates that do not divide into each other,
  # so the movement never lines up and never repeats audibly.
  start          0.08
  a_attack       1.2 s
  a_decay        6 s
  a_sustain      0.85
  a_release      3 s
  f_type         #2
  f_freq         2400 Hz
  f_res          0.25
  l1_wave        #0
  l1_rate        0.09 Hz
  l1_keysync     #0
  l2_wave        #6
  l2_rate        0.14 Hz
  l2_keysync     #0
  m01_src        #11
  m01_dest       #10
  m01_depth      0.4
  m02_src        #12
  m02_dest       #10
  m02_depth      0.22
  keyfade        8 st
  loop           #2
  volume         0.72
  set macro1 "Dark"
  mac1_d1  #14
  mac1_a1  -0.182
  set macro2 "Slower"
  mac2_d1  #10
  mac2_a1  0.08
  mac2_d2  #13
  mac2_a2  0.12
  set macro3 "Bowed"
  mac3_d1  #3
  mac3_a1  0.12
  mac3_d2  #24
  mac3_a2  0.23
  set macro4 "Fade"
