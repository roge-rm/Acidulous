patch "Soft Pad" family=pad
  # The start moved past the transient entirely, so there is no strike left -
  # the note arrives instead of beginning. That is the whole patch.
  start          0.06
  a_attack       0.6 s
  a_decay        3 s
  a_sustain      0.9
  a_release      1.8 s
  f_type         #3
  f_freq         3500 Hz
  f_env          0.2
  f_decay        2 s
  f_sustain      0.6
  keyfade        6 st
  velfade        20
  loop           #2
  volume         0.99
