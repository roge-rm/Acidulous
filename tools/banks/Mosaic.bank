patch Dust family=grain
  # Dan: "is this a helicopter sound?" - it was: evenly spaced grains at twelve a
  # second are a rotor. The density wanders now, so the specks do not march.
  # Sparse enough to count. Twelve grains a second at twenty-five
  # milliseconds is a duty of three tenths, so they do not overlap and you
  # hear each one arrive as a speck - which is the only way a grain cloud
  # ever sounds like grains rather than like a texture. Sprayed right across
  # the sample so no two specks come from the same place.
  grain          #1
  gpos           0.35
  grate          0.2
  gsize          25 ms
  gdensity       22
  gspray         0.85
  gpitch         1 st
  a_attack       0.6 s
  a_decay        9 s
  a_sustain      0.8
  a_release      3 s
  f_type         #0
  f_freq         9000 Hz
  l1_wave        #6
  l1_rate        11 Hz
  l1_keysync     #0
  m01_src        #11
  m01_dest       #7
  m01_depth      0.75
  volume         0.83
  set macro1 "Thicker"
  mac1_d1  #7
  mac1_a1  0.25
  mac1_d2  #24
  mac1_a2  -0.26
  set macro2 "Longer"
  mac2_d1  #6
  mac2_a1  0.2
  mac2_d2  #7
  mac2_a2  -0.1
  mac2_d3  #24
  mac2_a3  -0.077
  set macro3 "Spray"
  mac3_d1  #8
  mac3_a1  0.15
  set macro4 "Further In"
  mac4_d1  #4
  mac4_a1  0.3
  set macro5 "Faster"
  mac5_d1  #5
  mac5_a1  0.15
  mac5_d2  #24
  mac5_a2  0.075
  set macro6 "Scatter"
  mac6_d1  #9
  mac6_a1  0.3
  set macro7 "Dark"
  mac7_d1  #14
  mac7_a1  -0.25
  set macro8 "Swell"
  mac8_d1  #10
  mac8_a1  0.15
  mac8_d2  #13
  mac8_a2  0.1

patch Smear family=grain
  # The other extreme: grains half a second long overlapping heavily, which
  # is a time-stretch rather than a cloud. Rate slightly under one so it
  # falls behind the note it came from.
  grain          #1
  gpos           0
  grate          0.75
  gsize          500 ms
  gdensity       30
