patch "Hard Hammer" family=keys
  # Velocity opens the filter as well as the level, and the filter closes
  # behind the hammer, so a hard note is bright for a moment and a soft one
  # stays dark.
  a_decay        5 s
  a_sustain      0.5
  a_release      0.35 s
  f_type         #3
  f_freq         1400 Hz
  f_env          0.5
  f_decay        0.4 s
  f_sustain      0.2
  veltofilter    0.8
  volume         0.847
  set macro1 "Dark"
  mac1_d1  #14
  mac1_a1  -0.143
  set macro2 "Harder"
  mac2_d1  #16
  mac2_a1  0.25
  mac2_d2  #23
  mac2_a2  0.2
  set macro3 "Longer"
