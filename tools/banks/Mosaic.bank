patch "Bell Keys" family=keys
  # Up an octave with the body left to ring, so the upper partials - the ones
  # that die first in the map - are most of what you hear.
  octave         1
  a_decay        4 s
  a_sustain      0.25
  a_release      2.2 s
  f_type         #5
  f_freq         600 Hz
  keyfade        8 st
  velfade        30
  volume         0.89
