  set macro7 "Even"
  mac7_d1  #22
  mac7_a1  -0.6
  mac7_d2  #24
  mac7_a2  -0.166
  set macro8 "Octave Up"
  mac8_d1  #18
  mac8_a1  0.5

patch Clav family=keys
  # Short, hard and band-passed, with velocity opening the filter a long way.
  # The start is moved just far enough to lose the softest part of the hit.
  start          0.008
  a_decay        0.6 s
  a_sustain      0
  a_release      0.12 s
  f_type         #11
  f_freq         760 Hz
  f_res          0.45
  f_env          0.5
  f_attack       0.001 s
  f_decay        0.25 s
  f_sustain      0.3
