patch Shimmer family=grain
  # Dense, small and *in tune*: grains taken from the bright front of the
  # sample, close together, so it sparkles rather than hisses.
  #
  # `gpitch` is a continuous random spread, not an interval - twelve
  # semitones means every grain lands somewhere in a two-octave band at
  # random, and at seventy grains a second that is noise however pretty the
  # number looks. Dust, Scatter and this were all written wide and all three
  # came out the same noise; Dan heard it straight away. Here the spread is
  # a third of a semitone: enough to shimmer, not enough to detune.
  grain          #1
  gpos           0.07
  grate          0.04
  gsize          24 ms
  gdensity       75
  gspray         0.08
  gpitch         0.3 st
  a_attack       0.2 s
  a_release      3 s
  l1_rate        0.2 Hz
  l1_keysync     #0
  m01_src        #11
  m01_dest       #4
  m01_depth      0.25
  m02_src        #3
  m02_dest       #9
  m02_depth      0.5
  volume         1.21
  set macro1 "Thinner"
  mac1_d1  #7
  mac1_a1  -0.25
  mac1_d2  #24
  mac1_a2  0.193
  set macro2 "Longer"
  mac2_d1  #6
  mac2_a1  0.2
  mac2_d2  #7
  mac2_a2  -0.1
  mac2_d3  #24
  mac2_a3  -0.202
  set macro3 "Spray"
  mac3_d1  #8
  mac3_a1  0.3
  set macro4 "Further In"
  mac4_d1  #4
  mac4_a1  0.3
  mac4_d2  #24
  mac4_a2  0.193
  set macro5 "Faster"
  mac5_d1  #5
  mac5_a1  0.15
  set macro6 "Scatter"
  mac6_d1  #9
  mac6_a1  0.3
  set macro7 "Dark"
  mac7_d1  #14
  mac7_a1  -0.25
  set macro8 "Swell"
  mac8_d1  #10
  mac8_a1  0.15
  mac8_d2  #13
  mac8_a2  0.1

