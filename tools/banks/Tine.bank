# Tine - struck and plucked bars, tines and pans.
#
# Each note is a handful of modes tuned to the ratios of what's struck: a
# wooden bar undercut to two octaves and a third, a harder one to a twelfth,
# a metal bar left free, a tine clamped at one end, or a pan's note tuned to
# octave and twelfth.
#
# `mallet` is how hard what strikes it, `position` where (the middle keeps a
# bar's second mode quiet), `tube` the resonator under the bar, `motor` and
# `depth` the discs turning in it, `damp` the damper on a let-go note (the
# sustain pedal lifts it), `bloom` a pan's octave growing out of the note,
# `buzz` a rattle on a tine, and `roll` strikes held notes again and again.
# Pressure bows a held bar.
#
# Families: wood, vibes, bells, thumb, pans.

machine Tine
role bell

patch Init family=wood note=60 range=36..96

patch Marimba family=wood note=60 range=36..96 role=keys
  # Rosewood bars over their tubes, medium yarn mallets.
  tube           0.7
  mallet         0.45

patch "Soft Marimba" family=wood note=55 range=36..90 role=keys
  # Soft mallets: the note and its tube, hardly any overtone.
  tube           0.8
  mallet         0.1
  position       0.15

patch "Bright Marimba" family=wood note=64 range=36..96 role=keys
  # Hard rubber mallets near the end of the bar.
  mallet         0.85
  position       0.6
  bright         0.65
  tube           0.6

patch "Bass Marimba" family=wood note=40 range=28..60 role=bass
  # The low end of the bars: long tubes, soft mallets.
  tube           0.9
  mallet         0.2
  decay          0.6

patch "Marimba Roll" family=wood note=60 range=36..90 role=pad
  # Held notes rolled with two soft mallets.
  roll           13
  volume         0.5
  mallet         0.2
  tube           0.8

patch Xylophone family=wood note=72 range=53..100 role=bell
  # Hard wood, tuned to the twelfth, struck with hard mallets.
  model          #2
  mallet         0.8
  tube           0.6

patch "Soft Xylophone" family=wood note=72 range=53..100 role=bell
  # The same bars with rubber mallets.
  model          #2
  mallet         0.35
  tube           0.7

patch "Dry Wood" family=wood note=60 range=40..90 role=keys
  # Bars with no tubes, damped short.
  tube           0
  decay          0.15
  mallet         0.7
  damp           0.6
  volume         1

patch Vibraphone family=vibes note=60 range=53..89 role=keys
  # Metal bars with the damper down: notes stop when let go.
  model          #1
  damp           0.85
  tube           0.7

patch "Vibes Motor" family=vibes note=60 range=53..89 role=keys
  # The discs turning, a quick, even pulse.
  model          #1
  damp           0.85
  tube           0.9
  motor          5.5
  depth          0.6

patch "Slow Motor" family=vibes note=57 range=53..89 role=chord
  # The discs turning slowly, the notes left to ring.
  model          #1
  tube           0.9
  motor          2
  depth          0.7

patch "Soft Vibes" family=vibes note=60 range=53..89 role=chord
  # Yarn mallets, the damper down.
  model          #1
  mallet         0.1
  damp           0.7
  tube           0.8

patch "Hard Vibes" family=vibes note=65 range=53..89 role=lead
  # Hard mallets near the end of the bar.
  model          #1
  mallet         0.85
  position       0.6
  damp           0.8
  tube           0.6

patch "Vibes Roll" family=vibes note=60 range=53..89 role=pad
  # Held notes rolled, the motor turning.
  model          #1
  roll           11
  volume         0.45
  mallet         0.2
  tube           0.9
  motor          4
  depth          0.4

patch "Long Vibes" family=vibes note=57 range=53..89 role=pad
  # Struck softly and left to ring for a long time.
  model          #1
  decay          0.8
  mallet         0.15
  tube           0.9

patch Glockenspiel family=bells note=84 range=72..108 role=bell
  # Steel bars and brass mallets.
  model          #3
  mallet         0.85
  tube           0

patch "Soft Glockenspiel" family=bells note=84 range=72..108 role=bell
  # The same bars with plastic mallets.
  model          #3
  mallet         0.45
  tube           0

patch "Bell Bars" family=bells note=72 range=60..100 role=bell
  # Steel bars struck with felt over wooden boxes: soft and glassy.
  model          #3
  mallet         0.25
  tube           0.6
  decay          0.4
  damp           0.7

patch "Music Box" family=bells note=79 range=60..100 role=bell
  # The teeth of a steel comb plucked by pins.
  model          #5
  tube           0.2

patch "Slow Music Box" family=bells note=72 range=55..96 role=bell
  # A larger comb, rings longer and darker.
  model          #5
  decay          0.75
  bright         0.35
  tube           0.3

patch "Tin Bells" family=bells note=84 range=67..108 role=bell
  # Small bars struck near the end, brittle.
  model          #3
  mallet         1
  position       0.8
  bright         0.75
  decay          0.3
  tube           0

patch "Thumb Piano" family=thumb note=60 range=48..88 role=tune
  # Metal tines over a wooden box, plucked by the thumbs.
  model          #4
  tube           0.4

patch "Buzzing Thumb" family=thumb note=60 range=48..88 role=tune
  # With rattles on the tines.
  model          #4
  buzz           0.6
  tube           0.4

patch "Gourd Thumb" family=thumb note=55 range=43..84 role=tune
  # Tines over a big gourd: round, low and buzzing a little.
  model          #4
  tube           0.9
  buzz           0.1
  bright         0.35
  mallet         0.3

patch "Bright Thumb" family=thumb note=67 range=52..92 role=tune
  # Plucked with the nails near the free end.
  model          #4
  mallet         0.9
  position       0.7
  bright         0.65
  tube           0.2
  volume         0.95

patch "Steel Pan" family=pans note=67 range=55..88 role=tune
  # A lead pan struck with rubber sticks, the octave blooming.
  model          #6
  bloom          0.6
  mallet         0.5
  tube           0

patch "Pan Roll" family=pans note=67 range=55..88 role=pad
  # Held notes rolled quickly, as pans play long notes.
  model          #6
  bloom          0.5
  roll           16
  volume         0.55
  mallet         0.35
  tube           0

patch "Bass Pan" family=pans note=43 range=31..60 role=bass
  # The big drums, the octave strong.
  model          #6
  bloom          0.8
  mallet         0.25
  decay          0.6
  tube           0

patch Handpan family=pans note=57 range=45..77 role=tune
  # Struck with the fingers: round and long.
  model          #7
  bloom          0.5
  tube           0.3

patch "Soft Handpan" family=pans note=55 range=45..77 role=pad
  # Softer fingers, longer ring, a little spread.
  model          #7
  mallet         0.1
  decay          0.7
  bloom          0.4
  spread         0.5
  tube           0.3

patch "Tongue Drum" family=pans note=60 range=48..79 role=tune
  # Tongues cut into a steel drum, struck with rubber mallets.
  model          #8
  tube           0.5

patch "Deep Tongue" family=pans note=48 range=40..67 role=tune
  # A bigger drum, low and long.
  model          #8
  mallet         0.2
  decay          0.7
  tube           0.7
