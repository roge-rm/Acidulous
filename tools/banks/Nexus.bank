patch Morphing family=morph
  # A cable's depth is a *pair*, A and B, and `morph` crossfades between them
  # - so one control rewires the patch while it plays. At morph 0 the string
  # is plucked by noise; at 1 it is driven by the oscillator instead, and
  # everything in between is a blend of the two.
  # The macros reach it through cables that carry nothing at 0.
  set nexus "v|2\nm|0|voice\nm|1|noise\nm|2|osc\nm|3|env\nm|4|vca\nm|5|string\nm|6|out|mono\nc|1.0|4.0|1.0|0.0\nc|2.0|4.0|0.0|1.0\nc|0.1|3.0|1.0\nc|3.0|4.1|1.0\nc|4.0|5.0|1.0\nc|5.0|6.0|1.0\nm|7|macro|mono\nm|8|delay|mono\nm|9|reverb|mono\nm|10|drive|mono\nc|5.0|8.0|0.0|0.0|7.0|0.5\nc|8.0|6.0|1.0\nc|7.1|8.1|0.3\nc|5.0|9.0|0.0|0.0|7.2|0.6\nc|9.0|6.0|1.0\nc|7.3|9.1|0.4\nc|5.0|10.0|0.0|0.0|7.4|0.5\nc|10.0|6.0|1.0\nc|7.5|5.2|0.04\nc|3.0|4.1|0.0|0.0|7.6|1.0\nc|7.7|5.2|-0.5"
