patch "Rosin Lead" note=67 range=48..88 family=lead
  # The string, bowed rather than plucked: an oscillator and a little
  # noise drive it for as long as the key is down. The vibrato is on the string's
  # own pitch jack and comes in late, from a second envelope.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|noise\nm|3|mix\nm|4|env\nm|5|vca\nm|6|string\nm|7|filter\nm|8|lfo|mono\nm|9|env\nm|10|reverb|mono\nm|11|macro|mono\nm|12|out|mono\nc|1.0|3.0|1\nc|2.0|3.1|0.15|0.15|11.1|0.4\nc|3.0|5.0|1\nc|0.1|4.0|1\nc|4.0|5.1|1\nc|5.0|6.0|0.3|0.3|11.2|0.4\nc|0.0|6.1|1\nc|0.1|9.0|1\nc|8.0|6.1|0.0|0.0|9.0|0.0012\nc|6.0|7.0|1\nc|7.0|12.0|1\nc|7.0|12.2|1\nc|7.0|10.0|0.3|0.3|11.4|0.5\nc|10.0|12.0|1\nc|10.1|12.2|1\nc|11.0|7.1|0.3\nc|8.0|6.1|0.0|0.0|11.3|0.002\nc|11.5|6.2|0.5\nc|11.6|1.2|0.35\nc|11.7|10.1|0.4"
  set macro1 "Bright"
  set macro2 "Rosin"
  set macro3 "Pressure"
  set macro4 "Vibrato"
  set macro5 "Space"
