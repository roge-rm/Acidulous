  # on a fifth of the eighths, each call a random note high up in G
  # major pentatonic, out across a wood.
  set nexus "v|2\nm|0|clock|mono\nm|1|prob|mono\nm|2|rand|mono\nm|3|snh|mono\nm|4|math|mono\nm|5|quant|mono\nm|6|bird|mono\nm|7|filter|mono\nm|8|vca|mono\nm|9|lfo|mono\nm|10|reverb|mono\nm|11|delay|mono\nm|12|macro|mono\nm|13|out|mono\nc|0.0|1.0|1\nc|0.0|2.0|1\nc|2.0|3.0|1\nc|1.0|3.1|1\nc|3.0|4.0|0.11024\nc|4.0|5.0|1\nc|5.0|6.0|1\nc|1.0|6.1|1\nc|6.0|7.0|1\nc|7.0|8.0|1\nc|8.0|13.0|1\nc|8.0|10.0|0.4|0.4|12.2|0.5\nc|10.0|13.0|1\nc|10.1|13.2|1\nc|12.0|1.1|0.4\nc|12.1|7.1|-0.3\nc|12.3|10.1|0.3\nc|8.0|11.0|0|0|12.4|0.5\nc|11.0|13.0|1\nc|11.0|13.2|1\nc|12.5|11.1|0.3\nc|12.6|4.1|-0.09449\nc|9.0|8.1|0|0|12.7|0.5\nc|8.0|13.2|1"
