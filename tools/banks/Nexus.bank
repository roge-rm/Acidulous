patch "Rotor String" family=house
  # And through Manual's cabinet, which is the other block nothing else can
  # offer. A plucked string in a rotating speaker is not a sound anybody has.
  #
  # Both of the cabinet's outputs go to the sink - `c|5.1|6.2` is the right
  # one - because a rotary speaker heard through a single microphone is not one.
  # Until the sink grew a second input there was nowhere for that cable to go,
  # and this patch was two bit-identical channels.
  # The macros reach it through cables that carry nothing at 0.
  set nexus "v|2\nm|0|voice\nm|1|noise\nm|2|env\nm|3|vca\nm|4|string\nm|5|rotary|mono\nm|6|out|mono\nc|1.0|3.0|1.0\nc|0.1|2.0|1.0\nc|2.0|3.1|1.0\nc|3.0|4.0|1.0\nc|4.0|5.0|1.0\nc|5.0|6.0|1.0\nc|5.1|6.2|1.0\nm|7|macro|mono\nm|8|delay|mono\nm|9|reverb|mono\nm|10|drive|mono\nc|4.0|8.0|0.0|0.0|7.0|0.5\nc|8.0|6.0|1.0\nc|8.0|6.2|1.0\nc|7.1|8.1|0.3\nc|4.0|9.0|0.0|0.0|7.2|0.6\nc|9.0|6.0|1.0\nc|9.1|6.2|1.0\nc|7.3|9.1|0.4\nc|4.0|10.0|0.0|0.0|7.4|0.5\nc|10.0|6.0|1.0\nc|10.0|6.2|1.0\nc|7.5|4.2|0.03\nc|2.0|3.1|0.0|0.0|7.6|1.0\nc|7.7|4.2|-0.5"
