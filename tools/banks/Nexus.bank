patch "Feeding Back" family=texture
  # A delay inside the voice rather than after it, with its output back into
  # the filter - so the repeats are filtered again each time round and the
  # patch settles into a resonance of its own. Kept under the point where it
  # runs away, which is not far from here.
  # The macros reach it through cables that carry nothing at 0.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|filter\nm|3|delay|mono\nm|4|env\nm|5|vca\nm|6|out|mono\nc|0.0|1.0|1.0\nc|1.0|2.0|1.0\nc|2.0|5.0|1.0\nc|5.0|3.0|0.5\nc|3.0|2.0|0.35|0.35|7.7|0.3\nc|0.1|4.0|1.0\nc|4.0|5.1|1.0\nc|5.0|6.0|1.0\nm|7|macro|mono\nm|8|delay|mono\nm|9|reverb|mono\nm|10|drive|mono\nc|5.0|8.0|0.0|0.0|7.0|0.5\nc|8.0|6.0|1.0\nc|7.1|8.1|0.3\nc|5.0|9.0|0.0|0.0|7.2|0.6\nc|9.0|6.0|1.0\nc|7.3|9.1|0.4\nc|5.0|10.0|0.0|0.0|7.4|0.5\nc|10.0|6.0|1.0\nc|7.5|2.1|0.3\nc|7.6|2.2|0.2"
