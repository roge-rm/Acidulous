# Nexus - the modular, whose patches are graphs.
#
# A patch here is not a set of knob values, it is a *wiring*: a line per module
# and a line per cable, in `set nexus`. The format is the one the editor saves,
# so a patch built on the device and a patch written here are the same thing.
#
#   m|<slot>|<type>[|mono]     a module in a slot
#   c|<slot>.<port>|<slot>.<port>|<depth>
#   c|<slot>.<port>|<slot>.<port>|<a>|<b>|<slot>.<port>|<amount>
#                              a cable whose depth a third jack turns up
#
# Knobs are ordinary parameters, `sNN_pM`, and a patch names only the ones it
# wants different: everything else takes the module's own default. That is new
# - every slot knob defaults to zero, so before this a graph had to state a
# dozen values before it made any sound at all.
#
# These seven came out of PatchStore.kt, where they were built in Kotlin
# because enumerating them was thought to need the engine over JNI. It does
# not: the graph is text.
#
# Families in tab order: lead 10, bass 10, pad 12, house 16, percussion 10,
# generative 14, morph 10 and texture 14. Init is first, so lead is the first
# tab. Within a family they run plainest to strangest.
#
# Some generative and texture patches have no voice module and play
# themselves from the transport. The morph patches are built around A->B:
# their cables carry an A and a B depth and the play card's A->B knob turns
# from one to the other.
#
# A text depth on a `c|` line is not what plays: the first 24 cables take
# their depths from the parameters cNN_a and cNN_b, which start at 1. A patch
# that wants another depth sets those.
#
# The house patches use the modules lifted from the other machines and the
# insert effects: Brazen's horn, Tongue's reed through Diction's throat, Formulate's
# expressions (the `e|` line is the formula module's text), Molt's ear
# playing Hammer, and Draw's reed beside Timber's pipe.
#
# Levels: held and pattern patches sit at -24.5 dB on `loud`, the loudest
# four hundred milliseconds. A pluck spends most of that window decaying, so
# the plucks stop where their peak reaches -8 dBFS and sit lower. Drums are
# levelled by their peaks. Gain past the top of volume is an Eq insert.

machine Nexus

patch Init family=lead
  # A voice, not a drone. An oscillator wired straight to the output is the
  # smallest graph that makes a noise, and it was Init until it had to set the
  # house level: with no envelope it sounds at full level forever, which is
  # fourteen decibels louder than any real patch and made every other one in
  # the bank measure quiet against it. This is the smallest graph anybody
  # would actually keep - oscillator, filter, envelope, amplifier.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|filter\nm|3|env\nm|4|vca\nm|5|out|mono\nc|1.0|2.0|1.0\nc|2.0|4.0|1.0\nc|0.1|3.0|1.0\nc|3.0|4.1|1.0\nc|4.0|5.0|1.0"

patch Subtractive family=lead
  # The patch everybody builds first, so it is here already: an oscillator
  # through a filter, opened by an envelope.
  # The macros reach it through cables that carry nothing at 0, so with
  # every macro down this is still the plain patch.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|filter\nm|3|env\nm|4|vca\nm|5|out|mono\nc|1.0|2.0|1.0\nc|2.0|4.0|1.0\nc|0.1|3.0|1.0\nc|3.0|4.1|1.0\nc|4.0|5.0|1.0\nm|6|macro|mono\nm|7|lfo|mono\nm|8|delay|mono\nc|6.0|2.1|0.4\nc|6.1|2.2|0.6\nc|3.0|2.1|0.0|0.0|6.2|0.4\nc|7.0|1.1|0.0|0.0|6.3|0.02\nc|6.4|7.0|0.5\nc|4.0|8.0|0.0|0.0|6.5|0.6\nc|8.0|5.0|1.0\nc|6.6|8.1|0.3\nc|7.0|2.1|0.0|0.0|6.7|0.15"
  set macro1 "Cutoff"
  set macro2 "Reso"
  set macro3 "Env"
  set macro4 "Vibrato"
  set macro5 "Rate"
  set macro6 "Echo"
  set macro7 "Time"
  set macro8 "Wobble"
  s02_p2         0.45
  s02_p3         0.35
  s03_p2         0.05
  s03_p4         0.3
  s05_p1         0.35
  c05_a          0.4000
  c05_b          0.4000
  c06_a          0.6000
  c06_b          0.6000
  c07_a          0.0000
  c07_b          0.0000
  c08_a          0.0000
  c08_b          0.0000
  c09_a          0.5000
  c09_b          0.5000
  c10_a          0.0000
  c10_b          0.0000
  c12_a          0.3000
  c12_b          0.3000
  c13_a          0.0000
  c13_b          0.0000
  s07_p2         0.737
  s08_p1         0.739
  s08_p2         0.35
  s08_p3         0.4
  s08_p4         1.0
  volume         1.000
  insert Eq
    gain         1.3 dB

patch "Width Walker" note=67 range=48..88 family=lead
  # A pulse whose width an LFO walks, through a four-pole filter. The
  # vibrato comes in late: a second envelope turns up the depth of the cable
  # from the vibrato LFO, so a held note starts straight and then sings.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|filter\nm|3|env\nm|4|vca\nm|5|lfo|mono\nm|6|lfo|mono\nm|7|env\nm|8|delay|mono\nm|9|macro|mono\nm|10|out|mono\nc|1.0|2.0|1\nc|2.0|4.0|1\nc|0.1|3.0|1\nc|3.0|4.1|1\nc|4.0|10.0|1\nc|3.0|2.1|0.25|0.25|9.2|0.3\nc|5.0|1.2|0.25|0.25|9.1|0.2\nc|0.1|7.0|1\nc|6.0|1.1|0.0|0.0|7.0|0.012\nc|6.0|1.1|0.0|0.0|9.3|0.02\nc|4.0|8.0|0.2|0.2|9.4|0.5\nc|8.0|10.0|1\nc|9.0|2.1|0.35\nc|9.5|2.2|0.5\nc|9.6|8.1|0.3\nc|5.0|2.1|0.0|0.0|9.7|0.15"
  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "Env"
  set macro4 "Vibrato"
  set macro5 "Echo"
  set macro6 "Reso"
  set macro7 "Time"
  set macro8 "Wobble"
