patch "One Knob, Four Things" family=lead
  # The same macro into four places, each cable at its own depth - which is
  # the whole argument for every cable being a VCA. One knob opens the filter
  # a lot, detunes the second oscillator a little, and turns up the cable
  # from the noise.
  # The other seven macros each do one thing, and do nothing at 0.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|osc\nm|3|noise\nm|4|mix|mono\nm|5|filter\nm|6|env\nm|7|vca\nm|8|macro|mono\nm|9|out|mono\nc|1.0|4.0|1.0\nc|2.0|4.1|0.6\nc|3.0|4.2|0.25|0.25|8.0|0.5\nc|4.0|5.0|1.0\nc|5.0|7.0|1.0\nc|0.1|6.0|1.0\nc|6.0|7.1|1.0\nc|7.0|9.0|1.0\nc|8.0|5.1|0.9\nc|8.0|2.1|0.02\nm|10|lfo|mono\nm|11|delay|mono\nc|8.1|5.2|0.5\nc|6.0|5.1|0.0|0.0|8.2|0.3\nc|10.0|1.1|0.0|0.0|8.3|0.02\nc|10.0|2.1|0.0|0.0|8.3|0.02\nc|8.4|10.0|0.5\nc|7.0|11.0|0.0|0.0|8.5|0.5\nc|11.0|9.0|1.0\nc|8.6|11.1|0.3\nc|10.0|5.1|0.0|0.0|8.7|0.15"
  set macro2 "Reso"
  set macro3 "Env"
  set macro4 "Vibrato"
  set macro5 "Rate"
  set macro6 "Echo"
  set macro7 "Time"
  set macro8 "Wobble"
  set macro1 "Thicken"
  macro1         0.4
  s02_p2         0.52
  s05_p2         0.25
  s05_p3         0.4
