patch "Operator Lead" note=67 range=48..88 family=lead
  # Two operators patched by hand: the modulator a ratio of two, its
  # depth on an envelope through a VCA. Vibrato is a cable from the LFO into
  # both pitch jacks beside the voice's own pitch, which the jacks add up.
  set nexus "v|2\nm|0|voice\nm|1|op\nm|2|op\nm|3|op\nm|4|env\nm|5|vca\nm|6|env\nm|7|vca\nm|8|lfo|mono\nm|9|delay|mono\nm|10|macro|mono\nm|11|out|mono\nc|0.0|1.2|1\nc|0.0|2.2|1\nc|8.0|1.2|0.0009|0.0009|10.3|0.002\nc|8.0|2.2|0.0009|0.0009|10.3|0.002\nc|1.0|5.0|1\nc|0.1|4.0|1\nc|4.0|5.1|1\nc|5.0|2.0|0.25|0.25|10.0|0.3\nc|2.0|7.0|1\nc|0.1|6.0|1\nc|6.0|7.1|1\nc|7.0|11.0|1\nc|7.0|9.0|0.2|0.2|10.4|0.5\nc|9.0|11.0|1\nc|10.1|5.1|0.5\nc|3.0|7.0|0.0|0.0|10.2|0.5\nc|10.5|9.1|0.3\nc|1.0|2.0|0.0|0.0|10.6|0.4\nc|10.7|1.2|0.001"
  set macro1 "Bright"
