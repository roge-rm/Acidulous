patch "Macro Sweep" family=bass
  # What a macro is. The `macro` module has no knobs and eight outputs, each
  # carrying one of the eight macro parameters - so you assign a macro by
  # patching it, not by choosing it from a list. Here macro 1 goes to the
  # filter's cutoff, and turning it sweeps the patch.
  # The other seven macros go the same way, each a cable from the module.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|filter\nm|3|env\nm|4|vca\nm|5|macro|mono\nm|6|out|mono\nc|1.0|2.0|1.0\nc|2.0|4.0|1.0\nc|0.1|3.0|1.0\nc|3.0|4.1|1.0\nc|4.0|6.0|1.0\nc|5.0|2.1|0.8\nm|7|lfo|mono\nm|8|delay|mono\nm|9|drive\nm|10|osc\nc|5.1|2.2|0.6\nc|3.0|2.1|0.0|0.0|5.2|0.4\nc|7.0|2.1|0.0|0.0|5.3|0.2\nc|5.4|7.0|1.0\nc|4.0|9.0|0.0|0.0|5.5|0.8\nc|9.0|6.0|1.0\nc|4.0|8.0|0.0|0.0|5.6|0.5\nc|8.0|6.0|1.0\nc|10.0|2.0|0.0|0.0|5.7|0.6"
  set macro2 "Reso"
  set macro3 "Env"
  set macro4 "Wobble"
  set macro5 "Rate"
  set macro6 "Grit"
  set macro7 "Echo"
  set macro8 "Sub"
  set macro1 "Cutoff"
