patch Listening family=house input=break
  # Whatever is plugged in, granulated. On a phone that input is you.
  #
  # The cabinet came off: a rotary swells and falls on its own cycle, so a
  # render that happens to end on a swell reads as a tail getting louder,
  # which is what a runaway looks like from outside. Rotor String next door
  # is where the cabinet belongs, under something that decays.
  # The macros reach it through cables that carry nothing at 0.
  set nexus "v|2\nm|0|audioin|mono\nm|1|grain|mono\nm|2|out|mono\nc|0.0|1.0|1.0\nc|1.0|2.0|1.0\nm|3|macro|mono\nm|4|delay|mono\nm|5|reverb|mono\nm|6|drive|mono\nm|7|chorus|mono\nc|1.0|4.0|0.0|0.0|3.0|0.5\nc|4.0|2.0|1.0\nc|3.1|4.1|0.3\nc|1.0|5.0|0.0|0.0|3.2|0.6\nc|5.0|2.0|1.0\nc|3.3|5.1|0.4\nc|1.0|6.0|0.0|0.0|3.4|0.5\nc|6.0|2.0|1.0\nc|3.5|1.1|0.4\nc|3.6|1.2|0.4\nc|1.0|7.0|0.0|0.0|3.7|0.6\nc|7.0|2.0|1.0"
