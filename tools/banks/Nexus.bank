patch "Wired Lead" note=67 range=48..88 family=lead
  # Two saws through a filter, with vibrato, a wah, an echo and a breath of noise
  # each on a macro. The echo is a send: the dry voice goes straight out, and
  # Echo turns up the cable into the delay.
  set nexus "v|2\nm|0|voice\nm|1|osc\nm|2|osc\nm|3|noise\nm|4|mix\nm|5|filter\nm|6|env\nm|7|vca\nm|8|lfo|mono\nm|9|delay|mono\nm|10|macro|mono\nm|11|out|mono\nm|12|lfo|mono\nc|1.0|4.0|1.0\nc|2.0|4.1|1.0\nc|3.0|4.2|0.0|0.0|10.6|0.5\nc|4.0|5.0|1.0\nc|5.0|7.0|1.0\nc|0.1|6.0|1.0\nc|6.0|7.1|1.0\nc|7.0|11.0|1.0\nc|7.0|9.0|0.0|0.0|10.3|0.7\nc|9.0|11.0|1.0\nc|10.0|5.1|0.45\nc|10.1|5.2|0.5\nc|8.0|1.1|0.0|0.0|10.2|0.02\nc|8.0|2.1|0.0|0.0|10.2|0.02\nc|10.4|2.1|0.03\nc|10.5|9.1|0.3\nc|12.0|5.1|0.0|0.0|10.7|0.3"
  set macro1 "Bright"
  set macro2 "Bite"
  set macro3 "Vibrato"
  set macro4 "Echo"
