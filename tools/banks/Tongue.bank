  mac2_a2  -0.14
  mac3_d1  #6
  mac3_a1  0.45
  mac4_d1  #7
  mac4_a1  -0.3
  mac5_d1  #10
  mac5_a1  0.5
  mac5_d2  #12
  mac5_a2  0.4
  mac5_d3  #11
  mac5_a3  0.15
  mac5_d4  #21
  mac5_a4  -0.154
  mac6_d1  #18
  mac6_a1  0.6
  mac7_d1  #4
  mac7_a1  -0.4
  mac8_d1  #22
  mac8_a1  -0.5
  edge           0.85
  pluck          0.9
  focus          0.85
  volume         0.75

