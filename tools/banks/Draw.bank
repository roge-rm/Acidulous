patch Concertina family=button note=64 range=55..91
  # Small reeds in a short chamber, one a note.
  set macro1 "Bellows"
  set macro2 "Bright"
  set macro3 "Dark"
  set macro4 "Touch"
  set macro5 "Shake"
  set macro6 "Swell"
  set macro7 "Box"
  set macro8 "Air"
  mac1_d1  #1
  mac1_a1  0.4
  mac1_d2  #8
  mac1_a2  -0.157
  mac2_d1  #4
  mac2_a1  -0.4
  mac3_d1  #10
  mac3_a1  0.5
  mac4_d1  #7
  mac4_a1  0.4
  mac4_d2  #8
  mac4_a2  0.171
  mac5_d1  #13
  mac5_a1  0.5
  mac6_d1  #2
  mac6_a1  0.35
  mac6_d2  #3
  mac6_a2  0.25
  mac7_d1  #5
  mac7_a1  0.5
  mac8_d1  #6
  mac8_a1  0.6
  model          6      # concertina

