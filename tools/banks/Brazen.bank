patch Horn family=horn  note=53 range=41..72
  # Bell high and the bore wide: a horn is played into its own bell and that
  # is why it is the mellow one.
  #
  # One player, and that was not the first answer. Two locked tight cancelled
  # each other on some intervals and left a hole in the middle of the phrase -
  # which is the model working, since the players really do listen to one
  # another, but a preset should not have a hole in it. Section and Shambles
  # are where the ensemble lives.
  set macro1 "Blow"
  set macro2 "Brassy"
  set macro3 "Breathy"
  set macro4 "Swell"
  set macro5 "Vibrato"
  set macro6 "Dark"
  set macro7 "Flutter"
  set macro8 "Soft Attack"
  mac1_d1  #7
  mac1_a1  0.12
  mac1_d2  #10
  mac1_a2  0.15
  mac2_d1  #10
  mac2_a1  0.3
  mac2_d2  #9
  mac2_a2  0.1
  mac3_d1  #8
  mac3_a1  0.3
  mac4_d1  #33
  mac4_a1  0.2
  mac4_d2  #34
  mac4_a2  0.1
  mac5_d1  #22
  mac5_a1  0.2
  mac5_d2  #24
  mac5_a2  -0.1
  mac6_d1  #25
  mac6_a1  -0.3
  mac7_d1  #35
  mac7_a1  0.5
  mac8_d1  #18
  mac8_a1  0.15
  mac8_d2  #7
  mac8_a2  -0.1
  swell          0.3
  swelltime      0.5 s
  size           0.34
  bell           0.8
  brass          0.6
  pressure       0.85
  lipdamp        0.42
  bite           0.78
  attack         0.045 s
  release        0.4 s
  vibrato        6 cents
  width          0.5
  breath         0.05
  fine           12 cents
  volume         0.62
  cutoff         4800 Hz

