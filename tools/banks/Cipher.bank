  mac4_a1  0.5
  mac4_d2  #19
  mac4_a2  0.3
  set macro5 "Hiss"
  mac5_d1  #12
  mac5_a1  0.4
  set macro6 "Grit"
  mac6_d1  #24
  mac6_a1  0.6
  mac6_d2  #21
  mac6_a2  0.5
  mac6_d3  #25
  mac6_a3  -0.412
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.171
  mac7_d2  #25
  mac7_a2  0.045
  set macro8 "Octave Down"
