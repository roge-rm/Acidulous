patch Squashed family=formant
  # Spacing narrowed instead: everything crowded into the middle of the
  # spectrum, which is what a voice does through a small speaker and why this
  # one reads as "small" rather than "filtered".
  bands          #24
  stretch        -0.5
  release        0.08 s
  sibilance      0.55
  volume         0.74
  set macro1 "Further"
  mac1_d1  #9
