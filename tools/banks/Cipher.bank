  set macro5 "Sharper"
  mac5_d1  #3
  mac5_a1  0.35
  mac5_d2  #25
  mac5_a2  0.107
  set macro6 "Thicker"
  mac6_d1  #17
  mac6_a1  0.5
  mac6_d2  #19
  mac6_a2  0.3
  mac6_d3  #25
  mac6_a3  -0.082
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
