# Cipher - forty patches, voiced against the debug build.
#
# A vocoder listens to one sound through a bank of filters, measures how loud
# each band is, and imposes that shape on another. Everything interesting is
# what happens between the measuring and the imposing, and most vocoders let
# you do nothing there: band one drives band one, forever.
#
# Here the banks are wired through a map, and the map is the machine. That is
# why `remap` gets a family of its own: reversed, mirrored, folded, odd
# against even, or shuffled from a seed. Speech through a reversed bank is
# still speech-shaped and completely unintelligible, and nothing else sounds
# like it.
#
# The harness puts a voice on the input bus, because a vocoder with nothing to
# listen to is silence, and a vocoder auditioned on a steady vowel tells you
# nothing - the band map only shows what it does when what goes through it
# moves. On a phone that input is you.
#
# `#n` is the step index, not the value, which matters wherever a stepped
# parameter does not start at zero: `bands` runs 4..40, so sixteen bands is
# `#12` and thirty-two is `#28`.
#   remap    #0 direct  #1 reversed  #2 mirrored  #3 odd/even  #4 shuffled  #5 folded
#   role     #0 the input is the modulator  #1 the input is the carrier
#   wave     #0 saw  #1 pulse  #2 super  #3 noise  #4 ring
#   freeze, track, slope  #0 off  #1 on
#
# Families: classic, remap, formant, hold, carrier, extreme.
#
# Every patch but Init has eight macros, named for its family. Their
# destinations by step:
#   #1 low  #2 high  #3 width  #4 attack  #5 release  #6 smear  #7 gate
#   #8 shift  #9 stretch  #10 remap amount  #11 morph  #12 sibilance
#   #13 track amount  #14 feedback  #15 fb tone  #16 mix  #17 detune  #18 pw
#   #19 sub  #20 noise  #21 carrier drive  #22 dry  #23 wet  #24 drive
#   #25 volume  #26 pan  #27 amp attack  #28 amp release  #29 pitch
# The volume routes keep each macro within about a decibel of the patch.

machine Cipher
# Held chords over the whole recording. A vocoder is only audible while its
# carrier sounds, and the default phrase lets go after two seconds - which
# left twelve seconds of noise floor in every demo.
role vocode

patch Init family=classic

patch Classic family=classic
  # The robot voice, done properly: a fast attack so consonants arrive on
  # time, a release short enough that the bank lets go between syllables, and
  # a saw carrier with enough harmonics for every band to have something to
  # impose its shape on. This is the one to judge intelligibility on.
  bands          #20
  attack         0.002 s
  release        0.04 s
  q              0.6
  sibilance      0.5
  mix            0.25
  detune         8 c
  volume         1.19
  set macro1 "Higher"
  mac1_d1  #8
  mac1_a1  0.2
  mac1_d2  #25
  mac1_a2  -0.211
  set macro2 "Smoother"
  mac2_d1  #5
  mac2_a1  0.3
  mac2_d2  #25
  mac2_a2  -0.188
  set macro3 "Sharper"
  mac3_d1  #3
  mac3_a1  0.35
  mac3_d2  #25
  mac3_a2  0.12
  set macro4 "Thicker"
  mac4_d1  #17
  mac4_a1  0.5
  mac4_d2  #19
  mac4_a2  0.3
  mac4_d3  #25
  mac4_a3  -0.052
  set macro5 "Hiss"
  mac5_d1  #12
  mac5_a1  0.4
  set macro6 "Grit"
  mac6_d1  #24
  mac6_a1  0.6
  mac6_d2  #21
  mac6_a2  0.5
  mac6_d3  #25
  mac6_a3  -0.29
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  -0.106
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.096

patch "Fine Grain" family=classic
  # Forty bands, the most the bank has, with steep four-pole slopes and a
  # narrow width: every formant gets a band of its own, so the words come
  # through with the least robot in them.
  bands          #36
  q              0.7
  attack         0.0015 s
  release        0.035 s
  sibilance      0.5
  mix            0.3
  detune         10 c
