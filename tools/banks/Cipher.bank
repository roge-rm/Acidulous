patch Folded family=remap
  # Folded, so the top and the bottom of the bank share bands. Congested on
  # purpose: two parts of the spectrum arriving in the same place is what
  # makes it dense rather than merely reordered.
  bands          #20
  remap          #5
  release        0.1 s
  q              0.5
  volume         1.00
  set macro1 "Untangle"
  mac1_d1  #10
