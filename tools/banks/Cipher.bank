patch Stretched family=formant
  # The bank's spacing warped wider, so the bands are read further apart than
  # they were measured. Vowels pulled away from each other - unnatural, wide,
  # and still clearly derived from speech.
  bands          #24
  stretch        0.5
  release        0.08 s
  volume         1.35
  set macro1 "Further"
  mac1_d1  #9
  mac1_a1  0.4
