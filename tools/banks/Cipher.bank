patch "Low Throat" family=formant
  # Down four and stretched apart, so the low formants sink and the top
  # ones open: a large throat with a bright edge.
  bands          #24
  shift          -4
  stretch        0.6
  release        0.09 s
  sub            0.3
  volume         1.035
  set macro1 "Further"
  mac1_d1  #8
