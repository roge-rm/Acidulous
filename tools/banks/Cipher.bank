patch Lifted family=formant
  # Three semitones up: a younger, lighter voice that still sounds like a
  # person rather than an effect.
  bands          #24
  shift          3
  release        0.07 s
  volume         0.93
  set macro1 "Further"
  mac1_d1  #8
