  set macro3 "Stretch"
  mac3_d1  #9
  mac3_a1  0.4
  set macro4 "Smoother"
  mac4_d1  #5
  mac4_a1  0.3
  mac4_d2  #25
  mac4_a2  -0.194
  set macro5 "Sharper"
  mac5_d1  #3
  mac5_a1  0.35
  set macro6 "Thicker"
  mac6_d1  #17
  mac6_a1  0.5
  mac6_d2  #19
  mac6_a2  0.3
