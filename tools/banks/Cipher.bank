  mac4_a2  -0.295
  set macro5 "Sharper"
  mac5_d1  #3
  mac5_a1  0.35
  mac5_d2  #25
  mac5_a2  0.091
  set macro6 "Thicker"
  mac6_d1  #17
  mac6_a1  0.5
  mac6_d2  #19
  mac6_a2  0.3
  mac6_d3  #25
