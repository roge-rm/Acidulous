patch Backwards family=remap
  # The bank reversed: the lowest band of the analysis drives the highest of
  # the synthesis. Still unmistakably speech-shaped - the rhythm and the
  # consonants survive - and completely unintelligible. The patch this machine
  # exists for.
  bands          #20
  remap          #1
  release        0.08 s
  mix            0.5
  sub            0.25
