  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  mac5_d3  #25
  mac5_a3  0.055
  set macro6 "Sharper"
  mac6_d1  #3
  mac6_a1  0.35
  set macro7 "Darker"
