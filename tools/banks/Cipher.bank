patch "Sub Heavy" family=carrier
  # Weighted low, with the bank's bottom brought down to meet it: chest rather
  # than throat. The sub is below the lowest band, so it is felt and never
  # vocoded, which is exactly how it should be used.
  bands          #20
  low            70 Hz
  sub            0.8
  mix            0.3
  release        0.1 s
  volume         0.58
  set macro1 "Blend"
  mac1_d1  #16
  mac1_a1  0.4
  set macro2 "Detune"
  mac2_d1  #17
  mac2_a1  0.5
  set macro3 "Sub"
  mac3_d1  #19
  mac3_a1  0.5
  set macro4 "Noise"
  mac4_d1  #20
  mac4_a1  0.4
  mac4_d2  #25
  mac4_a2  0.035
  set macro5 "Drive"
  mac5_d1  #21
  mac5_a1  0.7
  set macro6 "Smoother"
  mac6_d1  #5
  mac6_a1  0.3
  mac6_d2  #25
  mac6_a2  -0.094
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  0.055
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.309

patch Breath family=carrier
  # A noise carrier with the unvoiced path open: whispered, with no pitch at
  # all. The keyboard stops changing the note and starts changing nothing,
  # which is correct - a whisper has no fundamental to move.
  bands          #28
  "wave a"         #3
  "wave b"         #3
  mix            0.7
  noise          0.8
  unvoiced       0.5
  sibilance      0.7
  release        0.12 s
  volume         2.00
  set macro1 "Blend"
  mac1_d1  #16
  mac1_a1  -0.4
  set macro2 "Detune"
  mac2_d1  #17
  mac2_a1  0.5
  set macro3 "Sub"
  mac3_d1  #19
  mac3_a1  0.5
  mac3_d2  #25
  mac3_a2  -0.241
  set macro4 "Noise"
  mac4_d1  #20
  mac4_a1  0.4
  set macro5 "Drive"
  mac5_d1  #21
  mac5_a1  0.7
  set macro6 "Smoother"
  mac6_d1  #5
  mac6_a1  0.3
  mac6_d2  #25
  mac6_a2  -0.316
