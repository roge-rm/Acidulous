  set macro5 "Drive"
  mac5_d1  #21
  mac5_a1  0.7
  mac5_d2  #25
  mac5_a2  -0.128
  set macro6 "Smoother"
  mac6_d1  #5
  mac6_a1  0.3
  mac6_d2  #25
  mac6_a2  -0.179
  set macro7 "Darker"
  mac7_d1  #2
