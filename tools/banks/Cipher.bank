  mac8_a2  0.196

patch "Trail Up" family=hold
  # Smear positive: the release is scaled across the bank so the top lets go
  # before the bottom. The spectrum leaves a trail that falls as it fades,
  # which is the sound of a room swallowing a voice.
  bands          #28
  smear          0.8
  release        0.5 s
  q              0.5
  volume         0.99
  set macro1 "Longer"
  mac1_d1  #5
  mac1_a1  0.25
  mac1_d2  #25
  mac1_a2  -0.132
  set macro2 "Smear"
  mac2_d1  #6
  mac2_a1  0.1
  set macro3 "Swell"
  mac3_d1  #27
  mac3_a1  0.35
  set macro4 "Tail"
  mac4_d1  #28
  mac4_a1  0.3
  set macro5 "Thicker"
  mac5_d1  #17
  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  mac5_d3  #25
  mac5_a3  0.06
  set macro6 "Sharper"
  mac6_d1  #3
  mac6_a1  0.35
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  -0.054
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.229

patch "Trail Down" family=hold
  # Smear the other way: the bottom decays first and a bright ghost is left
  # behind. Less natural than Trail Up and much more useful over a pad.
  bands          #28
  smear          -0.8
  release        0.5 s
  volume         0.70
  set macro1 "Longer"
  mac1_d1  #5
  mac1_a1  0.25
  mac1_d2  #25
  mac1_a2  -0.034
  set macro2 "Smear"
  mac2_d1  #6
  mac2_a1  -0.1
  set macro3 "Swell"
  mac3_d1  #27
  mac3_a1  0.35
  set macro4 "Tail"
  mac4_d1  #28
  mac4_a1  0.3
  set macro5 "Thicker"
  mac5_d1  #17
  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  mac5_d3  #25
  mac5_a3  0.029
  set macro6 "Sharper"
  mac6_d1  #3
  mac6_a1  0.35
  mac6_d2  #25
  mac6_a2  0.034
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.162

patch Pulse family=carrier
  # A narrow pulse carrier. Nasal and reedy, with the odd harmonics a pulse
  # has and the even ones it does not - which changes which bands have
  # anything to impose a shape on, and so changes the vowels themselves.
  bands          #20
  "wave a"         #1
  "wave b"         #1
  pw             0.12
  mix            0.0
  release        0.06 s
  volume         1.55
  set macro1 "Blend"
  mac1_d1  #16
  mac1_a1  0.4
  mac1_d2  #25
  mac1_a2  0.225
  set macro2 "Detune"
  mac2_d1  #17
  mac2_a1  0.5
  set macro3 "Sub"
  mac3_d1  #19
  mac3_a1  0.5
  set macro4 "Noise"
  mac4_d1  #20
  mac4_a1  0.4
  set macro5 "Drive"
  mac5_d1  #21
  mac5_a1  0.7
  set macro6 "Smoother"
  mac6_d1  #5
  mac6_a1  0.3
  mac6_d2  #25
  mac6_a2  -0.344
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  -0.06
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  -0.173

patch "Thick Stack" family=carrier
  # Supersaws on both oscillators, detuned against each other, with a square
  # sub an octave down: the widest, heaviest carrier the machine has.
  bands          #24
  "wave a"       #2
  "wave b"       #2
  mix            0.5
  detune         12 c
  sub            0.45
  release        0.1 s
  volume         1.19
  set macro1 "Blend"
