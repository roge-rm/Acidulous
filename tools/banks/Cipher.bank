patch "Long Tail" family=hold
  # No freeze, just a long release on every band, so each word hangs on
  # under the next one and the chords stay voiced between syllables.
  bands          #24
  attack         0.01 s
  release        1.2 s
  q              0.5
  amprel         0.8 s
  volume         0.66
  set macro1 "Longer"
  mac1_d1  #5
  mac1_a1  0.25
  set macro2 "Smear"
  mac2_d1  #6
  mac2_a1  0.5
  mac2_d2  #25
  mac2_a2  0.049
  set macro3 "Swell"
  mac3_d1  #27
  mac3_a1  0.35
  set macro4 "Tail"
  mac4_d1  #28
  mac4_a1  0.3
  set macro5 "Thicker"
  mac5_d1  #17
  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  set macro6 "Sharper"
  mac6_d1  #3
  mac6_a1  0.35
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  0.169
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.115

patch "Held Vowel" family=hold
  # Freeze on: the measured shape is held, so one vowel sustains for as long
  # as the key is down no matter what the input does afterwards. A pad made
  # out of a moment of speech.
  bands          #24
  freeze         #1
  frzmorph       0.0
  release        0.4 s
  ampatk         0.15 s
  amprel         1.5 s
  volume         0.66
  set macro1 "Longer"
  mac1_d1  #5
  mac1_a1  0.25
  mac1_d2  #25
  mac1_a2  -0.065
  set macro2 "Smear"
  mac2_d1  #6
  mac2_a1  0.5
  mac2_d2  #25
  mac2_a2  0.105
  set macro3 "Swell"
  mac3_d1  #27
  mac3_a1  0.35
  mac3_d2  #25
  mac3_a2  0.067
  set macro4 "Tail"
  mac4_d1  #28
  mac4_a1  0.3
  set macro5 "Thicker"
  mac5_d1  #17
  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  mac5_d3  #25
  mac5_a3  0.053
  set macro6 "Sharper"
  mac6_d1  #3
  mac6_a1  0.35
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  0.23
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.181

patch Morph family=hold
  # Frozen, but morphing against the live input rather than ignoring it: half
  # of the spectrum is the held vowel and half is what is arriving now, which
  # is the setting where freeze stops being a special effect and becomes
  # playable.
  bands          #24
  freeze         #1
  frzmorph       0.5
  frzdecay       6 s
  release        0.2 s
  volume         0.82
  set macro1 "Longer"
  mac1_d1  #5
  mac1_a1  0.25
  mac1_d2  #25
  mac1_a2  -0.065
  set macro2 "Smear"
  mac2_d1  #6
  mac2_a1  0.5
  mac2_d2  #25
  mac2_a2  0.066
  set macro3 "Swell"
  mac3_d1  #27
  mac3_a1  0.35
  set macro4 "Tail"
  mac4_d1  #28
  mac4_a1  0.3
  set macro5 "Thicker"
  mac5_d1  #17
  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  mac5_d3  #25
  mac5_a3  0.04
  set macro6 "Sharper"
  mac6_d1  #3
  mac6_a1  0.35
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  0.255
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.196

patch "Fading Hold" family=hold
  # Frozen, but the hold lets go over a second and a half, so a vowel
  # lingers and then the live voice comes back through.
  bands          #24
  freeze         #1
  frzmorph       0.0
  frzdecay       1.5 s
  release        0.2 s
  volume         0.82
  set macro1 "Longer"
  mac1_d1  #5
