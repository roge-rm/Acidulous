patch Ring family=carrier
  # The ring-modulated carrier: inharmonic, metallic, and the least natural of
  # the five. A vocoder's bands do not care whether what they are shaping is
  # harmonic, which is why this still reads as speech while sounding like no
  # voice at all.
  bands          #20
  "wave a"         #4
  "wave b"         #4
  mix            0.5
  detune         25 c
  release        0.07 s
  volume         1.47
  set macro1 "Blend"
  mac1_d1  #16
