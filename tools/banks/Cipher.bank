patch Narrow family=classic
  # Few bands over a narrow range. Cheap, gritty - and *more* intelligible
  # than the wide ones, not less, because speech lives in the middle and a
  # bank spread over ten octaves spends most of itself on places speech never
  # goes.
  bands          #8
  low            200 Hz
  high           4200 Hz
  q              0.65
  attack         0.002 s
  release        0.05 s
  sibilance      0.6
  volume         1.91
