patch Chipmunk family=formant
  # The synthesis bank read an octave up while the carrier stays where it is:
  # formants move, pitch does not. A small head singing the same note, which
  # is a thing no pitch shifter can do.
  bands          #20
  shift          7
  release        0.07 s
  volume         0.65
  set macro1 "Further"
  mac1_d1  #8
  mac1_a1  0.2
  mac1_d2  #25
  mac1_a2  0.208
  set macro2 "Natural"
  mac2_d1  #8
  mac2_a1  -0.292
  mac2_d2  #25
  mac2_a2  0.273
  set macro3 "Stretch"
  mac3_d1  #9
  mac3_a1  0.4
  mac3_d2  #25
  mac3_a2  0.273
  set macro4 "Smoother"
  mac4_d1  #5
  mac4_a1  0.3
  mac4_d2  #25
  mac4_a2  -0.084
  set macro5 "Sharper"
  mac5_d1  #3
  mac5_a1  0.35
  mac5_d2  #25
  mac5_a2  0.057
  set macro6 "Thicker"
  mac6_d1  #17
  mac6_a1  0.5
  mac6_d2  #19
  mac6_a2  0.3
  mac6_d3  #25
  mac6_a3  0.103
  set macro7 "Darker"
  mac7_d1  #2
  mac7_a1  -0.35
  mac7_d2  #25
  mac7_a2  0.156
  set macro8 "Octave Down"
  mac8_d1  #29
  mac8_a1  -0.5
  mac8_d2  #25
  mac8_a2  0.309

patch Giant family=formant
  # The same idea downward: a large throat, the same note. Below about a fifth
  # down it stops sounding like a bigger person and starts sounding like a
  # different instrument, which is the interesting part of the range.
  bands          #20
  shift          -7
  release        0.09 s
  sub            0.3
  volume         0.83
  set macro1 "Further"
  mac1_d1  #8
  mac1_a1  -0.2
  mac1_d2  #25
  mac1_a2  0.274
  set macro2 "Natural"
  mac2_d1  #8
  mac2_a1  0.292
