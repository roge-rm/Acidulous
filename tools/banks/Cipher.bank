patch Mirror family=remap
  # Mirrored about the middle of the bank rather than end-swapped, so the
  # centre stays put and the extremes trade. Vowels turn inside out while the
  # body of the voice stays where it was.
  bands          #20
  remap          #2
  release        0.08 s
  volume         0.98
  set macro1 "Untangle"
