  o4_ratio       3
  o4_level       0.3
  o4_decay       0.2 s
  o4_sustain     0.0
  o5_level       0
  o6_level       0
  volume         0.77
  # Morph goes to every operator into the first.
  algob          #14

patch "Tremolo Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Bright"
  set macro2 "Bell"
  set macro3 "Soft"
  set macro4 "Dark"
  set macro5 "Growl"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
