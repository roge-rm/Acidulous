patch "Morph Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Morph"
  set macro2 "Bright"
  set macro3 "Soft"
  set macro4 "Dark"
  set macro5 "Growl"
  set macro6 "Skew"
  set macro7 "Still"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #2
  mac1_a1  0.4
  mac2_d1  #5
  mac2_a1  0.3
  mac3_d1  #5
  mac3_a1  -0.2
  mac3_d2  #7
  mac3_a2  -0.2
  mac4_d1  #17
  mac4_a1  -0.5
  mac5_d1  #16
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  -0.5
  mac8_d1  #13
  mac8_a1  0.08
  # Every note starts on one long chain and morphs into three pairs as an
  # envelope falls, so the attack is a dense stack and the tail a plain
  # piano. The routing itself is the envelope.
  algoa          #6
  algob          #0
  e1_decay       0.7 s
  e1_sustain     0
  m01_src        #7
  m01_dest       #2
  m01_depth      0.7
  o1_ratio       1
  o1_level       0.85
  o1_decay       3 s
  o1_sustain     0.2
  o1_release     0.5 s
  o2_ratio       2
  o2_level       0.35
  o2_decay       1 s
  o2_sustain     0.05
  o3_ratio       1
  o3_level       0.5
  o3_decay       2.5 s
  o3_sustain     0.15
  o4_ratio       3
  o4_level       0.3
  o4_decay       0.8 s
  o4_sustain     0
  o5_ratio       1
  o5_level       0.35
  o5_decay       2 s
  o5_sustain     0.1
  o6_ratio       1
  o6_level       0.2
  o6_decay       0.5 s
  o6_sustain     0
  volume         0.54
  send reverb    0.12

patch "Phase Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Edge"
  set macro2 "Open"
  set macro3 "Dark"
  set macro4 "Res"
  set macro5 "Body"
  set macro6 "Bright"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #16
  mac1_a1  0.3
  mac2_d1  #17
  mac2_a1  0.3
  mac3_d1  #17
  mac3_a1  -0.2
  mac4_d1  #18
  mac4_a1  0.4
  mac5_d1  #6
  mac5_a1  0.3
  mac6_d1  #7
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  # A triangle with its cycle bent, so the first half is fast and the
  # second drags, which gives it an edge without a filter. A bent triangle
  # keeps no offset, where a bent sine does. Under it a plain pair, and over
  # both a low-pass that closes as the note falls.
  algoa          #6
  algob          #14
  o1_mode        #6
  o1_wave        #6
  o1_fb          0.6
  o1_ratio       1
  o1_level       0.8
  o1_decay       1.8 s
  o1_sustain     0.2
  o1_release     0.3 s
  o3_ratio       1
  o3_level       0.5
  o3_decay       2 s
  o3_sustain     0.15
  o4_ratio       1
  o4_level       0.3
  o4_decay       0.3 s
  o4_sustain     0
  f_type         #3
  f_freq         1200 Hz
  f_env          0.5
  f_decay        0.4 s
  f_sustain      0.2
  f_key          0.5
  volume         0.95
  send reverb    0.12

patch "Ring Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Ring"
