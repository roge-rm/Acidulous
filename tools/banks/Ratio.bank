  mac1_a1  0.3
  mac2_d1  #7
  mac2_a1  0.35
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #7
  mac3_a2  -0.2
  mac4_d1  #17
  mac4_a1  -0.25
  mac5_d1  #16
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #11
  mac8_a1  0.08
  # Pairs with the modulators at the unison and not much of them, under a
  # gentle low-pass. The tine with the felt left on.
  algoa          #2
  algob          #14
  o1_ratio       1
  o1_level       1.00
  o1_decay       3.5 s
  o1_sustain     0.25
  o1_release     0.6 s
  o2_ratio       1
  o2_level       0.24
  o2_decay       0.8 s
  o2_sustain     0.05
  o2_vel         0.9
  o3_ratio       2
  o3_level       0.22
  o3_decay       2 s
  o3_sustain     0.1
  o4_ratio       1
  o4_level       0.15
  o4_decay       0.4 s
  o4_sustain     0
  f_type         #1
  f_freq         2500 Hz
  f_key          0.5
  volume         0.87
  insert Chorus
    voices       #1
    rate         #14
    depth        0.35
    spread       0.9
    drift        0.1
    mix          0.35
  send reverb    0.12

patch "Stage Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Bright"
  set macro2 "Bell"
  set macro3 "Soft"
  set macro4 "Dark"
  set macro5 "Growl"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Metal"
