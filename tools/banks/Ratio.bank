patch "Skewed Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Dark"
  set macro3 "Bloom"
  set macro4 "Shimmer"
  set macro5 "Skew"
  set macro6 "Morph"
  set macro7 "Metal"
  set macro8 "Drift"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.2
  mac2_d1  #17
  mac2_a1  -0.5
  mac3_d1  #6
  mac3_a1  0.15
  mac4_d1  #8
  mac4_a1  0.25
  mac5_d1  #3
  mac5_a1  0.15
  mac6_d1  #2
  mac6_a1  0.5
  mac7_d1  #11
  mac7_a1  0.1
  mac8_d1  #11
  mac8_a1  0.005
  algob          #6
  # The skew control pulls every ratio off its whole number by the same
  # amount, so the partials fan apart as they go up. A stretched harmonic
  # series, which is what a piano has and no oscillator does.
  algoa          #22
  skew           0.28
  snap           #0
  o1_ratio       1
  o1_level       0.94
  o1_attack      0.9 s
  o1_decay       5 s
  o1_sustain     0.85
  o1_release     2.5 s
