patch "Wide Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Bright"
  set macro2 "Bell"
  set macro3 "Soft"
  set macro4 "Dark"
  set macro5 "Growl"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
