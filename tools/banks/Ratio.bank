patch "Wide Bass FM" family=bass  note=36 range=24..55 role=bass
  set macro1 "Bright"
  set macro2 "Open"
  set macro3 "Dark"
  set macro4 "Res"
  set macro5 "Growl"
  set macro6 "Metal"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.3
  mac1_d2  #7
  mac1_a2  0.3
  mac2_d1  #17
  mac2_a1  0.4
  mac3_d1  #17
  mac3_a1  -0.4
  mac4_d1  #18
  mac4_a1  0.5
  mac5_d1  #16
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  0.08
  mac6_d2  #13
  mac6_a2  0.08
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  mac8_d2  #19
  mac8_a2  0.421
  # Two carriers a few cents apart panned hard, which on a bass is usually
  # a mistake and here is not, because the filter keeps the beating under
  # the note.
  #
  # Both modulators were at a fifth of their carriers, which is barely any
  # index at all: the patch was two detuned sines with four per cent of its
  # energy above a hundred and fifty hertz, so on anything without real bass
  # extension there was nothing to hear. Dan reported it as quiet and it was
  # not quiet, it was empty.
  algoa          #6
  o1_ratio       1
  o1_fine        -7
  o1_pan         -0.6
  o1_level       0.8
  o1_decay       1.4 s
  o1_sustain     0.6
  o2_ratio       2
  o2_level       0.5
  o2_decay       0.5 s
  o2_sustain     0.1
  o3_ratio       1
  o3_fine        7
  o3_pan         0.6
  o3_level       0.8
  o3_decay       1.4 s
  o3_sustain     0.6
  o4_ratio       2
  o4_level       0.5
  o4_decay       0.5 s
  o4_sustain     0.1
  o5_level       0
  o6_level       0
  f_type         #3
  f_freq         1500 Hz
  volume         0.72
  # Morph goes to every operator into the first.
  algob          #14

patch "Hollow Bass" family=bass  note=36 range=24..55 role=bass
  set macro1 "Bright"
  set macro2 "Dark"
  set macro3 "Open"
  set macro4 "Growl"
  set macro5 "Body"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Soft"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.3
  mac2_d1  #17
  mac2_a1  -0.4
  mac3_d1  #17
  mac3_a1  0.4
  mac4_d1  #16
  mac4_a1  0.25
  mac5_d1  #6
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #5
  mac8_a1  -0.3
  # A modulator at twice the carrier puts every sideband on an odd harmonic,
  # so the bass is hollow like a square with none of a square's buzz.
  algoa          #2
  algob          #14
  o1_ratio       1
  o1_level       1.00
  o1_decay       1.5 s
  o1_sustain     0.7
  o1_release     0.12 s
  o2_ratio       2
  o2_level       0.45
  o2_decay       0.7 s
  o2_sustain     0.3
  o2_vel         0.7
  o3_ratio       3
  o3_level       0.2
  o3_decay       1 s
  o3_sustain     0.5
  o4_ratio       2
  o4_level       0.2
  o4_decay       0.5 s
  o4_sustain     0.2
  f_type         #3
  f_freq         1500 Hz
  f_key          0.3
  voicemode      #1
  volume         0.84

# Starts at 30: below that the fixed modulator is *above* the note and its
# sidebands stop being harmonics of anything, which reads a hundred cents
# out even though the note is still the loudest thing there.
patch "Sub Drop FM" family=bass  note=36 range=30..55 role=bass
  set macro1 "Bright"
  set macro2 "Open"
  set macro3 "Dark"
  set macro4 "Res"
  set macro5 "Sub"
  set macro6 "Growl"
  set macro7 "Skew"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #6
  mac1_a1  0.3
  mac2_d1  #17
  mac2_a1  0.4
  mac3_d1  #17
  mac3_a1  -0.3
  mac4_d1  #18
  mac4_a1  0.5
  mac5_d1  #5
  mac5_a1  0.3
  mac6_d1  #16
  mac6_a1  0.35
  mac7_d1  #3
  mac7_a1  0.2
  mac8_d1  #12
  mac8_a1  0.1
  # A second carrier fixed at fifty hertz under one that tracks the keyboard,
  # so every note has the same rumble beneath it however high it is played.
  # Fixed ratios are the other half of what this machine can do.
  #
  # **A fixed operator's ratio is in units of 55 Hz, not hertz.** Written as
  # 50 it was not fifty hertz, it was two thousand seven hundred and fifty,
  # and the patch called Sub Drop had a centroid of nearly three kilohertz.
  # 0.91 is fifty. It was wrong twice before that as well - once with the
  # fixed operator as the carrier, so it played the same pitch whatever key
  # was held, and once with it modulating a carrier a tone below it, which
  # throws sidebands everywhere.
  algoa          #22
  o1_ratio       1
  o1_level       0.9
  o1_decay       2 s
  o1_sustain     0.55
  o2_fixed       1
  o2_ratio       0.91
  o2_level       0.5
  o2_decay       2 s
  o2_sustain     0.5
  o3_ratio       2
  o3_level       0.12
  o3_decay       0.6 s
  o3_sustain     0.15
  o4_level       0
  o5_level       0
  o6_level       0
  f_type         #3
  f_freq         600 Hz
  volume         1.000
  m01_src        #1
  m01_dest       #19
  m01_depth      0.778

patch "Growl FM" family=bass  note=36 range=24..55 role=bass
  set macro1 "Growl"
  set macro2 "Bright"
  set macro3 "Open"
  set macro4 "Dark"
  set macro5 "Res"
  set macro6 "Bite"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #16
  mac1_a1  0.15
  mac2_d1  #5
  mac2_a1  0.3
  mac3_d1  #17
  mac3_a1  0.4
  mac4_d1  #17
  mac4_a1  -0.3
  mac5_d1  #18
  mac5_a1  0.5
  mac6_d1  #7
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  # Feedback on a *modulator*, which is the one way to get a saw out of a
  # sine, driven hard into a carrier on the same note. Dirty and entirely
  # harmonic - every sideband of a unison modulator lands on a harmonic.
  #
  # Written first on the algorithm where all six operators are carriers,
  # which means nothing modulates anything: it was two sines an octave apart
  # with a low-pass on them, it had no growl in it at all, and Dan reported
  # it as too quiet to really hear. It was not quiet, it was empty.
  algoa          #6
  o1_ratio       1
  o1_level       0.95
  o1_decay       1.5 s
  o1_sustain     0.75
  o2_ratio       1
  o2_fb          0.85
  o2_level       0.6
  o2_decay       1.2 s
  o2_sustain     0.55
  o3_ratio       0.5
  o3_level       0.5
  o3_decay       1.5 s
  o3_sustain     0.6
  o4_ratio       2
  o4_level       0.3
  o4_decay       0.6 s
  o4_sustain     0.25
  o5_level       0
  o6_level       0
  f_type         #3
  f_freq         1600 Hz
  f_res          0.2
  volume         1.000
  m01_src        #1
  m01_dest       #19
  m01_depth      0.303

  # Morph goes to every operator into the first.
  algob          #14

patch Squelch family=bass  note=36 range=24..55 role=bass
  set macro1 "Open"
  set macro2 "Dark"
  set macro3 "Res"
  set macro4 "Growl"
  set macro5 "Env"
  set macro6 "Bite"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #17
  mac1_a1  0.3
  mac2_d1  #17
  mac2_a1  -0.3
  mac3_d1  #18
  mac3_a1  0.25
  mac4_d1  #16
  mac4_a1  0.15
  mac5_d1  #17
  mac5_a1  0.15
  mac5_d2  #18
  mac5_a2  0.1
  mac6_d1  #5
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  # Feedback on the carrier turns its sine into a saw, and a resonant
  # low-pass with a fast envelope does the rest. Legato with a short slide,
  # into a little drive.
  algoa          #0
  algob          #14
  voicemode      #2
  glide          0.06 s
  o1_ratio       1
  o1_fb          0.7
  o1_level       1.00
  o1_decay       0.4 s
  o1_sustain     0.5
  o1_attack      0.012 s
  o1_release     0.08 s
  o2_ratio       1
  o2_level       0
  f_type         #3
  f_freq         420 Hz
  f_res          0.7
  f_env          0.7
  f_decay        0.22 s
  f_sustain      0
  f_key          0.3
  m01_src        #4
  m01_dest       #17
  m01_depth      0.2
  volume         0.96
  insert Distortion
    drive        6
    tone         5000 Hz
    mix          0.6
    gain         -3.5 dB

