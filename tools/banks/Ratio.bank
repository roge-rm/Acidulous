  o3_sustain     0
  o4_ratio       2
  o4_level       0.45
  o4_decay       1.2 s
  o4_sustain     0
  o4_release     0.1 s
  o5_ratio       1
  o5_level       0.35
  o5_decay       0.6 s
  o5_sustain     0
  o6_ratio       5
  o6_level       0.2
  o6_decay       0.1 s
