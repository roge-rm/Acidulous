  mac6_a1  0.25
  mac7_d1  #6
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  -0.3
  # The ring mode rather than frequency modulation: two operators
  # multiplied together, which produces sum and difference and nothing
  # else. Nothing in it is a harmonic of the note.
  algoa          #6
  o1_ratio       1
  o1_level       0.85
  o1_decay       2.5 s
  o1_sustain     0.0
