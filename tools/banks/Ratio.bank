  mac5_d1  #5
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #6
  mac8_a1  -0.3
  # Two carriers with feedback, which makes each a saw, a few cents apart
  # under a low-pass. Legato, with eighth-note echoes.
  algoa          #6
  algob          #14
  voicemode      #2
  glide          0.04 s
  o1_ratio       1
  o1_fine        -3
  o1_fb          0.75
  o1_level       0.85
  o1_decay       2 s
