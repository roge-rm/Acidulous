  mac1_a1  0.3
  mac2_d1  #5
  mac2_a1  0.3
  mac3_d1  #17
  mac3_a1  -0.4
  mac4_d1  #17
  mac4_a1  0.3
  mac5_d1  #6
  mac5_a1  0.3
  mac6_d1  #18
  mac6_a1  0.4
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  # A sine pushed through a wavefolder. An envelope on the sine's level
  # drives it hard at the start and lets it relax, so the note opens with a
  # bark and settles to a rounder fold.
