  o4_ratio       6.3
  o4_level       0.5
  o4_decay       1 s
  o4_sustain     0.0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.86
  # Morph goes to one chain, where the ring operators have something to multiply.
  algob          #0
  # Silent until a macro reaches them: a short pair at two
  # ratios off the note.
  o5_ratio       2.7
  o5_decay       0.6 s
  o5_sustain     0
  o6_ratio       5.3
  o6_decay       0.3 s
  o6_sustain     0

