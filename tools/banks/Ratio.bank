patch Upright family=keys  note=60 range=36..84 role=keys
  set macro1 "Bright"
  set macro2 "Hammer"
  set macro3 "Soft"
  set macro4 "Dark"
  set macro5 "Stretch"
  set macro6 "Growl"
  set macro7 "Morph"
  set macro8 "Bell"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.3
  mac2_d1  #9
  mac2_a1  0.3
  mac3_d1  #5
  mac3_a1  -0.25
  mac3_d2  #7
  mac3_a2  -0.15
  mac4_d1  #17
  mac4_a1  -0.5
  mac5_d1  #3
  mac5_a1  0.03
  mac6_d1  #16
  mac6_a1  0.25
  mac7_d1  #2
  mac7_a1  0.5
  mac7_d2  #19
  mac7_a2  -0.265
  mac8_d1  #7
  mac8_a1  0.3
  # A piano from three pairs, the brightness falling away faster than the
  # note and faster again up the keyboard. A touch of skew stretches the
  # upper partials sharp, the way a stiff string does.
  algoa          #6
  algob          #0
  skew           0.005
  o1_ratio       1
  o1_level       1.00
  o1_decay       4 s
  o1_sustain     0
  o1_release     0.4 s
  o1_key         -0.2
  o2_ratio       1
  o2_level       0.4
  o2_decay       1 s
  o2_sustain     0
  o2_vel         0.8
  o2_key         -0.3
  o3_ratio       2
  o3_level       0.5
  o3_decay       2.5 s
  o3_sustain     0
  o3_release     0.4 s
  o4_ratio       1
  o4_level       0.25
  o4_decay       0.5 s
  o4_sustain     0
  o4_vel         0.9
  o5_ratio       3
  o5_level       0.2
  o5_decay       1.5 s
  o5_sustain     0
  o6_ratio       15
  o6_level       0.15
  o6_decay       0.03 s
  o6_sustain     0
  volume         0.86
  send reverb    0.15

patch "Reed Keys" family=keys  note=60 range=36..84 role=keys
