patch "Ring Pluck" family=pluck  note=60 range=40..84 role=arp
  set macro1 "Bright"
  set macro2 "Bite"
  set macro3 "Soft"
  set macro4 "Dark"
  set macro5 "Growl"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.3
  mac2_d1  #7
  mac2_a1  0.3
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #7
  mac3_a2  -0.2
  mac4_d1  #17
  mac4_a1  -0.5
  mac5_d1  #16
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #11
  mac8_a1  0.08
  # Both carriers in ring mode: each is its own sine multiplied by the
  # operator above it, which leaves only the sum and the difference. At
  # two and three over the note they land on the series, hollow and hard.
  algoa          #6
  algob          #0
  o1_mode        #1
  o1_ratio       1
  o1_level       1.00
  o1_decay       1 s
  o1_sustain     0
  o1_release     0.3 s
  o2_ratio       2
  o2_level       1.00
  o2_decay       0.4 s
  o2_sustain     0
  o3_mode        #1
  o3_ratio       1
  o3_level       0.6
  o3_decay       0.8 s
  o3_sustain     0
  o3_release     0.3 s
  o4_ratio       3
  o4_level       0.8
  o4_decay       0.25 s
  o4_sustain     0
  o5_ratio       1
  o5_level       0.6
  o5_decay       1 s
  o5_sustain     0
  volume         1.000
  send reverb    0.12

