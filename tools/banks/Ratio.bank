patch "Fold Bass" family=bass  note=36 range=24..55 role=bass
  set macro1 "Fold"
  set macro2 "Drive"
  set macro3 "Dark"
  set macro4 "Open"
  set macro5 "Sub"
  set macro6 "Res"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
