patch Slap  note=36 range=24..55 role=bass
  # The modulator is loud for sixty milliseconds and then gone, which is
  # the click of a thumb and nothing more. Under it the note is a sine.
  algoa          #6
  o1_ratio       1
  o1_level       0.9
  o1_decay       1.2 s
  o1_sustain     0.3
  o2_ratio       5
  o2_level       0.7
  o2_decay       0.06 s
  o2_sustain     0.0
  o2_vel         0.9
  o3_ratio       1
  o3_level       0.4
  o3_decay       0.9 s
  o3_sustain     0.2
  o4_level       0
  o5_level       0
  o6_level       0
  volume         0.89

patch "Growl FM"  note=36 range=24..55 role=bass
  # Feedback on the carrier itself, which is the one way to get a saw out
  # of a sine without a second operator. Dirty and entirely harmonic.
  algoa          #22
  o1_ratio       1
  o1_fb          0.7
  o1_level       0.9
  o1_decay       1.5 s
  o1_sustain     0.7
  o2_ratio       0.5
  o2_level       0.35
  o2_decay       1.5 s
  o2_sustain     0.6
  o3_level       0
  o4_level       0
  o5_level       0
  o6_level       0
  f_type         #3
  f_freq         900 Hz
  f_res          0.2
  volume         1.00

# Starts at 30: below that the fixed modulator is *above* the note and its
# sidebands stop being harmonics of anything, which reads a hundred cents
# out even though the note is still the loudest thing there.
patch "Sub Drop FM"  note=36 range=30..55 role=bass
  # A modulator fixed at fifty hertz rather than following the keyboard, so
  # every note gets the same rumble under it however high it is played.
  # Written with the *carrier* fixed instead, the patch played fifty hertz
  # whatever key you pressed, which is not an instrument.
  algoa          #6
  o1_ratio       1
  o1_level       0.95
  o1_decay       2 s
  o1_sustain     0.5
  o2_fixed       1
  o2_ratio       50
  o2_level       0.3
  o2_decay       0.8 s
  o2_sustain     0.2
  o3_level       0
  o4_level       0
  o5_level       0
  o6_level       0
  volume         1.00

patch "Metal Bass"  note=36 range=24..55 role=bass
  # A ratio of three and a half, which is not a harmonic of anything, kept
  # quiet enough to be a colour on a bass rather than a bell.
  algoa          #6
  o1_ratio       1
  o1_level       0.9
  o1_decay       1.2 s
  o1_sustain     0.5
  o2_ratio       3.5
  o2_level       0.28
  o2_decay       0.5 s
  o2_sustain     0.1
  o3_ratio       1
  o3_level       0.35
  o3_decay       1 s
  o3_sustain     0.4
  o4_level       0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.86

patch "Pluck Bass FM"  note=36 range=24..55 role=bass
  # Short, with the filter closing faster than the amplitude so the note
  # goes dull before it goes quiet.
  algoa          #5
  o1_ratio       1
  o1_level       1.00
  o1_decay       0.6 s
  o1_sustain     0.1
  o2_ratio       2
  o2_level       0.86
  o2_decay       0.15 s
  o2_sustain     0.0
  o3_ratio       4
  o3_level       0.52
  o3_decay       0.08 s
  o3_sustain     0.0
  o4_level       0.00
  o5_level       0.00
  o6_level       0.00
  f_type         #3
  f_freq         700 Hz
  f_env          0.6
  f_decay        0.15 s
  f_sustain      0.0
  volume         1.00

patch "Wide Bass FM"  note=36 range=24..55 role=bass
  # Two carriers a few cents apart panned hard, which on a bass is usually
  # a mistake and here is not, because the filter keeps the beating under
  # the note.
  algoa          #6
  o1_ratio       1
  o1_fine        -7
  o1_pan         -0.6
  o1_level       0.8
  o1_decay       1.4 s
