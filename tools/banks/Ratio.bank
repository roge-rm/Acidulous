  mac6_d1  #16
  mac6_a1  0.2
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  # A ring-modulated pair: the note times its own octave, which leaves the
  # note and the twelfth and nothing between. Hollow and glassy, with a
  # plain pair under it to hold the pitch.
  algoa          #6
  algob          #14
  o1_mode        #1
  o1_ratio       1
  o1_level       0.9
  o1_decay       2.5 s
  o1_sustain     0.2
  o1_release     0.5 s
  o2_ratio       2
  o2_level       0.8
  o2_decay       1.5 s
  o2_sustain     0.2
  o3_ratio       1
  o3_level       0.4
  o3_decay       2 s
  o3_sustain     0.15
  o4_ratio       3
  o4_level       0.15
  o4_decay       0.3 s
  o4_sustain     0
  volume         0.97
  send reverb    0.15

