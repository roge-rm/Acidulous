patch "Morph Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Morph"
  set macro2 "Bright"
  set macro3 "Dark"
  set macro4 "Growl"
  set macro5 "Speed"
  set macro6 "Res"
  set macro7 "Skew"
  set macro8 "Still"
