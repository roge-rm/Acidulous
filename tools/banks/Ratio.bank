patch "Morph Pad"  note=55 range=36..79 role=pad
  # Built to be moved: algorithm A is three pairs and algorithm B is all
  # six as carriers, and the morph between them takes the patch from a
  # modulated sound to an additive one without changing a note.
  algoa          #6
