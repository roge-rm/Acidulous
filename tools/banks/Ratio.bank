patch Drawbars family=reed  note=60 range=36..84 role=keys
  set macro1 "Bright"
  set macro2 "Full"
  set macro3 "Thin"
  set macro4 "Dark"
  set macro5 "Drive"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #8
  mac1_a1  0.25
  mac1_d2  #9
  mac1_a2  0.25
  mac2_d1  #6
  mac2_a1  0.2
  mac2_d2  #7
  mac2_a2  0.25
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  -0.2
  mac4_d1  #17
  mac4_a1  -0.45
  mac5_d1  #16
  mac5_a1  0.2
  mac6_d1  #3
  mac6_a1  0.08
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #15
  mac8_a1  0.05
  # All six operators as carriers at the octave, the fifth, the double
  # octave and so on, which is exactly what an organ's drawbars are. No
  # modulation anywhere.
  algoa          #22
  o1_ratio       1
  o1_level       0.8
  o1_sustain     1
  o1_decay       8 s
  o2_ratio       2
  o2_level       0.55
  o2_sustain     1
  o2_decay       8 s
  o3_ratio       3
  o3_level       0.4
  o3_sustain     1
  o3_decay       8 s
  o4_ratio       4
  o4_level       0.3
  o4_sustain     1
  o4_decay       8 s
  o5_ratio       6
  o5_level       0.2
  o5_sustain     1
  o5_decay       8 s
  o6_ratio       8
  o6_level       0.15
  o6_sustain     1
  o6_decay       8 s
  o1_attack      0.01 s
  volume         0.99
  # Morph goes to three pairs, each drawbar modulating the one below.
  algob          #6

patch "Percussive Organ" family=reed  note=60 range=36..84 role=keys
  set macro1 "Click"
  set macro2 "Bright"
  set macro3 "Full"
  set macro4 "Thin"
  set macro5 "Dark"
  set macro6 "Drive"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #6
  mac1_a1  0.3
  mac1_d2  #7
  mac1_a2  0.3
  mac2_d1  #8
  mac2_a1  0.25
  mac2_d2  #9
  mac2_a2  0.2
  mac3_d1  #5
  mac3_a1  0.2
  mac4_d1  #4
  mac4_a1  -0.3
  mac5_d1  #17
  mac5_a1  -0.45
  mac6_d1  #16
  mac6_a1  0.2
  mac7_d1  #3
  mac7_a1  0.08
  mac8_d1  #2
  mac8_a1  0.5
  # The same drawbars with the top two given a fast decay, which is the
  # key click an organ makes and the reason it sounds played rather than
  # switched on.
  algoa          #22
  o1_ratio       1
  o1_level       0.96
  o1_sustain     1
  o1_decay       8 s
  o2_ratio       2
  o2_level       0.60
  o2_sustain     1
  o2_decay       8 s
  o3_ratio       3
  o3_level       0.54
  o3_decay       0.25 s
  o3_sustain     0.0
  o4_ratio       4
  o4_level       0.42
  o4_decay       0.18 s
  o4_sustain     0.0
  o5_level       0.00
  o6_level       0.00
  volume         1.00
  # Morph goes to three pairs.
  algob          #6
  # Silent until a macro reaches them: the two top drawbars.
  o5_ratio       6
  o5_sustain     1
  o5_decay       8 s
  o6_ratio       8
  o6_sustain     1
  o6_decay       8 s

