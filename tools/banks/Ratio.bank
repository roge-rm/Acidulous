  mac4_d1  #17
  mac4_a1  -0.5
  mac5_d1  #16
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #11
  mac8_a1  0.08
  # A reedy piano: a triangle modulator at the unison barks when it is hit
  # hard, and a tremolo pans it from side to side.
  algoa          #6
  algob          #14
  o1_ratio       1
  o1_level       0.9
  o1_decay       2.5 s
  o1_sustain     0.3
  o1_release     0.4 s
