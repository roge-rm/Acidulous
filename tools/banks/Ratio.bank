  o3_sustain     0.2
  o4_ratio       3
  o4_level       0.25
  o4_decay       0.3 s
  o4_sustain     0
  o4_vel         0.9
  volume         0.8
  insert Tremolo
    rate         #8
    depth        0.35
    pan          1
    mix          1
  send reverb    0.1

patch "Thump Keys" family=keys  note=60 range=36..84 role=keys
  set macro1 "Bright"
