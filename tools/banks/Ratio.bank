  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #11
  mac8_a1  0.08
  # Three pairs: a bright tine in the middle and two plain ones a few cents
  # either side of it, then a chorus. The bright ballad piano.
  algoa          #6
  algob          #14
  o1_ratio       1
  o1_level       0.85
  o1_decay       2.8 s
  o1_sustain     0.2
