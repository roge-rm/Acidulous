  # Silent until a macro reaches it: the operator that feeds the two
  # crushers.
  o4_ratio       2
  # The crush mode on two operators at once, which quantises the phase
  # rather than the amplitude and is therefore an aliasing effect with a
  # pitch. Not subtle.
