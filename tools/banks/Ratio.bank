patch "Ring Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Ring"
  set macro2 "Metal"
  set macro3 "Dark"
  set macro4 "Body"
  set macro5 "Growl"
  set macro6 "Soft"
  set macro7 "Skew"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.3
  mac2_d1  #11
  mac2_a1  0.06
  mac3_d1  #17
  mac3_a1  -0.4
  mac4_d1  #6
  mac4_a1  0.3
  mac5_d1  #16
  mac5_a1  0.2
  mac6_d1  #5
  mac6_a1  -0.4
  mac7_d1  #3
  mac7_a1  0.15
  mac8_d1  #2
  mac8_a1  0.5
  # A ring-modulated pair over a plain one. The ring pair gives the note and
  # the twelfth, and a slow LFO nudges the ring operator's ratio so they
  # shimmer against the pair under them.
  algoa          #6
  algob          #14
  voicemode      #2
  glide          0.04 s
  o1_mode        #1
  o1_ratio       1
  o1_level       0.7
  o1_decay       2 s
  o1_sustain     0.85
  o1_release     0.2 s
  o2_ratio       2
  o2_level       0.6
  o2_sustain     0.8
  o3_ratio       1
  o3_level       0.8
  o3_sustain     0.85
  o3_release     0.2 s
  o4_ratio       1
  o4_level       0.25
  o4_sustain     0.6
  l1_rate        0.5 Hz
  m01_src        #11
  m01_dest       #11
  m01_depth      0.005
  volume         1.00
  insert Delay
    time         #2
    feedback     0.3
    tone         5000 Hz
    mode         #1
    mix          0.2

patch "Stretch Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Stretch"
  set macro2 "Bright"
  set macro3 "Dark"
  set macro4 "Growl"
  set macro5 "Body"
  set macro6 "Soft"
  set macro7 "Squash"
  set macro8 "Morph"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #3
  mac1_a1  0.05
  mac2_d1  #5
  mac2_a1  0.2
  mac3_d1  #17
  mac3_a1  -0.4
  mac4_d1  #16
  mac4_a1  0.2
  mac5_d1  #6
  mac5_a1  0.3
  mac6_d1  #5
  mac6_a1  -0.2
  mac6_d2  #7
  mac6_a2  -0.15
  mac7_d1  #3
  mac7_a1  -0.1
  mac8_d1  #2
  mac8_a1  0.5
  # Snap off and the partials skewed apart, so every modulator sits a
  # little above its harmonic and the partials run sharp as they climb. The
  # carriers stay at one, so it still plays the note; pressure stretches
  # it further.
  algoa          #6
  algob          #14
  snap           #0
  skew           0.02
  voicemode      #2
  glide          0.04 s
  m02_src        #3
  m02_dest       #3
  m02_depth      0.1
  o1_ratio       1
  o1_level       0.9
  o1_decay       2 s
  o1_sustain     0.85
  o1_release     0.2 s
  o2_ratio       3
  o2_level       0.3
  o2_sustain     0.5
  o3_ratio       1
  o3_level       0.5
  o3_sustain     0.85
  o3_release     0.2 s
  o4_ratio       4
  o4_level       0.2
  o4_sustain     0.5
  volume         0.57
  insert Delay
    time         #2
    feedback     0.3
    tone         5000 Hz
    mode         #1
    mix          0.2
  send reverb    0.12

