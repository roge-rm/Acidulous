patch "Sync Bass" family=bass  note=36 range=24..55 role=bass
  set macro1 "Sync"
  set macro2 "Low"
  set macro3 "Dark"
  set macro4 "Open"
  set macro5 "Body"
  set macro6 "Res"
  set macro7 "Skew"
  set macro8 "Morph"
