patch "Ring Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Dark"
  set macro3 "Body"
  set macro4 "Ring"
  set macro5 "Skew"
  set macro6 "Morph"
  set macro7 "Metal"
  set macro8 "Drift"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #17
  mac1_a1  0.3
  mac2_d1  #17
  mac2_a1  -0.5
  mac2_d2  #19
  mac2_a2  0.257
  mac3_d1  #6
  mac3_a1  0.3
  mac4_d1  #8
  mac4_a1  0.3
  mac5_d1  #3
  mac5_a1  0.12
  mac6_d1  #2
  mac6_a1  0.4
  mac6_d2  #19
  mac6_a2  0.144
  mac7_d1  #11
  mac7_a1  0.1
  mac8_d1  #15
  mac8_a1  0.01
  # Two carriers in ring mode, each its own sine times the operator above
  # it. One is on twice the note and one a hair off three times it, so the
  # upper sum and difference drift against the lower. Ratios are free, and
  # a plain sine underneath keeps the note.
  algoa          #6
  algob          #22
  snap           #0
  o1_mode        #1
  o1_ratio       1
  o1_level       0.7
  o1_attack      0.4 s
  o1_decay       5 s
  o1_sustain     0.85
  o1_release     2.5 s
  o2_ratio       2
  o2_level       1.00
  o2_attack      0.4 s
  o2_decay       5 s
  o2_sustain     0.9
  o3_ratio       1
  o3_level       0.45
  o3_attack      0.5 s
  o3_decay       5 s
  o3_sustain     0.85
  o3_release     2.5 s
  o4_ratio       2
  o4_level       0.08
  o5_mode        #1
  o5_ratio       1
  o5_level       0.4
  o5_attack      0.6 s
  o5_decay       5 s
  o5_sustain     0.85
  o5_release     2.5 s
  o6_ratio       3.012
  o6_level       1.00
  o6_attack      0.6 s
  o6_decay       5 s
  o6_sustain     0.9
  f_type         #1
  f_freq         3500 Hz
  f_key          0.3
  volume         0.617
  insert Delay
    time         #3
    feedback     0.35
    tone         4000 Hz
    mode         #1
    mix          0.2
  send reverb    0.18

