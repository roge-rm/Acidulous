  mac7_a1  0.5
  mac7_d2  #19
  mac7_a2  0.519
  mac8_d1  #13
  mac8_a1  0.08
  # Four modulators into one sine, all on the harmonic series, then skew
  # pulls them apart. The carrier stays on the note and everything over it
  # goes sharp the higher it is, a string far stiffer than any real one.
  algoa          #14
  algob          #22
  skew           0.12
  o1_ratio       1
  o1_level       1.00
  o1_decay       1.5 s
