patch Tubular family=bell  note=60 range=36..84 role=bell
  set macro1 "Strike"
  set macro2 "Metal"
  set macro3 "Bright"
  set macro4 "Dark"
  set macro5 "Skew"
  set macro6 "Morph"
  set macro7 "Wobble"
  set macro8 "Thin"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.2
  mac1_d2  #6
  mac1_a2  0.15
  mac2_d1  #11
  mac2_a1  0.05
  mac2_d2  #13
  mac2_a2  0.05
  mac3_d1  #7
  mac3_a1  0.2
  mac3_d2  #8
  mac3_a2  0.2
  mac4_d1  #17
  mac4_a1  -0.5
  mac4_d2  #19
  mac4_a2  0.287
  mac5_d1  #3
  mac5_a1  0.2
  mac6_d1  #2
  mac6_a1  0.5
  mac6_d2  #19
  mac6_a2  0.454
  mac7_d1  #16
  mac7_a1  0.35
  mac8_d1  #5
  mac8_a1  -0.2
  mac8_d2  #6
  mac8_a2  -0.15
  # Five modulators into one carrier, all at ratios that share no factors.
  # This is the algorithm this kind of synthesis is famous for and the one
  # no subtractive synth can imitate.
  algoa          #14
  o1_ratio       1
  o1_level       0.9
  o1_decay       8 s
  o1_sustain     0.0
  o1_release     4 s
  o2_ratio       3.5
  o2_level       0.22
  o2_decay       4 s
  o2_sustain     0.0
  o3_ratio       5
  o3_level       0.16
  o3_decay       3 s
  o3_sustain     0.0
  o4_ratio       7
  o4_level       0.12
  o4_decay       2 s
  o4_sustain     0.0
  o5_ratio       11
  o5_level       0.08
  o5_decay       1.2 s
  o5_sustain     0.0
  o6_level       0
  snap           #0
  volume         0.54
  # Morph goes to all six heard, so the modulators ring as partials.
  algob          #22

