  o6_level       0
  volume         0.95

patch "Skewed Pad"  note=55 range=36..79 role=pad
  # The skew control pulls every ratio off its whole number by the same
  # amount, so the partials fan apart as they go up. A stretched harmonic
  # series, which is what a piano has and no oscillator does.
  algoa          #22
  skew           0.28
  snap           #0
  o1_ratio       1
  o1_level       0.94
