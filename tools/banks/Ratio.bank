patch Ice family=bell  note=67 range=48..88 role=bell
  set macro1 "Strike"
  set macro2 "Metal"
  set macro3 "Shimmer"
  set macro4 "Body"
  set macro5 "Skew"
  set macro6 "Morph"
  set macro7 "Wobble"
  set macro8 "Thin"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.25
  mac2_d1  #11
  mac2_a1  0.05
  mac3_d1  #12
  mac3_a1  0.004
  mac4_d1  #17
  mac4_a1  -0.4
  mac5_d1  #3
  mac5_a1  0.2
  mac6_d1  #2
  mac6_a1  0.5
  mac7_d1  #16
  mac7_a1  0.35
  mac8_d1  #5
  mac8_a1  -0.12
  mac8_d2  #19
  mac8_a2  0.325
  # Thin, very high, and almost no low end - but on the note. The carrier
  # was written at four times the ratio, so the patch played two octaves
  # above the key; the height comes from the modulators and the high-pass
  # instead, which is where it should have come from.
  algoa          #6
  o1_ratio       1
  o1_level       1.00
  o1_decay       4 s
  o1_sustain     0.0
  o2_ratio       9
  o2_level       0.26
  o2_decay       2 s
  o2_sustain     0.0
  o3_ratio       4
  o3_level       0.46
  o3_decay       3 s
  o3_sustain     0.0
  o4_level       0.00
  o5_level       0.00
  o6_level       0.00
  # The high-pass follows the keyboard, and the range starts where a thing
  # called Ice belongs anyway. Fixed at 700 Hz it removed the note itself
  # over the bottom octave and the tenth harmonic was the loudest thing in
  # it.
  f_type         #5
  f_freq         500 Hz
  f_key          0.8
  volume         0.73
  # Morph goes to every operator into the first.
  algob          #14

