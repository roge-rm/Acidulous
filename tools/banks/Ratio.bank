  o6_level       0.00
  volume         1.00

patch "Struck Glass"  note=60 range=36..84 role=bell
  # Two modulators at a seventh and a thirteenth of the carrier, so every
  # partial lands between two notes of the scale. It rings for a long time
  # and never settles on a pitch.
  algoa          #6
  o1_ratio       1
  o1_level       0.85
  o1_decay       6 s
  o1_sustain     0.0
  o1_release     3 s
  o2_ratio       7
  o2_level       0.3
  o2_decay       3 s
  o2_sustain     0.0
  o3_ratio       1
  o3_level       0.4
  o3_decay       5 s
  o3_sustain     0.0
  o4_ratio       13
  o4_level       0.18
  o4_decay       2 s
  o4_sustain     0.0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.86

patch Plucked  note=55 range=40..79 role=arp
  # Everything short. The point is the envelope rather than the spectrum:
  # an FM stack with a fast decay is a plucked string and nobody has to
  # model one.
  algoa          #5
  o1_ratio       1
  o1_level       1.00
  o1_decay       0.9 s
  o1_sustain     0.0
  o1_release     0.3 s
  o2_ratio       2
  o2_level       0.52
  o2_decay       0.25 s
  o2_sustain     0.0
  o3_ratio       5
  o3_level       0.34
  o3_decay       0.12 s
  o3_sustain     0.0
  o4_level       0.00
  o5_level       0.00
  o6_level       0.00
  volume         1.00

patch Tubular  note=60 range=36..84 role=bell
  # Five modulators into one carrier, all at ratios that share no factors.
  # This is the algorithm this kind of synthesis is famous for and the one
  # no subtractive synth can imitate.
  algoa          #14
  o1_ratio       1
  o1_level       0.9
  o1_decay       8 s
  o1_sustain     0.0
  o1_release     4 s
  o2_ratio       3.5
  o2_level       0.22
  o2_decay       4 s
  o2_sustain     0.0
  o3_ratio       5
  o3_level       0.16
  o3_decay       3 s
  o3_sustain     0.0
  o4_ratio       7
  o4_level       0.12
  o4_decay       2 s
  o4_sustain     0.0
  o5_ratio       11
  o5_level       0.08
  o5_decay       1.2 s
  o5_sustain     0.0
  o6_level       0
  snap           #0
  volume         0.67

patch Gamelan  note=60 range=36..84 role=bell
  # Two carriers a fraction apart, each with its own modulator, so the two
  # tails beat against each other for as long as they last.
  algoa          #6
  o1_ratio       1
  o1_level       0.8
  o1_decay       5 s
  o1_sustain     0.0
  o2_ratio       2.76
  o2_level       0.35
  o2_decay       2 s
  o2_sustain     0.0
  o3_ratio       1.01
  o3_level       0.7
  o3_decay       5 s
  o3_sustain     0.0
  o4_ratio       5.4
  o4_level       0.25
  o4_decay       1.5 s
  o4_sustain     0.0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.85

patch Church  note=60 range=36..84 role=bell
  # The hum an octave below the strike, which is where a real bell's two
  # lowest partials sit. The carrier stays on the note - written with the
  # carrier itself at half the ratio the patch played an octave under
  # whatever key you pressed, which is a bell that transposes.
  algoa          #6
  o1_ratio       1
  o1_level       0.85
  o1_decay       9 s
  o1_sustain     0.0
  o1_release     5 s
  o2_ratio       3
  o2_level       0.24
  o2_decay       5 s
  o2_sustain     0.0
  o3_ratio       0.5
  o3_level       0.5
  o3_decay       7 s
  o3_sustain     0.0
  o4_ratio       4.2
  o4_level       0.14
  o4_decay       3 s
  o4_sustain     0.0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.89

patch Ice  note=67 range=48..88 role=bell
  # Thin, very high, and almost no low end - but on the note. The carrier
  # was written at four times the ratio, so the patch played two octaves
  # above the key; the height comes from the modulators and the high-pass
  # instead, which is where it should have come from.
  algoa          #6
  o1_ratio       1
  o1_level       1.00
  o1_decay       4 s
  o1_sustain     0.0
  o2_ratio       9
  o2_level       0.26
  o2_decay       2 s
  o2_sustain     0.0
  o3_ratio       4
  o3_level       0.46
  o3_decay       3 s
  o3_sustain     0.0
  o4_level       0.00
  o5_level       0.00
  o6_level       0.00
  # The high-pass follows the keyboard, and the range starts where a thing
  # called Ice belongs anyway. Fixed at 700 Hz it removed the note itself
  # over the bottom octave and the tenth harmonic was the loudest thing in
  # it.
  f_type         #5
  f_freq         500 Hz
  f_key          0.8
  volume         1.00

patch Anvil  note=60 range=36..84 role=bell
  # The ring mode rather than frequency modulation: two operators
  # multiplied together, which produces sum and difference and nothing
  # else. Nothing in it is a harmonic of the note.
  algoa          #6
  o1_ratio       1
  o1_level       0.85
  o1_decay       2.5 s
  o1_sustain     0.0
  o2_mode        #1
  o2_ratio       3.7
  o2_level       0.8
  o2_decay       2 s
  o2_sustain     0.0
  o3_ratio       1
  o3_level       0.4
  o3_decay       1.5 s
  o3_sustain     0.0
  o4_mode        #1
  o4_ratio       6.3
  o4_level       0.5
  o4_decay       1 s
  o4_sustain     0.0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.84

patch Bowl  note=60 range=36..84 role=bell
  # Long, low and slow, with the modulation fading before the carrier
  # does. The note gets rounder as it dies, the way a struck bowl does.
  algoa          #6
  o1_ratio       1
  o1_level       0.85
  o1_decay       10 s
  o1_sustain     0.0
  o1_release     6 s
  o2_ratio       2.4
  o2_level       0.3
  o2_decay       1.5 s
  o2_sustain     0.0
  o3_ratio       1
  o3_fine        6
  o3_level       0.5
  o3_decay       9 s
  o3_sustain     0.0
  o4_level       0
  o5_level       0
  o6_level       0
  snap           #0
  volume         0.84

patch "Kalimba FM"  note=60 range=36..84 role=bell
  # A short bright strike over a sine that keeps going: two operators, one
