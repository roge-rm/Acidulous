patch "Saw Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Dark"
  set macro3 "Res"
  set macro4 "Edge"
  set macro5 "Bright"
  set macro6 "Skew"
  set macro7 "Morph"
  set macro8 "Thin"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #17
  mac1_a1  0.3
  mac2_d1  #17
  mac2_a1  -0.4
  mac3_d1  #18
  mac3_a1  0.4
  mac4_d1  #16
