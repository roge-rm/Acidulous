  mac5_d1  #16
  mac5_a1  0.25
  mac6_d1  #3
  mac6_a1  0.15
  mac7_d1  #2
  mac7_a1  0.5
  mac8_d1  #11
  mac8_a1  0.08
  # A stack of three with feedback on the top of it, decaying almost at
  # once. Feedback is what turns a sine into a saw here.
  algoa          #5
  o1_ratio       1
  o1_level       1.00
  o1_decay       0.7 s
  o1_sustain     0.05
  o1_release     0.2 s
  o2_ratio       3
  o2_level       1.00
  o2_decay       0.25 s
  o2_sustain     0.0
  o3_ratio       1
  o3_fb          0.45
  o3_level       1.00
  o3_decay       0.2 s
  o3_sustain     0.0
  o4_level       0.00
  o5_level       0.00
  o6_level       0.00
  f_type         #2
  f_freq         4000 Hz
  f_key          0.6
  volume         1.000
  m01_src        #1
  m01_dest       #19
  m01_depth      0.318
  # Morph goes to three pairs, so the feedback operator is heard.
  algob          #6

