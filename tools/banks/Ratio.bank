  o3_ratio       1
  o3_fine        6
  o3_level       0.55
  o3_decay       2.2 s
  o3_sustain     0.15
  o3_release     0.5 s
  o4_ratio       1
  o4_level       0.3
  o4_decay       1.2 s
  o4_sustain     0.1
  o4_vel         0.8
  o5_ratio       1
  o5_fine        -6
  o5_level       0.45
  o5_decay       2.4 s
  o5_sustain     0.15
  o5_release     0.5 s
  o6_ratio       2
