  o3_fine        5
  o3_fb          0.75
  o3_level       0.7
  o3_decay       2 s
  o3_sustain     0.85
  o3_release     0.2 s
  f_type         #3
  f_freq         3500 Hz
  f_res          0.15
  f_key          0.5
  volume         0.65
  insert Delay
    time         #2
    feedback     0.3
    tone         5000 Hz
    mode         #1
    mix          0.2
  send reverb    0.1

