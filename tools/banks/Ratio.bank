  mac1_a1  0.3
  mac2_d1  #5
  mac2_a1  0.2
  mac3_d1  #17
  mac3_a1  -0.25
  mac3_d2  #19
  mac3_a2  0.297
  mac4_d1  #16
  mac4_a1  0.2
