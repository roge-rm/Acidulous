  mac7_d1  #2
  mac7_a1  0.4
  mac8_d1  #11
  mac8_a1  0.1
  # An envelope on pitch that drops the note an octave onto itself over a
  # second, with the modulator's own envelope closing as it falls.
  algoa          #6
