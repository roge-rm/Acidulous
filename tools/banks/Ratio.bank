  o2_sustain     0.7
  o3_ratio       2
  o3_level       0.3
  o3_sustain     0.7
  o4_ratio       3
  o4_level       0.25
  o4_sustain     0.7
  o5_ratio       1
  o5_fb          0.3
  o5_level       0.2
  o5_sustain     0.7
  o6_ratio       4
  o6_level       0.15
  o6_sustain     0.7
  f_type         #3
  f_freq         5000 Hz
  volume         0.62
  insert Delay
    time         #2
    feedback     0.3
    tone         5000 Hz
    mode         #1
    mix          0.2

