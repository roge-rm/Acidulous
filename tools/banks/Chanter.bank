# Chanter - bagpipes and the hurdy-gurdy.
#
# A bagpipe is a chanter (a conical pipe with a double reed) and drones
# (narrow pipes with single reeds) blown from a bag, which keeps them going
# for `bag` seconds after the last note. `key` tunes the drones, `drones`
# sets how loud, `reed` how bright the chanter, `grace` puts a quick high
# note before each one, `drift` lets the bag's pressure wander, and `air` is
# the breath in the reeds. The smallpipes' chanter is closed: it stops for a
# moment between notes.
#
# A hurdy-gurdy is a rosined wheel bowing melody strings (stopped by the
# keys), drone strings and the trompette, whose loose bridge (the dog)
# buzzes once the `wheel` turns faster than `threshold`. `coup` pushes the
# wheel on the beat to set the dog buzzing in time; pressure or the mod
# wheel pushes it too.
#
# Families: highland, smallpipes, gaita, uilleann, gaida, cornemuse, musette,
# sackpipa, dudy, zampogna, tulum, launeddas, gurdy, drones.

machine Chanter
role lead

patch Init family=highland note=69 range=67..81

patch "Highland Pipes" family=highland note=69 range=67..81
  # The great pipes: three drones and a loud chanter, every note graced.
  grace          25 ms
  drones         0.8

patch "Pipes Ungraced" family=highland note=69 range=67..81
  # The same, with the notes running together and the bag less steady.
  grace          0 ms
  drift          0.35

patch "Pipe Band" family=highland note=69 range=67..81
  # Drones up, the bag squeezed unevenly, more air.
  grace          20 ms
  drones         0.9
  drift          0.5
  air            0.3

patch "Practice Chanter" family=highland note=69 range=67..81
  # The chanter on its own, softer reed, no drones.
  drones         0
  reed           0.3
  grace          20 ms

patch "Bright Chanter" family=highland note=69 range=67..81
  # A hard reed, loud and piercing.
  reed           0.9
  grace          15 ms

patch Smallpipes family=smallpipes note=67 range=65..79
  # A quiet, closed chanter that stops between notes, soft drones.
  model          #1
  key            #7

patch "Smallpipes Graced" family=smallpipes note=67 range=65..79
  # Closed and graced, a little breathier.
  model          #1
  key            #7
  grace          20 ms
  air            0.25

patch "Soft Smallpipes" family=smallpipes note=67 range=65..79
  # A soft reed and the drones low.
  model          #1
  key            #7
  reed           0.25
  drones         0.4

patch "Smallpipes in D" family=smallpipes note=62 range=60..74
  # Drones on D.
  model          #1
  key            #2

patch Gaita family=gaita note=72 range=70..86
  # One bass drone under a sweet, conical chanter.
  model          #2
  key            #0

patch "Gaita Bright" family=gaita note=72 range=70..86
  # A harder reed.
  model          #2
  key            #0
  reed           0.85

patch "Gaita Breath" family=gaita note=72 range=70..86
  # Breathy, the bag wandering.
  model          #2
  key            #0
  air            0.45
  drift          0.5

patch "Gaita Graced" family=gaita note=72 range=70..86
  # Grace notes before each, the drone up.
  model          #2
  key            #0
  grace          18 ms
  drones         0.75

patch "Uilleann Pipes" family=uilleann note=62 range=62..86
  # Sweet and quiet, played closed, drones on D an octave and two below.
  model          #4
  key            #2

patch "Uilleann Slow Air" family=uilleann note=62 range=62..86
  # Low drones under a slow air.
  model          #4
  key            #2
  drones         0.5
  drift          0.3

patch "Uilleann Regulators" family=uilleann note=62 range=50..86
  # Hold a key under the melody and the regulators play it, quieter.
  model          #4
  key            #2
  drones         0.5

patch "Gaida" family=gaida note=67 range=67..79
  # Bright and reedy over one deep drone, quick ornaments.
  model          #5
  key            #7
  grace          15 ms

patch "Gaida Trill" family=gaida note=67 range=67..79
  # Heavier ornaments, more breath.
  model          #5
  key            #7
  grace          30 ms
  air            0.25

patch "Cornemuse" family=cornemuse note=67 range=67..81
  # The French bagpipe in G, half closed, two drones.
  model          #6
  key            #7

patch "Cornemuse Bourrée" family=cornemuse note=67 range=67..81
  # A harder reed for dancing.
  model          #6
  key            #7
  grace          12 ms
  reed           0.7

patch "Musette de Cour" family=musette note=67 range=67..81
  # Small, soft and courtly.
  model          #7
  key            #7

patch "Musette Pastorale" family=musette note=67 range=67..81
  # Softer still, the drones far back.
  model          #7
  key            #7
  drones         0.5
  reed           0.3

patch "Sackpipa" family=sackpipa note=69 range=69..81
  # The Swedish pipe: one drone, a narrow, closed chanter.
  model          #8
  key            #9

patch "Sackpipa Polska" family=sackpipa note=69 range=69..81
  # Graced, for the dance.
  model          #8
  key            #9
  grace          18 ms

patch "Dudy" family=dudy note=63 range=63..75
  # The Czech pipe: a loud, long drone two octaves down.
  model          #9
  key            #3

patch "Dudy Village" family=dudy note=63 range=63..75
  # Rougher, the bag wandering.
  model          #9
  key            #3
  drift          0.4
  air            0.25

patch "Zampogna" family=zampogna note=67 range=55..79
  # Two chanters: hold a second key and the other hand plays it.
  model          #10
  key            #7

patch "Zampogna Natale" family=zampogna note=67 range=55..79
  # Graced, as at Christmas in the hills.
  model          #10
  key            #7
  grace          10 ms
  drift          0.3

patch "Tulum" family=tulum note=62 range=57..74
  # No drone, two chanters side by side: hold two keys.
  model          #11
  key            #2
  grace          12 ms

patch "Tulum Horon" family=tulum note=62 range=57..74
  # A hard reed and quick ornaments for dancing.
  model          #11
  key            #2
  grace          25 ms
  reed           0.8

patch "Launeddas" family=launeddas note=60 range=55..76
  # Three cane pipes: the drone, and two melody pipes for two keys.
  model          #12
  key            #0

patch "Launeddas Ballo" family=launeddas note=60 range=55..76
  # Breathier, for the dance.
  model          #12
  key            #0
  grace          8 ms
  air            0.25

patch Hurdy-Gurdy family=gurdy note=67 range=60..84
  # The wheel turning steadily, the dog quiet.
  model          #3
  key            #7

patch "Gurdy Coups" family=gurdy note=67 range=60..84
  # The wheel pushed on every beat: the dog buzzes in time.
  model          #3
  key            #7
  coup           #1

patch "Gurdy Eighths" family=gurdy note=67 range=60..84
  # Two coups a beat.
  model          #3
  key            #7
  coup           #2

patch "Gurdy Sixteenths" family=gurdy note=67 range=60..84
  # Four coups a beat, a dance.
  model          #3
  key            #7
  coup           #3
  wheel          0.45

patch "Gurdy Buzzing" family=gurdy note=67 range=60..84
  # The wheel fast enough that the dog never stops.
  model          #3
  key            #7
  wheel          0.85
  threshold      0.5

patch "Gurdy Gentle" family=gurdy note=67 range=60..84
  # A slow wheel and the dog lifted off: soft and reedy.
  model          #3
  key            #7
  wheel          0.25
  dog            0

patch "Gurdy in D" family=gurdy note=62 range=55..79
  # Drones on D, coups on the beat.
  model          #3
  key            #2
  coup           #1

patch "Pipe Drones" family=drones note=69 range=67..81 role=drone
  # Hold a note for the drones; they go on for eight seconds after.
  bag            8 s
  drones         1

patch "Gurdy Drones" family=drones note=67 range=60..84 role=drone
  # The wheel keeps the drones turning long after the note.
  model          #3
  key            #7
  bag            8 s
  drones         1
  dog            0

patch "Smallpipe Drones" family=drones note=67 range=65..79 role=drone
  # The smallpipes' soft drones, long.
  model          #1
  key            #7
  bag            8 s
  drones         1

patch "Gaita Drone" family=drones note=72 range=70..86 role=drone
  # One deep drone, long.
  model          #2
  key            #0
  bag            8 s
  drones         1
