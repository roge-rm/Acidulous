# Phaser - allpass notches, and a stage count you can change.
#
# Most phasers are four stages and that is that. `stages` here is 2, 4, 6 or 8,
# and it is the control that matters most: two is a gentle sweep with one
# notch, eight is the thick swirl people mean when they say phaser, and the
# difference is not depth, it is how many notches there are to hear.
#
# Families: classic, deep, slow.

machine fx.Phaser

patch Init family=classic

patch "Four Stage" family=classic
  # The standard, and the reason `stages` defaults where it does. Two notches
  # moving together, feedback enough to give them an edge.
  stages         #1
  rate           #5
  depth          0.7
  feedback       0.35
  mix            0.5
  gain           3.6 dB

patch "Six Stage" family=classic
  # Three notches. Denser without turning into the swirl that eight gives, and
  # the most useful setting on anything with a lot of harmonics already.
  stages         #2
  rate           #4
  depth          0.75
  feedback       0.45
  spread         0.6
  gain           3.5 dB

patch Deep family=deep
  # Eight stages, depth high, feedback high: the notches are deep enough to
  # remove most of what is between them, so the sweep is the sound rather than
  # a colour on it.
  stages         #3
  rate           #5
  depth          0.95
  feedback       0.8
  spread         0.7

patch Jet family=deep
  # Feedback at its limit, where the notches ring. Named for what it does to
  # noise, which is the material it was always for.
  stages         #3
  rate           #3
  depth          1.0
  feedback       0.9
  spread         1.0
  mix            0.65

patch Drift family=slow
  # Eight bars a cycle. Slow enough that you never hear it move, only that the
  # loop has not repeated - which is what a phaser is for on a long part.
  stages         #2
  rate           #7
  depth          0.6
  feedback       0.25
  spread         0.5
  mix            0.4
  gain           4.9 dB
