patch Bloom family=bass  note=36 range=24..55 role=bass
  set macro1 "Bloom"
  set macro2 "Open"
  set macro3 "Edge"
  set macro4 "Bite"
  set macro5 "Octave"
  set macro6 "FM"
  set macro7 "Beat"
  set macro8 "Ring"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.4
  mac2_d1  #23
  mac2_a1  0.35
  mac3_d1  #14
  mac3_a1  0.4
  mac4_d1  #25
  mac4_a1  0.3
  mac5_d1  #9
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.006
  mac8_d1  #19
  mac8_a1  0.5
  # The even table rising on a slow envelope: octaves and fifths fill in under
  # a held note.
  o1_wave        #13
  o1_pos         0.1
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #36
  o2_fine        0
  o2_level       0.4
  e3_attack      0.6 s
  e3_decay       1 s
  e3_sustain     1
  m01_src        #9
  m01_dest       #5
