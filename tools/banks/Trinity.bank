  a_release      0.2 s
  volume         0.99

patch "Growl Bass" family=bass  note=36 range=24..55 role=bass
  # The grit table through a driven filter. Where Reflux's drive is a pedal
  # after the filter, this one is a waveshape before it.
  o1_wave        #10
  o1_pos         0.4
  o1_warp        0.5
  o1_level       1.00
  o2_wave        #0
  o2_coarse      #12
