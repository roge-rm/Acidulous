patch "Big Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Width"
  set macro2 "Open"
  set macro3 "Bite"
  set macro4 "Edge"
  set macro5 "Low"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #17
  mac1_a1  0.5
  mac2_d1  #23
  mac2_a1  0.3
  mac3_d1  #25
  mac3_a1  0.4
  mac4_d1  #14
  mac4_a1  0.25
  mac4_d2  #29
  mac4_a2  -0.238
  mac5_d1  #9
  mac5_a1  0.4
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #3
  mac8_a1  0.008
  # Seven saws stacked and spread with drift, an octave below them, a ping-
  # pong echo and a wide room. The big one.
  o1_wave        #0
  o1_density     #6
  o1_detune      0.35
  o1_drift       0.2
  o1_level       1.00
  o2_wave        #0
  o2_density     #2
  o2_coarse      #12
  o2_fine        0
  o2_level       0.5
  f1_type        #3
  f1_freq        5000 Hz
  f1_res         0.1
  f1_env         0.2
  f1_key         0.3
  a_attack       0.01 s
  a_decay        1.2 s
  a_sustain      0.9
  a_release      0.35 s
  voicemode      #2
  glide          0.03 s
  volume         0.43
  insert Delay
    time         #3
    feedback     0.4
    pingpong     #1
    mix          0.2
  send reverb  0.2

patch "Fifth Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "PW"
  set macro4 "Edge"
  set macro5 "Root"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.3
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #11
  mac3_a1  0.7
  mac3_d2  #12
  mac3_a2  0.7
  mac3_d3  #13
  mac3_a3  0.7
  mac4_d1  #14
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  -0.9
  mac5_d2  #10
  mac5_a2  -0.6
  mac5_d3  #29
  mac5_a3  0.115
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #3
  mac8_a1  0.006
  # The second oscillator a fifth above and the third an octave, which is a
  # chord you cannot play a wrong note in. Hollow and very loud for its size.
  o1_wave        #1
  o1_level       1.00
  o2_wave        #1
  o2_coarse      #31
  o2_level       0.91
  o3_wave        #1
  o3_coarse      #36
  o3_level       0.58
  f1_type        #2
  f1_freq        3200 Hz
  f1_res         0.15
  a_attack       0.01 s
  a_decay        1 s
  a_sustain      0.85
  a_release      0.2 s
  volume         0.24

patch "Octave Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Sync"
  set macro4 "Upper"
  set macro5 "Low"
  set macro6 "Ring"
  set macro7 "FM"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #15
  mac3_a1  0.4
  mac4_d1  #9
  mac4_a1  0.3
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.3
  mac7_d1  #21
  mac7_a1  0.25
  mac8_d1  #3
  mac8_a1  0.008
  # A saw, a synced saw an octave up and a square an octave down, with a
  # long glide. Fat in the middle and bright on top, for lines that jump.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_coarse      #36
  o2_sync        0.25
  o2_level       0.6
  o3_wave        #1
  o3_coarse      #12
  o3_level       0.35
  f1_type        #3
  f1_freq        3000 Hz
  f1_res         0.15
  f1_env         0.35
  f1_key         0.5
  f_decay        0.6 s
  f_sustain      0.4
  a_attack       0.005 s
  a_decay        1 s
  a_sustain      0.85
  a_release      0.3 s
  voicemode      #2
  glide          0.08 s
  volume         0.47
  f2_type        #5
  f2_freq        20 Hz
  insert Delay
    time         #3
    feedback     0.35
    tone         5000 Hz
    pingpong     #1
    mix          0.2

patch "Glide Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Edge"
  set macro4 "PW"
  set macro5 "Low"
  set macro6 "Beat"
  set macro7 "FM"
  set macro8 "Ring"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.3
  mac2_d1  #25
  mac2_a1  0.35
  mac3_d1  #14
  mac3_a1  0.4
  mac4_d1  #12
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #21
  mac7_a1  0.3
  mac8_d1  #19
  mac8_a1  0.5
  # A saw and a square an octave down, mono, with a long glide only between
  # tied notes and a late vibrato.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #1
  o2_coarse      #12
  o2_fine        0
  o2_level       0.6
  l1_rate        5.5 Hz
  l1_delay       0.5 s
  m01_src        #13
  m01_dest       #1
  m01_depth      0.004
  f1_type        #3
  f1_freq        2400 Hz
  f1_res         0.3
  f1_env         0.3
  f1_key         0.5
  a_attack       0.008 s
  a_decay        1 s
  a_sustain      0.85
  a_release      0.25 s
  voicemode      #2
  glide          0.22 s
  glidemode      #1
  volume         0.39
  insert Delay
    time         #2
    feedback     0.3
    pingpong     #0
    mix          0.2

patch "PWM Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Speed"
  set macro2 "Open"
  set macro3 "Bite"
  set macro4 "Edge"
  set macro5 "Beat"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Sub"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #31
  mac1_a1  0.4
  mac2_d1  #23
  mac2_a1  0.35
  mac3_d1  #25
  mac3_a1  0.35
  mac4_d1  #14
  mac4_a1  0.4
  mac5_d1  #3
  mac5_a1  0.006
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #10
  mac8_a1  0.4
  # The pulse width moving under a slow LFO, which is the oldest trick there
  # is and still the one that makes one oscillator sound like two.
  o1_wave        #1
  o1_pw          0.5
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.5
  o2_fine        -4
  o2_level       0.96
  l1_rate        0.45 Hz
  m01_src        #13
  m01_dest       #11
  m01_depth      0.4
  m02_src        #13
  m02_dest       #12
  m02_depth      -0.35
  f1_type        #3
  f1_freq        2800 Hz
  f1_res         0.12
  a_attack       0.02 s
  a_decay        1.2 s
  a_sustain      0.85
  a_release      0.3 s
  volume         0.22
  # Silent until a macro reaches them.
  o3_wave        #1
  o3_coarse      #12

patch "Sync Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Sync"
  set macro2 "Dark"
  set macro3 "Bite"
  set macro4 "Edge"
  set macro5 "Square"
