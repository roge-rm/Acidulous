patch "Glass Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Scan"
  set macro2 "Bright"
  set macro3 "Res"
  set macro4 "Ring"
  set macro5 "FM"
  set macro6 "Beat"
  set macro7 "Octave"
  set macro8 "Air"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.4
  mac1_d2  #29
  mac1_a2  0.579
  mac2_d1  #23
  mac2_a1  0.35
  mac3_d1  #25
  mac3_a1  0.3
  mac4_d1  #19
  mac4_a1  0.3
  mac5_d1  #21
  mac5_a1  0.25
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #10
  mac7_a1  0.35
  mac8_d1  #18
  mac8_a1  0.08
  a_attack       0.8 s
  a_decay        2 s
  a_release      2.5 s
  a_sustain      0.75
  f1_freq        4000 Hz
  f1_res         0.2
  f1_type        #1
  l1_rate        0.15 Hz
  l2_rate        0.07 Hz
  m01_depth      0.4
  m01_dest       #5
  m01_src        #13
  m02_depth      0.15
  m02_dest       #23
  m02_src        #14
  m03_depth      0.5
  m03_dest       #5
  m03_src        #2
  m04_depth      0.45
