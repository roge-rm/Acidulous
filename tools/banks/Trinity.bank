  f1_type        #3
  f1_freq        700 Hz
  f1_res         0.25
  f1_env         0.35
  f_attack       4 s
  f_decay        6 s
  f_sustain      0.4
  a_attack       1.5 s
  a_decay        4 s
  a_sustain      0.85
  a_release      4 s
  volume         0.32
  f2_type        #5
  f2_freq        20 Hz
  send reverb    0.15

patch "Sweep Pad" family=pad  note=55 range=36..79 role=pad
