  mac4_d1  #17
  mac4_a1  0.4
  mac5_d1  #18
  mac5_a1  0.12
  mac6_d1  #14
  mac6_a1  0.4
  mac7_d1  #10
  mac7_a1  0.4
  mac8_d1  #3
  mac8_a1  -0.006
  # Two pulses with their widths swept by two slow LFOs at different rates,
  # through a gentle low pass. The warm analogue pad, made from pulse width
  # rather than from saws.
  o1_wave        #1
  o1_pw          0.3
  o1_density     #2
  o1_detune      0.2
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.7
  o2_fine        -7
  o2_level       0.8
