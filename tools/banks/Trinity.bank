  mac2_d1  #24
  mac2_a1  0.4
  mac3_d1  #23
  mac3_a1  0.4
  mac3_d2  #29
  mac3_a2  0.313
  mac4_d1  #17
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.3
  mac7_d1  #6
  mac7_a1  0.4
  mac8_d1  #3
  mac8_a1  0.006
  # A wide stack of saws and the glass table an octave up, high-passed with
  # the keyboard, with white noise in the same band. More air than note,
  # but the note is still there at the bottom of the range.
  o1_wave        #0
  o1_density     #5
  o1_detune      0.35
  o1_level       0.7
  o2_wave        #5
  o2_pos         0.6
  o2_coarse      #36
  o2_level       0.5
  noise          0.25
  noisecol       1
  f1_type        #5
  f1_freq        200 Hz
