  insert Bitcrusher
    bits         8
    rate         9000 Hz
    mix          0.5

patch Scream family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Edge"
  set macro4 "FM"
  set macro5 "Ring"
  set macro6 "Width"
  set macro7 "Beat"
  set macro8 "Fifth"
