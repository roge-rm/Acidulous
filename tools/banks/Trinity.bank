  o3_detune      0.2
  o3_fine        7
  o3_level       0.7
  f1_type        #3
  f1_freq        1800 Hz
  f1_res         0.1
  f1_key         0.3
  f1_env         0.2
  f_attack       2 s
  f_decay        3 s
  f_sustain      0.8
  a_attack       1.6 s
  a_decay        3 s
  a_sustain      0.9
  a_release      2.5 s
  volume         0.29
  send reverb    0.15

patch "Bright Strings" family=ensemble  note=55 range=36..79 role=pad
