  a_sustain      0.8
  f1_env         0.25
  f1_freq        6000 Hz
  f1_res         0.1
  m01_depth      0.4
  m01_dest       #23
  m01_src        #2
  m02_depth      0.4
  m02_dest       #17
  m02_src        #3
  o1_density     #4
  o1_detune      0.45
  o1_drift       0.3
  o1_level       1.00
  o2_density     #2
  o2_detune      0.6
  o2_drift       0.3
  o2_fine        -9
  o2_level       1.00
  o3_coarse      #12
