  set macro1 "Vowel"
  set macro2 "Open"
  set macro3 "Res"
  set macro4 "Width"
  set macro5 "Breath"
  set macro6 "Ring"
  set macro7 "Beat"
  set macro8 "Low"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.4
  mac1_d2  #6
  mac1_a2  -0.3
  mac2_d1  #23
  mac2_a1  0.35
  mac3_d1  #25
  mac3_a1  0.4
  mac4_d1  #17
  mac4_a1  0.3
  mac5_d1  #18
  mac5_a1  0.1
  mac6_d1  #19
  mac6_a1  0.2
  mac7_d1  #3
  mac7_a1  0.006
  mac8_d1  #10
  mac8_a1  0.4
  # The vowel table on two oscillators a fifth apart, drifting. Not a sample
