  a_sustain      0.8
  a_release      2.6 s
  volume         1.00

patch "Dark Pad" family=pad  note=55 range=36..79 role=pad
  # Low, filtered hard and with the noise floor deliberately left in. For
  # underneath things rather than on top of them.
  o1_wave        #0
  o1_coarse      #12
  o1_density     #2
  o1_detune      0.35
  o1_level       1.00
  o2_wave        #2
  o2_level       0.86
  noise          0.31
  noisecol       0.25
  f1_type        #3
  f1_freq        700 Hz
  f1_res         0.25
  f1_env         0.2
  a_attack       1.4 s
  a_decay        4 s
  a_sustain      0.7
  a_release      3 s
  volume         0.53

patch Shimmer family=pad  note=55 range=36..79 role=pad
  # The glass table an octave and a fifth up over a root that stays the
  # loudest thing in it. Written the other way round the played pitch was
  # thirty decibels under the twelfth above it, which is a patch that
  # transposes what you play.
  # The glass table an octave and a fifth up over a root, with both
  # drifting. High, bright, and thin enough to sit over anything.
  o1_wave        #5
  o1_pos         0.5
  o1_level       1.00
  o2_wave        #5
  o2_coarse      #43
  o2_pos         0.75
  o2_level       0.45
  # The sine sits on the note rather than an octave over it, so there is a
  # fundamental under the shimmer. Without one the patch played an octave
  # above whatever key you pressed, which a shimmer may do to a reverb tail
  # but should not do to a keyboard.
  o3_wave        #3
  o3_level       0.55
  o1_drift       0.5
  o2_drift       0.45
  # The high-pass follows the keyboard. Fixed at 400 Hz it removed the note
  # itself over the bottom half of the range - eighty decibels down at the
  # lowest, with the sixth harmonic the loudest thing in it - so the patch
  # played a different pitch depending where you put your hand.
  f1_type        #5
  f1_freq        120 Hz
  f1_key         0.9
  a_attack       1.6 s
  a_decay        4 s
  a_sustain      0.85
  a_release      3.5 s
  volume         0.73

patch "Breath Pad" family=pad  note=55 range=36..79 role=pad
  # Mostly noise, with just enough oscillator under it to give the noise a
  # pitch. The band-pass is what makes it a note rather than a hiss.
  o1_wave        #3
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #31
  o2_level       0.60
  noise          1.00
  noisecol       0.55
  f1_type        #8
  f1_freq        1200 Hz
  f1_res         0.3
  f1_key         0.9
  f1_env         0.25
  a_attack       1.1 s
  a_decay        3 s
  a_sustain      0.75
  a_release      2.4 s
  volume         1.00

patch "Rotor Pad" family=pad  note=55 range=36..79 role=pad
  # The organ table with a fast LFO on the pitch of one oscillator only, so
  # the two beat against each other the way a spinning cabinet does.
  o1_wave        #11
  o1_level       1.00
  o2_wave        #11
  o2_fine        4
  o2_level       1.00
  l1_rate        5.6 Hz
  m01_src        #13
  m01_dest       #3
  m01_depth      0.12
  f1_type        #1
  f1_freq        3000 Hz
  a_attack       0.15 s
  a_decay        2 s
  a_sustain      0.85
  a_release      0.6 s
  volume         0.53

patch "Glass Ice" family=pad  note=55 range=36..79 role=pad
  # The glass table played straight with a notch moving through it. Cold,
  # and the notch is what stops it being a organ.
  o1_wave        #5
  o1_pos         0.15
  o1_density     #1
  o1_level       0.75
  o2_wave        #5
  o2_pos         0.85
  o2_fine        -11
  o2_level       0.5
  f1_type        #10
  f1_freq        1200 Hz
  f1_res         0.5
  l1_rate        0.2 Hz
  m01_src        #13
  m01_dest       #23
  m01_depth      0.45
  a_attack       0.7 s
  a_decay        3 s
  a_sustain      0.8
  a_release      2.2 s
  volume         0.82

patch Wash family=pad  note=55 range=36..79 role=pad
  # Eight-voice unison on two oscillators with the detune wide and the
  # attack long enough that nothing ever quite starts. Density at its limit.
  o1_wave        #0
  o1_density     #7
  o1_detune      0.8
  o1_drift       0.6
  o1_level       1.00
  o2_wave        #2
  o2_density     #7
  o2_detune      0.7
  o2_coarse      #19
  o2_level       0.77
  f1_type        #1
  f1_freq        1800 Hz
  a_attack       2.5 s
  a_decay        5 s
  a_sustain      0.8
  a_release      4 s
  volume         0.51

patch "Solo String" family=ensemble  note=60 range=48..84 role=lead
  # One voice, a slow bow on the attack and a little drift. Deliberately not
  # an ensemble: it is the patch that shows the ensemble ones are ensembles.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_fine        5
  o2_level       0.74
  o1_drift       0.3
  f1_type        #2
  f1_freq        2400 Hz
  f1_res         0.18
  f1_env         0.25
  a_attack       0.22 s
  a_decay        2 s
  a_sustain      0.85
  a_release      0.5 s
  glide          0.04 s
  volume         0.44

patch Ensemble family=ensemble  note=55 range=36..79 role=pad
  # Six voices of unison on each of two oscillators, drifting apart at
  # different rates. The size comes from the drift and not from the detune,
  # which is the difference between an ensemble and a chorus pedal.
  o1_wave        #0
  o1_density     #5
  o1_detune      0.32
  o1_drift       0.45
  o1_level       1.00
  o2_wave        #2
  o2_density     #4
  o2_detune      0.28
  o2_drift       0.3
  o2_fine        -7
  o2_level       0.97
  f1_type        #2
  f1_freq        3200 Hz
  f1_res         0.1
  a_attack       0.35 s
  a_decay        2.5 s
  a_sustain      0.85
  a_release      1.2 s
  volume         0.38

patch "Brass Section" family=ensemble  note=55 range=40..79 role=keys
  # The filter envelope arriving late and hard, which is what a brass attack
  # is. Three oscillators, the third an octave down for weight.
  o1_wave        #0
  o1_density     #2
  o1_detune      0.22
  o1_level       1.00
  o2_wave        #0
  o2_fine        9
  o2_level       1.00
  o3_wave        #1
  o3_coarse      #12
  o3_level       0.59
  f1_type        #3
  f1_freq        700 Hz
  f1_res         0.22
  f1_env         0.75
  f1_key         0.4
  f_attack       0.06 s
  f_decay        0.5 s
  f_sustain      0.45
  a_attack       0.04 s
  a_decay        1.5 s
  a_sustain      0.85
  a_release      0.3 s
  volume         0.40

patch "Soft Horn" family=ensemble  note=55 range=36..79 role=pad
  # The same idea with the envelope taken off and the filter left low: round
  # and slow, and it stops being brass the moment it stops being bright.
  o1_wave        #0
  o1_density     #1
  o1_level       1.00
  o2_wave        #2
  o2_fine        -5
  o2_level       0.92
  o3_wave        #3
  o3_coarse      #12
  o3_level       0.50
  f1_type        #3
  f1_freq        1100 Hz
  f1_res         0.1
  f1_env         0.2
  a_attack       0.3 s
  a_decay        2 s
  a_sustain      0.8
  a_release      0.8 s
  volume         0.35

patch "Analog Strings" family=ensemble  note=55 range=36..79 role=pad
  # Saw and square a shade apart with the drift up, filtered gently and with
  # a slow sweep on the cutoff. The string machine rather than the string.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.38
  o1_drift       0.5
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.42
  o2_fine        8
  o2_level       0.82
  l1_rate        0.09 Hz
  m01_src        #13
  m01_dest       #23
  m01_depth      0.35
  f1_type        #2
  f1_freq        2000 Hz
  f1_res         0.15
  a_attack       0.5 s
  a_decay        3 s
  a_sustain      0.8
  a_release      1.6 s
  volume         0.31

patch Swell family=ensemble  note=55 range=36..69 role=pad
  # Nothing at all for a quarter of a second and then everything. Written
  # at 0.45 plus a 1.8 second attack it had not started by the end of a two
  # second note, which is a patch nobody can play. The amplitude
  # delay is a parameter most synths do not have and this is what it is for.
  o1_wave        #4
  o1_pos         0.45
  o1_density     #2
  o1_detune      0.3
  o1_level       1.00
  o2_wave        #0
  o2_coarse      #19
  o2_level       0.61
