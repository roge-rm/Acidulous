  mac7_d1  #21
  mac7_a1  0.3
  mac8_d1  #18
  mac8_a1  0.2
  # A drifting square and triangle through tape with a little wow and a soft
  # top. Like an old recording of a bass.
  o1_wave        #1
  o1_pw          0.45
  o1_level       1.00
  o1_drift       0.5
  o2_wave        #2
  o2_fine        5
  o2_level       0.7
  o2_drift       0.5
  o3_wave        #3
  o3_coarse      #12
  f1_type        #1
  f1_freq        900 Hz
  f1_res         0.1
  f1_env         0.25
  a_attack       0.005 s
  a_decay        1.5 s
  a_sustain      0.75
  a_release      0.2 s
  voicemode      #1
  volume         0.35
  insert Tape
    wow          0.12
    flutter      0.08
    drive        0.4
    tone         7000 Hz
    hiss         0
    age          0.3
    gain         -3 dB

patch Rasp family=bass  note=36 range=24..55 role=bass
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Edge"
  set macro4 "Beat"
  set macro5 "Sub"
