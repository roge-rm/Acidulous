# Trinity - seeded from what shipped, and not yet voiced.
#
# Values are in each parameter's own units; `audition params Trinity` lists
# them. A patch names only what it changes.

machine Trinity

patch Init

patch "Wide Saws"
  a_attack       0.02 s
  a_decay        1.2 s
  a_release      0.5 s
  a_sustain      0.8
  f1_env         0.25
  f1_freq        6000 Hz
  f1_res         0.1
  m01_depth      0.4
  m01_dest       #23
  m01_src        #2
  m02_depth      0.4
  m02_dest       #17
  m02_src        #3
  o1_density     #5
  o1_detune      0.45
  o1_drift       0.3
  o1_level       0.7
  o2_density     #3
  o2_detune      0.6
  o2_drift       0.3
  o2_fine        -9
  o2_level       0.6
  o3_coarse      #12
  o3_density     #1
  o3_drift       0.2
  o3_level       0.4

patch "Glass Pad"
