  f1_type        #1
  f1_freq        1800 Hz
  f1_res         0.1
  f1_env         0
  a_attack       0.02 s
  a_decay        2 s
  a_sustain      0.85
  a_release      0.2 s
  voicemode      #1
  volume         0.52

patch "Sync Bass" family=bass  note=36 range=24..55 role=bass
  set macro1 "Tear"
  set macro2 "Open"
  set macro3 "Bite"
  set macro4 "Soft"
  set macro5 "Sub"
  set macro6 "Body"
  set macro7 "FM"
  set macro8 "Ring"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #3
  mac1_a1  0.3
  mac2_d1  #23
  mac2_a1  0.35
  mac3_d1  #25
  mac3_a1  0.4
  mac4_d1  #24
  mac4_a1  -0.5
  mac5_d1  #10
  mac5_a1  0.5
  mac6_d1  #8
  mac6_a1  0.5
  mac7_d1  #21
  mac7_a1  0.3
  mac8_d1  #19
  mac8_a1  0.5
  # Oscillator two hard-synced to one, its pitch swept down by an envelope on
  # every note. The tearing sync, kept low.
  o1_wave        #0
  o1_level       0.4
  o2_wave        #0
  o2_sync        1
  o2_hard        1
  o2_coarse      #36
  o2_fine        0
  o2_level       1.00
  o3_wave        #3
  o3_coarse      #12
  e3_attack      0.001 s
  e3_decay       0.25 s
  e3_sustain     0.1
  m01_src        #9
  m01_dest       #3
  m01_depth      0.4
  f1_type        #3
  f1_freq        1600 Hz
  f1_res         0.15
  f1_env         0.3
  f_decay        0.3 s
  f_sustain      0.2
  a_attack       0.003 s
  a_decay        1 s
  a_sustain      0.7
  a_release      0.15 s
  voicemode      #1
  volume         0.77

patch "Fifth Bass" family=bass  note=36 range=24..55 role=bass
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Edge"
  set macro4 "Fifth"
  set macro5 "Sub"
  set macro6 "Beat"
  set macro7 "FM"
  set macro8 "Ring"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
