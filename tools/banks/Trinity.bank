  # Silent until a macro reaches them.
  o3_wave        #3
  o3_coarse      #36

patch Undertow family=pad  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Ring"
  set macro4 "Width"
  set macro5 "Noise"
  set macro6 "Sync"
  set macro7 "Bow"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.4
  mac2_d1  #25
  mac2_a1  0.35
  mac3_d1  #19
  mac3_a1  0.3
  mac4_d1  #17
  mac4_a1  0.4
  mac5_d1  #18
  mac5_a1  0.15
  mac6_d1  #15
  mac6_a1  0.4
  mac7_d1  #7
  mac7_a1  0.5
  mac8_d1  #3
  mac8_a1  0.006
  # A stacked saw an octave down and a square on the note, under a low pass
  # that takes four seconds to open, with dark noise left in. For the bottom
  # of a film cue.
  o1_wave        #0
  o1_coarse      #12
  o1_density     #3
  o1_detune      0.2
  o1_level       1.00
  o2_wave        #1
  o2_fine        5
  o2_level       0.7
  o3_wave        #26
  o3_pos         0.3
  o3_level       0.35
  noise          0.06
  noisecol       0.2
  f1_type        #3
  f1_freq        700 Hz
  f1_res         0.25
  f1_env         0.35
  f_attack       4 s
  f_decay        6 s
  f_sustain      0.4
  a_attack       1.5 s
  a_decay        4 s
  a_sustain      0.85
  a_release      4 s
  volume         0.28
  f2_type        #5
  f2_freq        20 Hz
  send reverb    0.3

patch "Sweep Pad" family=pad  note=55 range=36..79 role=pad
