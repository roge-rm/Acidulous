  a_sustain      0.0
  a_release      1.2 s
  volume         0.39

patch Drone family=texture  note=55 range=36..79 role=pad
  # Three oscillators on the organ table at the octave and the fifth, no
  # envelope movement at all, and enough drift that it never quite repeats.
  o1_wave        #11
  o1_level       1.00
  o2_wave        #11
  o2_coarse      #31
  o2_level       0.75
  o3_wave        #11
  o3_coarse      #36
  o3_level       0.58
  o1_drift       0.55
  o2_drift       0.5
  o3_drift       0.6
  f1_type        #1
  f1_freq        2400 Hz
  a_attack       2 s
  a_decay        8 s
  a_sustain      0.9
  a_release      3 s
  volume         0.56

patch Metallic family=texture  note=55 range=36..79 role=pad
  # The fold table warped hard through a peaking filter. Inharmonic on
  # purpose: it has a pitch but it does not have a key.
  o1_wave        #9
  o1_pos         0.8
  o1_warp        0.75
  o1_level       1.00
  o2_wave        #9
  o2_pos         0.3
  o2_coarse      #30
  o2_level       0.81
  f1_type        #11
  f1_freq        1800 Hz
  f1_res         0.6
  a_attack       0.01 s
  a_decay        3 s
  a_sustain      0.3
  a_release      1.5 s
  volume         0.33

patch "Sweep Down" family=texture  note=55 range=36..79 role=pad
  # A filter falling from the top of its range to the bottom over four
  # seconds, with nothing else happening. The one you put at the end of a
  # bar.
  o1_wave        #0
  o1_density     #4
  o1_detune      0.45
  o1_level       1.00
  o2_wave        #10
  o2_level       0.55
  noise          0.35
  f1_type        #3
  f1_freq        9000 Hz
  f1_res         0.45
  f1_env         -0.95
  f_attack       0.01 s
  f_decay        4 s
  f_sustain      0.0
  a_attack       0.01 s
  a_decay        5 s
  a_sustain      0.6
  a_release      1.5 s
  volume         0.42

patch Air family=texture  note=55 range=36..79 role=pad
  # A high-pass at four kilohertz on almost nothing: what is left is the top
  # of the drift and the top of the noise. Sits above a mix without being
  # in it.
  o1_wave        #5
  o1_pos         0.9
  o1_density     #3
  o1_detune      0.5
  o1_drift       0.6
  o1_level       1.00
  noise          0.3
  noisecol       0.9
  # The high-pass follows the keyboard and sits far lower than it did. At a
  # fixed four kilohertz there was no note anywhere in the range - the patch
  # was a texture with no pitch, which is a fine layer and not a thing you
  # can play: twelve decibels an octave rather than twenty-four, and a
  # third of the noise. It is still airy and it now has a note in it.
  f1_type        #5
  f1_freq        600 Hz
  f1_key         0.8
  f1_res         0.2
  a_attack       1.5 s
  a_decay        4 s
  a_sustain      0.85
  a_release      3 s
  volume         0.95
