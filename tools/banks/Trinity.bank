patch Reese family=bass  note=36 range=24..55 role=bass
  # Two saws far enough apart to beat rather than to thicken, low-passed
  # until only the beating is left. The detune is the instrument.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_fine        -28
  o2_level       1.00
  o1_drift       0.15
