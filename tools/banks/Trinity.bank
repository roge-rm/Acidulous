patch "Sync Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Sync"
  set macro2 "Tear"
  set macro3 "Open"
  set macro4 "Res"
  set macro5 "Width"
  set macro6 "Ring"
  set macro7 "Sub"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
