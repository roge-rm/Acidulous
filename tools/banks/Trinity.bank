  m01_depth      0.35
  f1_type        #2
  f1_freq        2000 Hz
  f1_res         0.15
  a_attack       0.5 s
  a_decay        3 s
  a_sustain      0.8
  a_release      1.6 s
  volume         0.31

patch Swell family=ensemble  note=55 range=36..69 role=pad
  # Nothing at all for a quarter of a second and then everything. Written
  # at 0.45 plus a 1.8 second attack it had not started by the end of a two
  # second note, which is a patch nobody can play. The amplitude
  # delay is a parameter most synths do not have and this is what it is for.
  o1_wave        #4
  o1_pos         0.45
  o1_density     #2
  o1_detune      0.3
  o1_level       1.00
  o2_wave        #0
  o2_coarse      #19
  o2_level       0.61
  a_delay        0.25 s
  a_attack       1.1 s
  a_decay        3 s
  a_sustain      0.8
  a_release      2.5 s
  f1_type        #1
  f1_freq        2600 Hz
  f1_env         0.4
  volume         0.81

