  a_release      0.3 s
  volume         0.39

patch "Fifth Lead" family=lead  note=67 range=48..91 role=lead
  # The second oscillator a fifth above and the third an octave, which is a
  # chord you cannot play a wrong note in. Hollow and very loud for its size.
  o1_wave        #1
  o1_level       1.00
  o2_wave        #1
  o2_coarse      #31
  o2_level       0.91
  o3_wave        #1
