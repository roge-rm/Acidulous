patch Undertow family=pad  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Ring"
  set macro4 "Width"
  set macro5 "Noise"
  set macro6 "Sync"
  set macro7 "Bow"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.4
  mac2_d1  #25
  mac2_a1  0.35
  mac3_d1  #19
  mac3_a1  0.3
  mac4_d1  #17
  mac4_a1  0.4
  mac5_d1  #18
  mac5_a1  0.15
  mac6_d1  #15
  mac6_a1  0.4
  mac7_d1  #7
  mac7_a1  0.5
  mac8_d1  #3
  mac8_a1  0.006
  # A stacked saw an octave down and a square on the note, under a low pass
  # that takes four seconds to open, with dark noise left in. For the bottom
  # of a film cue.
  o1_wave        #0
  o1_coarse      #12
  o1_density     #3
  o1_detune      0.2
  o1_level       1.00
  o2_wave        #1
  o2_fine        5
  o2_level       0.7
  o3_wave        #26
