patch Air family=texture  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Scan"
  set macro4 "Width"
  set macro5 "Beat"
  set macro6 "Ring"
  set macro7 "Octave"
  set macro8 "Air"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.3
  mac2_d1  #25
  mac2_a1  0.3
  mac3_d1  #5
  mac3_a1  -0.3
  mac4_d1  #17
  mac4_a1  0.25
  mac5_d1  #3
  mac5_a1  0.006
  mac6_d1  #19
  mac6_a1  0.2
  mac7_d1  #10
  mac7_a1  0.3
  mac8_d1  #18
  mac8_a1  0.1
  # A high-pass at four kilohertz on almost nothing: what is left is the top
  # of the drift and the top of the noise. Sits above a mix without being
  # in it.
  o1_wave        #5
  o1_pos         0.9
  o1_density     #3
  o1_detune      0.5
  o1_drift       0.6
  o1_level       1.00
  noise          0.3
  noisecol       0.9
  # The high-pass follows the keyboard and sits far lower than it did. At a
  # fixed four kilohertz there was no note anywhere in the range - the patch
  # was a texture with no pitch, which is a fine layer and not a thing you
  # can play: twelve decibels an octave rather than twenty-four, and a
  # third of the noise. It is still airy and it now has a note in it.
  f1_type        #5
  f1_freq        600 Hz
  f1_key         0.8
  f1_res         0.2
  a_attack       1.5 s
  a_decay        4 s
  a_sustain      0.85
  a_release      3 s
  volume         0.95
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36

