patch "Bell Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Strike"
  set macro2 "Dark"
  set macro3 "Ring"
  set macro4 "Glass"
  set macro5 "Edge"
  set macro6 "Air"
  set macro7 "Octave"
  set macro8 "Metal"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #21
  mac1_a1  0.4
  mac2_d1  #23
  mac2_a1  -0.4
  mac3_d1  #19
  mac3_a1  0.4
  mac4_d1  #9
  mac4_a1  0.3
  mac5_d1  #14
  mac5_a1  0.4
  mac6_d1  #18
  mac6_a1  0.15
  mac7_d1  #10
  mac7_a1  0.4
  mac8_d1  #3
  mac8_a1  0.02
  # Two sines in FM at three to one, the index falling away, so each note
  # strikes like a bell and then sings on. Ping-pong echo and some room.
  o1_wave        #3
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #43
  o2_fine        0
  o2_level       0.00
  o3_wave        #3
  o3_coarse      #36
  fm21           0.15
  e3_attack      0.001 s
  e3_decay       0.5 s
  e3_sustain     0
  m01_src        #9
  m01_dest       #21
  m01_depth      0.5
  l2_rate        5 Hz
  l2_delay       0.6 s
  m02_src        #14
  m02_dest       #1
  m02_depth      0.004
  f1_type        #1
  f1_freq        9000 Hz
  f1_res         0
  f1_env         0
  a_attack       0.002 s
  a_decay        2.5 s
  a_sustain      0.6
  a_release      0.6 s
  voicemode      #2
  glide          0.03 s
  volume         0.39
  insert Delay
    time         #3
    feedback     0.4
    tone         6000 Hz
    pingpong     #1
    mix          0.25
  send reverb  0.2

