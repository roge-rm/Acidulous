patch "Pump Pad" family=sequence  note=55 range=36..79 role=sequence
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Double"
  set macro4 "Half"
  set macro5 "Octave"
  set macro6 "Ring"
  set macro7 "Beat"
  set macro8 "Air"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.35
  mac3_d1  #34
  mac3_a1  0.25
  mac3_d2  #35
  mac3_a2  0.25
  mac4_d1  #34
  mac4_a1  -0.25
  mac4_d2  #35
  mac4_a2  -0.25
  mac5_d1  #9
  mac5_a1  0.35
  mac6_d1  #19
  mac6_a1  0.25
  mac7_d1  #3
  mac7_a1  0.006
  mac8_d1  #18
  mac8_a1  0.08
  # A soft saw pad that ducks on every beat and swells back, as if a kick
  # were pushing it down. A rising LFO on the level and a little on the
  # filter; LFO 2 falls once over the first beat and cancels it, so a chord
  # opens steady and the first duck lands on the next beat.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.3
  o1_level       1.00
  o2_wave        #2
  o2_coarse      #36
  o2_level       0.30
  o3_wave        #3
  o3_coarse      #12
  o3_level       0.00
  f1_type        #3
  f1_freq        1600 Hz
  f1_res         0.1
  f1_env         0.0
  l1_wave        #2
  l1_sync        #9
  l1_slew        0.04
  m01_src        #13
  m01_dest       #29
  m01_depth      0.276
  m02_src        #13
  m02_dest       #23
  m02_depth      0.15
  l2_wave        #3
  l2_sync        #9
  l2_slew        0.04
  l2_oneshot     #1
  m03_src        #14
  m03_dest       #29
  m03_depth      0.276
  m04_src        #14
  m04_dest       #23
  m04_depth      0.15
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.05 s
  a_decay        1.0 s
  a_sustain      1.0
  a_release      0.6 s
  volume         0.36
  send reverb    0.14


