  mac4_a1  0.3
  mac5_d1  #17
  mac5_a1  0.4
  mac6_d1  #19
  mac6_a1  0.3
  mac7_d1  #10
  mac7_a1  0.4
  mac8_d1  #3
  mac8_a1  -0.006
  # Two saws with sync pulled up over four seconds by their own envelope, so
  # a held chord grows a hard, vocal edge and settles halfway back.
  o1_wave        #0
  o1_sync        0.15
  o1_level       1.00
  o2_wave        #0
  o2_fine        -7
  o2_sync        0.05
  o2_level       0.8
