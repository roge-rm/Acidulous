patch "Metal Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Strike"
  set macro2 "Chain"
  set macro3 "Scan"
  set macro4 "Dark"
  set macro5 "Ring"
  set macro6 "Edge"
  set macro7 "Beat"
  set macro8 "Air"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #21
  mac1_a1  0.25
  mac2_d1  #22
  mac2_a1  0.3
  mac3_d1  #6
  mac3_a1  0.5
  mac4_d1  #23
  mac4_a1  -0.4
  mac5_d1  #19
  mac5_a1  0.3
  mac6_d1  #14
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.008
  mac8_d1  #18
  mac8_a1  0.08
  # A sine modulated by the metal table, which a sine an octave and a half
  # up modulates in turn. The index falls after the strike, so it rings
  # like struck metal and then holds as a tone. Filter 2 takes out the
  # offset the FM leaves.
  o1_wave        #3
  o1_level       1.00
  o2_wave        #29
  o2_pos         0.3
  o2_level       0.00
  o3_wave        #3
  o3_coarse      #43
  o3_level       0.00
  fm21           0.15
  fm32           0.15
  e3_attack      0.001 s
  e3_decay       0.5 s
  e3_sustain     0
  m01_src        #9
  m01_dest       #21
  m01_depth      0.2
  f1_type        #1
  f1_freq        7000 Hz
  f1_env         0
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.003 s
  a_decay        1.5 s
  a_sustain      0.75
  a_release      0.35 s
  voicemode      #2
  glide          0.03 s
  volume         0.5
  insert Delay
    time         #3
    feedback     0.35
    tone         6000 Hz
    pingpong     #1
    mix          0.2

