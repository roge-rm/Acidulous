  f1_freq        700 Hz
  f1_res         0.45
  f1_key         0.6
  f1_env         0
  f2_type        #9
  f2_freq        1150 Hz
  f2_res         0.45
  f2_key         0.6
  l1_rate        0.2 Hz
  m01_src        #13
  m01_dest       #23
  m01_depth      0.12
  m02_src        #13
  m02_dest       #24
  m02_depth      -0.1
  # Higher notes sit further into the formants, so the key turns the level
  # down as it climbs.
  m03_src        #5
  m03_dest       #29
  m03_depth      -0.5
  a_attack       0.4 s
  a_decay        2.5 s
  a_sustain      0.9
  a_release      1.5 s
