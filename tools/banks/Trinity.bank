  set macro2 "Open"
  set macro3 "Res"
  set macro4 "Width"
  set macro5 "Ring"
  set macro6 "FM"
  set macro7 "Beat"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
