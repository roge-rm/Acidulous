patch Wobble family=bass  note=36 range=24..55 role=bass
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Double"
  set macro4 "Grit"
  set macro5 "Sub"
  set macro6 "Beat"
  set macro7 "Ring"
  set macro8 "Noise"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.45
  mac2_d1  #25
  mac2_a1  0.35
  mac2_d2  #28
  mac2_a2  0.2
  mac3_d1  #34
  mac3_a1  0.5
  mac4_d1  #21
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.5
  mac6_d1  #3
  mac6_a1  -0.01
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #18
  mac8_a1  0.15
  # Rasp's two saws through a resonant low pass that LFO 1 opens and
  # closes in eighth triplets, restarting with each note. Lock l1_sync on the
  # steps (1/4, 1/8, 1/8T, 1/16) and the bass talks.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_fine        -18
  o2_level       1.00
  o1_drift       0.1
  f1_type        #3
  f1_freq        200 Hz
  f1_res         0.55
  f1_env         0.1
  f1_drive       0.45
  l1_sync        #4
  m01_src        #13
  m01_dest       #23
  m01_depth      0.8
  a_attack       0.005 s
  a_decay        1.5 s
  a_sustain      1.0
  a_release      0.12 s
  volume         0.52
  # Silent until a macro reaches them.
  o3_wave        #3
  o3_coarse      #12

