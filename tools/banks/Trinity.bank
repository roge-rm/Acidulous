patch "Worn Bass" family=bass  note=36 range=24..55 role=bass
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Edge"
  set macro4 "PW"
  set macro5 "Sub"
  set macro6 "Beat"
  set macro7 "FM"
  set macro8 "Hiss"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #14
  mac3_a1  0.4
