  mac4_a1  0.4
  mac5_d1  #21
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.008
  mac8_d1  #9
  mac8_a1  0.3
  # The fold table pushed deep by a fast envelope and settling halfway,
