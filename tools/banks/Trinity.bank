  m01_dest       #11
  m01_depth      0.35
  m02_src        #14
  m02_dest       #12
  m02_depth      -0.3
  f1_type        #3
  f1_freq        1800 Hz
  f1_res         0.15
  f1_env         0.2
  f_attack       0.8 s
  f_decay        3 s
  f_sustain      0.5
  a_attack       0.7 s
  a_decay        3 s
  a_sustain      0.8
  a_release      2 s
  volume         0.17
  f2_type        #5
  f2_freq        20 Hz
  f1_key         0.2
  # Silent until a macro reaches them.
  o3_wave        #1
  o3_coarse      #12
  insert Chorus
    voices       #1
    rate         #14
    depth        0.4
    spread       0.8
    mix          0.4
  send reverb    0.25

