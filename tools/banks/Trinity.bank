# Trinity - two hundred and fifty-six patches in ten families.
#
# Three oscillators, each with thirty-six waveforms - four analogue shapes and
# thirty-two wavetables - eight voices of unison apiece with their own detune
# and their own drift, ring modulation and FM between them, two filters with
# twelve types and six drive curves each, six envelopes, three LFOs and a
# modulation matrix. A bank of seven was not a bank, it was a sample of one.
#
# The patches are grouped by what they are for: leads (Init, a plain saw,
# first), basses, pads, keys, plucks, sequences, strings, brass and choirs,
# bells, sounds that move by themselves, then textures last, and each group
# runs from the plainest sounds to the strangest. Each says which demo it is
# auditioned with, because a pad judged on a melody and a lead judged on a
# chord both sound like mistakes. Four
# demos are new for this machine - `pad` (four chords, held and overlapping),
# `lead` (one line with long notes, a run and a leap), `keys` (a root
# underneath and stabs above it) and a rewritten `arp` (a broken chord over a
# progression rather than one triad forever). The sequence patches move by
# themselves in time with the song, so two more demos hold chords (`sequence`)
# or single notes (`ostinato`) two bars each on the beat, at 120 bpm. Their
# LFOs are synced and restart with each note. Where one steps the pitch,
# `sweep` cannot read a tune from the measured note; with that route off they
# are in tune.
#
# Levelled to the house figure of -21 dB on the loudness column, which is the
# same figure every machine in the app is levelled to. Four decibels of that
# came out of the machine's own output (`kHouse` in Trinity.cpp) so that Init
# lands there too and the volume knob means the same thing here as anywhere
# else. Six patches sit one to five decibels under it and all six are made of
# things that are quiet by nature - noise through a band, and the vowel and
# sweep tables, which have less in them than a saw does. They are already at
# the top of their volume.
#
# Two of those were much further under before the filter was the problem
# rather than the level: a twelve-decibel band on nothing but noise throws
# almost all of it away, and a twenty-four decibel low-pass on noise does the
# same more slowly. Six and twelve decibels a octave respectively, and they
# came back fifteen and four decibels.
#
# Every patch but Init has eight named macros, each a few routes to the
# matrix destinations. Where a macro at full moves the level by more than about 3 dB, an amp route
# on it takes that back out. Sync resets every unison voice of an oscillator
# together, which makes a stack louder at once, so a sync macro goes on an
# oscillator with one voice. The filter drive squashes anything hotter than its own nominal
# level, so the macros leave it alone and get their edge from sync, FM, ring
# and the inserts instead. Lines under "Silent until a macro reaches them" set
# up an oscillator at level 0 for a macro to bring in. Where FM, ring or a
# pulse width can leave an offset, filter 2 is a 20 Hz high pass that takes it
# out.
#
# A macro that speeds up a synced LFO goes to its step destination (#34 to
# #36), which moves it a whole octave of note value per 0.25 of depth and
# stays on the beat. Free LFOs keep the smooth rate destination (#31 to #33).
#
# Values are in each parameter's own units; `audition params Trinity` lists
# them. A patch names only what it changes.

machine Trinity
role    pad

patch Init family=lead

patch "Saw Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Thin"
  set macro4 "Ring"
  set macro5 "Fizz"
  set macro6 "Edge"
  set macro7 "Beat"
  set macro8 "Noise"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.5
  mac2_d1  #25
  mac2_a1  0.5
  mac3_d1  #9
  mac3_a1  -0.9
  mac3_d2  #10
  mac3_a2  -0.7
  mac3_d3  #29
  mac3_a3  0.221
  mac4_d1  #19
  mac4_a1  0.35
  mac5_d1  #21
  mac5_a1  0.3
  mac6_d1  #14
  mac6_a1  0.4
  mac7_d1  #3
  mac7_a1  0.008
  mac8_d1  #18
  mac8_a1  0.15
  # Three saws, two of them a cent or two out, with the filter tracking the
  # keyboard so the top of the range does not turn to mud.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_fine        4
  o2_level       1.00
  o3_wave        #0
  o3_fine        -5
  o3_level       0.83
  f1_type        #3
  f1_freq        1800 Hz
  f1_res         0.25
  f1_key         0.8
  f1_env         0.3
  a_attack       0.008 s
  a_decay        1.2 s
  a_sustain      0.85
  a_release      0.3 s
  volume         0.36
  # Crunch first, then eighth-note echoes across the stereo field.
  insert Distortion
    drive        6
    tone         5000 Hz
    mix          0.6
    gain         -3.5 dB
  insert Delay
    time         #2
    feedback     0.35
    tone         6000 Hz
    pingpong     #1
    mix          0.25

patch "Square Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "PW"
  set macro4 "Edge"
  set macro5 "Beat"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #11
  mac3_a1  0.35
  mac3_d2  #12
  mac3_a2  -0.3
  mac4_d1  #14
  mac4_a1  0.4
  mac5_d1  #3
  mac5_a1  0.008
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #10
  mac8_a1  0.4
  # One square, one filter, one envelope, played high. If a synth cannot do
  # this it cannot do anything.
  o1_wave        #1
  o1_pw          0.5
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.45
  o2_fine        -6
  o2_level       0.64
  f1_type        #3
  f1_freq        2600 Hz
  f1_res         0.2
  f1_env         0.35
  a_attack       0.01 s
  a_decay        1 s
  a_sustain      0.8
  a_release      0.25 s
  glide          0.03 s
  volume         0.27
  # Silent until a macro reaches them.
  o3_wave        #1
  o3_coarse      #36

patch "Soft Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Edge"
  set macro3 "Bite"
  set macro4 "Body"
  set macro5 "FM"
  set macro6 "Ring"
  set macro7 "Beat"
  set macro8 "Breath"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #14
  mac2_a1  0.4
  mac3_d1  #25
  mac3_a1  0.3
  mac4_d1  #9
  mac4_a1  0.3
  mac5_d1  #21
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.5
  mac7_d1  #3
  mac7_a1  0.006
  mac8_d1  #18
  mac8_a1  0.2
  # A triangle with the corners taken off and a slow glide. For playing over
  # something rather than through it.
  o1_wave        #2
  o1_level       1.00
  o2_wave        #3
  o2_fine        7
  o2_level       0.81
  o1_drift       0.2
  f1_type        #1
  f1_freq        1600 Hz
  f1_env         0.2
  a_attack       0.06 s
  a_decay        1.5 s
  a_sustain      0.85
  a_release      0.5 s
  glide          0.09 s
  volume         0.37

patch "Wide Saws" family=lead  note=55 range=36..79 role=pad
  set macro1 "Open"
