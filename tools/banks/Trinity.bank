patch "Spiral Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Scan"
  set macro2 "Speed"
  set macro3 "Open"
  set macro4 "Res"
  set macro5 "Width"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #5
  mac1_a1  0.4
  mac1_d2  #6
  mac1_a2  -0.4
  mac2_d1  #31
  mac2_a1  0.5
  mac2_d2  #32
  mac2_a2  0.5
  mac3_d1  #23
  mac3_a1  0.35
  mac4_d1  #25
  mac4_a1  0.3
  mac5_d1  #17
  mac5_a1  0.4
  mac6_d1  #21
  mac6_a1  0.25
  mac7_d1  #19
  mac7_a1  0.3
  mac8_d1  #3
  mac8_a1  0.006
  # The spiral table on two oscillators, each scanned by its own LFO at a
  # different rate, so the colour turns over and never quite repeats in a
