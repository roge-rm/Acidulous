  mac7_a1  0.25
  mac8_d1  #21
  mac8_a1  0.2
  # A short square between a low pass and a high pass that follows the
  # note, into a dark delay that keeps going and a worn tape. The off-beat
  # chop with its echoes.
  o1_wave        #1
  o1_level       1.00
  o2_wave        #2
  o2_coarse      #12
  o2_level       0.0
  f1_type        #1
  f1_freq        2000 Hz
  f1_res         0.15
  f1_env         0.4
  f1_key         0.5
  f_decay        0.2 s
  f_sustain      0.0
  f2_type        #5
  f2_freq        250 Hz
  a_attack       0.001 s
  a_decay        0.5 s
  a_sustain      0.0
  a_release      0.15 s
  volume         1.00
  f2_key         1
  # Silent until a macro reaches them.
  o3_wave        #1
  o3_coarse      #36
  insert Delay
    time         #3
    feedback     0.4
    tone         2500 Hz
    pingpong     #0
    mix          0.25
  insert Tape
    age          0.3
    flutter      0.08
    hiss         0
    tone         7000 Hz

patch "Vowel Pluck" family=pluck  note=55 range=36..79 role=arp
  set macro1 "Open"
  set macro2 "Vowel"
  set macro3 "Res"
  set macro4 "Octave"
  set macro5 "Ring"
  set macro6 "Beat"
  set macro7 "Edge"
  set macro8 "FM"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.3
  mac2_d1  #5
  mac2_a1  0.4
  mac3_d1  #25
  mac3_a1  0.3
  mac4_d1  #10
  mac4_a1  0.3
  mac5_d1  #19
  mac5_a1  0.2
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #14
  mac7_a1  0.25
  mac8_d1  #21
  mac8_a1  0.2
  # The vowel table swept from "ah" towards "oo" on every note, with a
  # second one an octave up. A plucked note that talks.
  o1_wave        #6
  o1_pos         0.3
  o1_level       1.00
  o2_wave        #6
  o2_coarse      #36
  o2_level       1.0
  e3_attack      0.001 s
  e3_decay       0.25 s
  e3_sustain     0
  m01_src        #9
  m01_dest       #5
  m01_depth      0.5
  f1_type        #1
  f1_freq        4000 Hz
  f1_env         0.3
  f1_key         0.6
  f_decay        0.3 s
  f_sustain      0.1
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.001 s
  a_decay        0.9 s
  a_sustain      0.15
  a_release      0.25 s
  volume         1.00
  o2_pos         0.5
  # Silent until a macro reaches them.
  o3_wave        #3
  o3_coarse      #36
  send reverb    0.15

patch "Ring Pluck" family=pluck  note=60 range=36..84 role=arp
  set macro1 "Res"
  set macro2 "Ring"
  set macro3 "Dark"
  set macro4 "Octave"
  set macro5 "Metal"
  set macro6 "Beat"
  set macro7 "Edge"
  set macro8 "FM"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #25
  mac1_a1  0.3
  mac2_d1  #19
  mac2_a1  0.3
  mac3_d1  #23
  mac3_a1  -0.4
  mac4_d1  #10
  mac4_a1  0.3
  mac5_d1  #20
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #14
  mac7_a1  0.25
  mac8_d1  #21
  mac8_a1  0.2
  # A triangle ring-modulated by a sine an octave up, so the note's third
  # harmonic sits beside it, plucked. Hollow and a bit metallic.
  # Filter 2 takes out the offset the ring leaves.
  o1_wave        #2
  o1_level       0.8
  o2_wave        #3
  o2_coarse      #36
  o2_level       0.0
  ring12         0.6
  f1_type        #1
  f1_freq        1500 Hz
  f1_env         0.5
  f1_key         0.7
  f_decay        0.25 s
  f_sustain      0.1
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.001 s
  a_decay        0.6 s
  a_sustain      0.0
  a_release      0.3 s
  volume         0.94
  o1_drift       0
  o2_drift       0
  # Silent until a macro reaches them.
  o3_wave        #3
  o3_coarse      #48
  send reverb    0.15

patch "Fold Pluck" family=pluck  note=55 range=36..79 role=arp
  set macro1 "Open"
  set macro2 "Fold"
  set macro3 "Scan"
  set macro4 "Octave"
  set macro5 "Ring"
  set macro6 "Beat"
  set macro7 "Edge"
  set macro8 "FM"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.2
  mac2_d1  #5
  mac2_a1  0.3
  mac3_d1  #6
  mac3_a1  0.4
  mac4_d1  #10
  mac4_a1  0.3
  mac5_d1  #19
  mac5_a1  0.2
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #14
  mac7_a1  0.25
  mac8_d1  #21
  mac8_a1  0.2
  # The fold table folded hard at the strike and opening out to a plain
  # tone, a low pass behind it. A rubbery, buzzy pluck.
  o1_wave        #9
  o1_pos         0.0
  o1_level       1.00
  o2_wave        #2
  o2_coarse      #12
  o2_level       0.3
  e3_attack      0.001 s
  e3_decay       0.25 s
  e3_sustain     0
  m01_src        #9
  m01_dest       #5
  m01_depth      0.7
  f1_type        #3
  f1_freq        2000 Hz
  f1_env         0.4
  f1_key         0.6
  f_decay        0.4 s
  f_sustain      0.1
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.003 s
  a_decay        0.8 s
  a_sustain      0.0
  a_release      0.25 s
  volume         1.00
  # Silent until a macro reaches them.
  o3_wave        #3
  o3_coarse      #36

patch "Res Zap" family=pluck  note=55 range=36..79 role=arp
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Zap"
  set macro4 "Octave"
  set macro5 "Ring"
  set macro6 "Beat"
  set macro7 "Edge"
  set macro8 "FM"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.3
  mac2_d1  #25
  mac2_a1  0.2
  mac3_d1  #1
  mac3_a1  0.08
  mac4_d1  #10
  mac4_a1  0.3
  mac5_d1  #19
  mac5_a1  0.2
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #14
  mac7_a1  0.25
  mac8_d1  #21
  mac8_a1  0.2
  # A saw into a ringing low pass that drops four octaves in a tenth of a
  # second, and a quick fall in pitch on the front. Laser zaps you can play.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #1
  o2_coarse      #12
  o2_level       0.3
  e3_attack      0.001 s
  e3_decay       0.04 s
  e3_sustain     0
  m01_src        #9
  m01_dest       #1
  m01_depth      0.12
  f1_type        #3
  f1_freq        500 Hz
  f1_res         0.65
  f1_env         0.9
  f1_key         0.7
  f_decay        0.16 s
  f_sustain      0.0
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.001 s
  a_decay        0.8 s
  a_sustain      0.0
  a_release      0.2 s
  volume         1.00
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36

patch "Analog Strings" family=ensemble  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "Hollow"
  set macro4 "Wander"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.5
  mac2_d1  #17
  mac2_a1  0.6
  mac3_d1  #12
  mac3_a1  0.6
  mac4_d1  #31
  mac4_a1  0.8
  mac4_d2  #23
  mac4_a2  0.2
  # Saw and square a shade apart with the drift up, filtered gently and with
  # a slow sweep on the cutoff. The string machine rather than the string.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.38
  o1_drift       0.5
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.42
  o2_fine        8
  o2_level       0.82
  l1_rate        0.09 Hz
  m01_src        #13
  m01_dest       #23
  m01_depth      0.35
  f1_type        #2
  f1_freq        2000 Hz
  f1_res         0.15
  a_attack       0.5 s
  a_decay        3 s
  a_sustain      0.8
  a_release      1.6 s
  volume         0.31

patch Ensemble family=ensemble  note=55 range=36..79 role=pad
  # Six voices of unison on each of two oscillators, drifting apart at
  # different rates. The size comes from the drift and not from the detune,
  # which is the difference between an ensemble and a chorus pedal.
  o1_wave        #0
  o1_density     #5
  o1_detune      0.32
  o1_drift       0.45
  o1_level       1.00
  o2_wave        #2
  o2_density     #4
  o2_detune      0.28
  o2_drift       0.3
  o2_fine        -7
  o2_level       0.97
  f1_type        #2
  f1_freq        3200 Hz
  f1_res         0.1
  a_attack       0.35 s
  a_decay        2.5 s
  a_sustain      0.85
  a_release      1.2 s
  volume         0.38

patch "Drift Strings" family=ensemble  note=55 range=36..79 role=pad
  a_attack       0.35 s
  a_decay        2 s
  a_release      1.4 s
  a_sustain      0.85
  f1_freq        3500 Hz
  f1_res         0.05
  f1_type        #2
  l1_delay       2 s
  l1_rate        4.5 Hz
  m01_depth      0.02
  m01_dest       #1
  m01_src        #13
  m01_src2       #2
  o1_density     #1
  o1_detune      0.3
  o1_drift       0.8
  o1_level       0.95
  o2_drift       0.9
  o2_fine        -7
  o2_level       0.87
  o3_coarse      #36
  o3_drift       0.7
  o3_level       0.55
  o3_wave        #2
  volume         0.45

patch "Solo String" family=ensemble  note=60 range=48..84 role=lead
  # One voice, a slow bow on the attack and a little drift. Deliberately not
  # an ensemble: it is the patch that shows the ensemble ones are ensembles.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_fine        5
  o2_level       0.74
  o1_drift       0.3
  f1_type        #2
  f1_freq        2400 Hz
  f1_res         0.18
  f1_env         0.25
  a_attack       0.22 s
  a_decay        2 s
  a_sustain      0.85
  a_release      0.5 s
  glide          0.04 s
  volume         0.44

patch "Brass Section" family=ensemble  note=55 range=40..79 role=keys
  # The filter envelope arriving late and hard, which is what a brass attack
  # is. Three oscillators, the third an octave down for weight.
  o1_wave        #0
  o1_density     #2
  o1_detune      0.22
  o1_level       1.00
  o2_wave        #0
  o2_fine        9
  o2_level       1.00
  o3_wave        #1
  o3_coarse      #12
  o3_level       0.59
  f1_type        #3
  f1_freq        700 Hz
  f1_res         0.22
  f1_env         0.75
  f1_key         0.4
  f_attack       0.06 s
  f_decay        0.5 s
  f_sustain      0.45
  a_attack       0.04 s
  a_decay        1.5 s
  a_sustain      0.85
  a_release      0.3 s
  volume         0.40

patch "Soft Horn" family=ensemble  note=55 range=36..79 role=pad
  # The same idea with the envelope taken off and the filter left low: round
  # and slow, and it stops being brass the moment it stops being bright.
  o1_wave        #0
  o1_density     #1
  o1_level       1.00
  o2_wave        #2
  o2_fine        -5
  o2_level       0.92
  o3_wave        #3
  o3_coarse      #12
  o3_level       0.50
  f1_type        #3
  f1_freq        1100 Hz
  f1_res         0.1
  f1_env         0.2
  a_attack       0.3 s
  a_decay        2 s
  a_sustain      0.8
  a_release      0.8 s
  volume         0.35

patch Swell family=ensemble  note=55 range=36..69 role=pad
  # Nothing at all for a quarter of a second and then everything. Written
  # at 0.45 plus a 1.8 second attack it had not started by the end of a two
  # second note, which is a patch nobody can play. The amplitude
  # delay is a parameter most synths do not have and this is what it is for.
  o1_wave        #4
  o1_pos         0.45
  o1_density     #2
  o1_detune      0.3
  o1_level       1.00
  o2_wave        #0
  o2_coarse      #19
  o2_level       0.61
  a_delay        0.25 s
  a_attack       1.1 s
  a_decay        3 s
  a_sustain      0.8
  a_release      2.5 s
  f1_type        #1
  f1_freq        2600 Hz
  f1_env         0.4
  volume         0.81

patch Drone family=texture  note=55 range=36..79 role=pad
  # Three oscillators on the organ table at the octave and the fifth, no
  # envelope movement at all, and enough drift that it never quite repeats.
  o1_wave        #11
  o1_level       1.00
  o2_wave        #11
  o2_coarse      #31
  o2_level       0.75
  o3_wave        #11
  o3_coarse      #36
  o3_level       0.58
  o1_drift       0.55
  o2_drift       0.5
  o3_drift       0.6
  f1_type        #1
  f1_freq        2400 Hz
  a_attack       2 s
  a_decay        8 s
  a_sustain      0.9
  a_release      3 s
  volume         0.56

patch Air family=texture  note=55 range=36..79 role=pad
  # A high-pass at four kilohertz on almost nothing: what is left is the top
  # of the drift and the top of the noise. Sits above a mix without being
  # in it.
  o1_wave        #5
  o1_pos         0.9
  o1_density     #3
  o1_detune      0.5
  o1_drift       0.6
  o1_level       1.00
  noise          0.3
  noisecol       0.9
  # The high-pass follows the keyboard and sits far lower than it did. At a
  # fixed four kilohertz there was no note anywhere in the range - the patch
  # was a texture with no pitch, which is a fine layer and not a thing you
  # can play: twelve decibels an octave rather than twenty-four, and a
  # third of the noise. It is still airy and it now has a note in it.
  f1_type        #5
  f1_freq        600 Hz
  f1_key         0.8
  f1_res         0.2
  a_attack       1.5 s
  a_decay        4 s
  a_sustain      0.85
  a_release      3 s
  volume         0.95

patch "Noise Sweep" family=texture  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Ring"
  set macro3 "Dark"
  set macro4 "Hush"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.8
  mac2_d1  #25
  mac2_a1  0.45
  mac3_d1  #23
  mac3_a1  -0.5
  mac4_d1  #29
  mac4_a1  -0.5
  # All noise, with a resonant low-pass opening over three seconds. No
  # oscillator at all: proof the filter is an instrument on its own.
  o1_level       0.00
  o2_level       0.00
  noise          1.00
  noisecol       0.5
  f1_type        #1
  f1_freq        420 Hz
  f1_res         0.45
  f1_env         0.9
  f_attack       2.8 s
  f_decay        3 s
  f_sustain      0.9
  a_attack       0.4 s
  a_decay        4 s
  a_sustain      0.85
  a_release      2 s
  volume         1.00

patch "Sweep Down" family=texture  note=55 range=36..79 role=pad
  # A filter falling from the top of its range to the bottom over four
  # seconds, with nothing else happening. The one you put at the end of a
  # bar.
  o1_wave        #0
  o1_density     #4
  o1_detune      0.45
  o1_level       1.00
  o2_wave        #10
  o2_level       0.55
  noise          0.35
  f1_type        #3
  f1_freq        9000 Hz
  f1_res         0.45
  f1_env         -0.95
  f_attack       0.01 s
  f_decay        4 s
  f_sustain      0.0
  a_attack       0.01 s
  a_decay        5 s
  a_sustain      0.6
  a_release      1.5 s
  volume         0.42

patch "Ring Bells" family=texture  note=55 range=36..79 role=keys
  # Ring modulation between two oscillators a tritone apart, which has no
  # harmonic relationship at all and therefore sounds like metal.
  o1_wave        #3
  o1_level       0.98
  o2_wave        #3
  o2_coarse      #30
  o2_level       0.98
  ring12         0.9
  o3_wave        #7
  o3_coarse      #36
  o3_level       0.41
  f1_type        #1
  f1_freq        6000 Hz
  a_attack       0.002 s
  a_decay        2.5 s
  a_sustain      0.0
  a_release      1.2 s
  volume         0.39

patch Metallic family=texture  note=55 range=36..79 role=pad
  # The fold table warped hard through a peaking filter. Inharmonic on
  # purpose: it has a pitch but it does not have a key.
  o1_wave        #9
  o1_pos         0.8
  o1_warp        0.75
  o1_level       1.00
  o2_wave        #9
  o2_pos         0.3
  o2_coarse      #30
  o2_level       0.81
  f1_type        #11
  f1_freq        1800 Hz
  f1_res         0.6
  a_attack       0.01 s
  a_decay        3 s
  a_sustain      0.3
  a_release      1.5 s
  volume         0.33
