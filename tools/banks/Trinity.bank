  mac3_d1  #25
  mac3_a1  0.3
  mac4_d1  #21
  mac4_a1  0.3
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #9
  mac6_a1  0.3
  mac7_d1  #3
