  o3_coarse      #36
  insert Delay
    time         #3
    feedback     0.3
    tone         5000 Hz
    pingpong     #1
    mix          0.2
  send reverb    0.2

patch Tide family=pad  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Speed"
  set macro4 "Width"
  set macro5 "Ring"
  set macro6 "Sync"
  set macro7 "Air"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.3
  mac3_d1  #31
  mac3_a1  0.5
  mac4_d1  #17
  mac4_a1  0.4
  mac5_d1  #19
  mac5_a1  0.3
  mac6_d1  #14
  mac6_a1  0.3
  mac7_d1  #18
  mac7_a1  0.1
  mac8_d1  #3
  mac8_a1  -0.006
  # A resonant low pass swept up and down every ten seconds by an LFO that
  # restarts with each note, over stacked saws. Slow, like water.
  o1_wave        #0
  o1_density     #2
  o1_detune      0.25
  o1_level       1.00
  o2_wave        #0
  o2_fine        -7
  o2_level       0.7
  l1_wave        #1
  l1_rate        0.1 Hz
  m01_src        #13
  m01_dest       #23
  m01_depth      0.25
  f1_type        #3
  f1_freq        1200 Hz
  f1_res         0.5
  f1_env         0
  a_attack       0.8 s
  a_decay        3 s
  a_sustain      0.85
  a_release      2.5 s
  volume         0.34
  f2_type        #5
