patch "Chop Chords" family=sequence  note=55 range=36..79 role=sequence
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Double"
  set macro4 "Half"
  set macro5 "Octave"
  set macro6 "Ring"
  set macro7 "Beat"
  set macro8 "Sub"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.35
  mac3_d1  #34
  mac3_a1  0.25
  mac4_d1  #34
  mac4_a1  -0.25
  mac5_d1  #9
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.25
  mac7_d1  #3
  mac7_a1  0.006
  mac8_d1  #10
  mac8_a1  0.4
  # Three saws and a square an octave up, chopped into sixteenths by a
  # square LFO on the level. The slew rounds the edges so it chops without
  # clicking.
  o1_wave        #0
  o1_density     #2
  o1_detune      0.25
  o1_level       1.00
  o2_wave        #1
  o2_coarse      #36
  o2_level       0.30
  o3_wave        #3
  o3_coarse      #12
  o3_level       0.00
  f1_type        #3
