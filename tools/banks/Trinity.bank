patch "Pluck Bass" family=bass  note=36 range=24..55 role=bass
  # An octave up from the key, where this bass has its character.
  octave         1
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Edge"
  set macro4 "PW"
  set macro5 "FM"
  set macro6 "Sub"
  set macro7 "Beat"
  set macro8 "Ring"
  # Macros: each knob adds its depth to the destinations below.
