  m01_dest       #14
  m01_depth      0.5
  m02_src        #9
  m02_dest       #15
  m02_depth      0.3
  f1_type        #1
  f1_freq        4500 Hz
  f1_res         0.1
  f1_env         0
  a_attack       0.6 s
  a_decay        3 s
  a_sustain      0.85
  a_release      2.5 s
  volume         0.38
  f2_type        #5
  f2_freq        20 Hz
  # Silent until a macro reaches them.
  o3_wave        #2
  o3_coarse      #12
  send reverb    0.2

patch Swirl family=pad  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Width"
  set macro4 "PW"
  set macro5 "Ring"
  set macro6 "Sync"
  set macro7 "Octave"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.4
  mac2_d1  #25
  mac2_a1  0.3
  mac3_d1  #17
  mac3_a1  0.4
  mac4_d1  #12
  mac4_a1  0.3
  mac5_d1  #19
  mac5_a1  0.3
  mac6_d1  #14
  mac6_a1  0.3
  mac7_d1  #10
  mac7_a1  0.3
  mac8_d1  #3
  mac8_a1  -0.006
  # Stacked saws and a square through a four-stage phaser turning once a
  # bar. The pad that moves even when the chord doesn't.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.25
  o1_level       1.00
  o2_wave        #1
  o2_fine        -6
  o2_level       0.6
  f1_type        #3
