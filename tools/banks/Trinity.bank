patch "Noise Sweep" family=texture  note=55 range=36..79 role=pad
  # All noise, with a resonant low-pass opening over three seconds. No
  # oscillator at all: proof the filter is an instrument on its own.
  o1_level       0.00
  o2_level       0.00
  noise          1.00
  noisecol       0.5
  f1_type        #1
  f1_freq        420 Hz
  f1_res         0.45
