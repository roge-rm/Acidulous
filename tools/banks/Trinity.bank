  mac4_d1  #19
  mac4_a1  0.3
  mac5_d1  #17
  mac5_a1  0.4
  mac6_d1  #18
  mac6_a1  0.1
  mac7_d1  #10
  mac7_a1  0.3
  mac8_d1  #3
  mac8_a1  0.006
  # The glass table scanned end to end over six seconds by its own envelope,
