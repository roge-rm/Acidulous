  a_release      0.25 s
  volume         0.48

patch "Pluck Bass" family=bass  note=36 range=24..55 role=bass
  # Short, filtered, and with the filter envelope faster than the amplitude
  # one so the note darkens while it is still loud.
  o1_wave        #0
