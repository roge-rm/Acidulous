  m01_dest       #12
  m01_depth      0.25
  f1_type        #3
  f1_freq        3000 Hz
  f1_res         0.2
  f1_key         0
  f1_env         0.25
  f_attack       0.4 s
  f_decay        2 s
  f_sustain      0.6
  f2_type        #5
  f2_freq        20 Hz
  a_attack       0.2 s
  a_decay        2 s
  a_sustain      0.9
  a_release      1.2 s
  volume         0.33
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36
  insert Chorus
    voices       #2
    rate         #14
    depth        0.3
    spread       0.9
    drift        0.1
    mix          0.25
  send reverb    0.2

