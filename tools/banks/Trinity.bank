  a_sustain      0.0
  a_release      0.3 s
  volume         0.83

patch "Pluck Wide" family=keys  note=55 range=40..79 role=arp
  # Eight voices of unison detuned hard, plucked. Density is the thing this
  # machine has that a three-oscillator synth normally does not, and this is
  # the patch that is only that.
  o1_wave        #0
  o1_density     #7
  o1_detune      0.55
  o1_level       1.00
  o2_wave        #0
  o2_density     #5
  o2_detune      0.4
  o2_coarse      #36
  o2_level       0.57
  f1_type        #3
  f1_freq        3800 Hz
  f1_res         0.2
  f1_env         0.45
  a_attack       0.002 s
  a_decay        0.9 s
  a_sustain      0.0
  a_release      0.4 s
  f_decay        0.35 s
  f_sustain      0.0
  volume         0.98

patch "Warm Pad" family=pad  note=55 range=36..79 role=pad
  # Three saws, gently detuned, a long way open and slow at both ends. The
  # one a bank is incomplete without.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.3
  o1_level       1.00
  o2_wave        #0
  o2_fine        -8
  o2_density     #2
  o2_level       1.00
  o3_wave        #2
  o3_coarse      #12
  o3_level       0.57
  o1_drift       0.25
  f1_type        #3
