  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "Hollow"
  set macro4 "Wander"
  set macro5 "Octave"
  set macro6 "Res"
  set macro7 "Air"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.5
  mac2_d1  #17
  mac2_a1  0.6
  mac3_d1  #12
  mac3_a1  0.6
  mac4_d1  #31
  mac4_a1  0.8
  mac4_d2  #23
  mac4_a2  0.2
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #25
  mac6_a1  0.3
  mac7_d1  #18
  mac7_a1  0.1
  mac8_d1  #3
  mac8_a1  0.006
  # Saw and square a shade apart with the drift up, filtered gently and with
  # a slow sweep on the cutoff. The string machine rather than the string.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.38
  o1_drift       0.5
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.42
  o2_fine        8
  o2_level       0.82
  l1_rate        0.09 Hz
  m01_src        #13
  m01_dest       #23
  m01_depth      0.35
  f1_type        #2
  f1_freq        2000 Hz
  f1_res         0.15
  a_attack       0.5 s
  a_decay        3 s
  a_sustain      0.8
  a_release      1.6 s
  volume         0.31
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36

patch Ensemble family=ensemble  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "Wander"
  set macro4 "Octave"
  set macro5 "Res"
  set macro6 "Air"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.4
  mac2_d1  #17
  mac2_a1  0.4
  mac3_d1  #6
  mac3_a1  0.3
  mac3_d2  #23
  mac3_a2  -0.1
  mac4_d1  #10
  mac4_a1  0.4
  mac5_d1  #25
  mac5_a1  0.3
  mac6_d1  #18
  mac6_a1  0.1
  mac7_d1  #19
  mac7_a1  0.25
  mac8_d1  #3
  mac8_a1  0.006
  # Six voices of unison on each of two oscillators, drifting apart at
  # different rates. The size comes from the drift and not from the detune,
  # which is the difference between an ensemble and a chorus pedal.
  o1_wave        #0
  o1_density     #5
  o1_detune      0.32
  o1_drift       0.45
  o1_level       1.00
  o2_wave        #2
  o2_density     #4
  o2_detune      0.28
  o2_drift       0.3
  o2_fine        -7
  o2_level       0.97
  f1_type        #2
  f1_freq        3200 Hz
  f1_res         0.1
  a_attack       0.35 s
  a_decay        2.5 s
  a_sustain      0.85
  a_release      1.2 s
  volume         0.38
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36

patch "Chamber Strings" family=ensemble  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Bow"
  set macro3 "Width"
  set macro4 "Octave"
  set macro5 "Res"
  set macro6 "Air"
  set macro7 "Edge"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #6
  mac2_a1  0.4
  mac3_d1  #17
  mac3_a1  0.4
  mac4_d1  #10
  mac4_a1  0.4
  mac5_d1  #25
  mac5_a1  0.3
  mac6_d1  #18
  mac6_a1  0.1
  mac7_d1  #15
  mac7_a1  0.3
  mac8_d1  #3
  mac8_a1  0.006
  # Fewer players: a saw of two voices and the bow table beside it, less
  # detune, a quicker bow and the vibrato sooner.
  o1_wave        #0
  o1_density     #2
  o1_detune      0.15
  o1_drift       0.25
  o1_level       1.00
  o2_wave        #26
  o2_pos         0.4
  o2_fine        4
  o2_level       0.7
  f1_type        #2
  f1_freq        3200 Hz
  f1_res         0.15
  f1_key         0.5
  f1_env         0
  l1_rate        5.5 Hz
  l1_delay       0.4 s
  m01_src        #13
  m01_dest       #1
  m01_depth      0.002
  a_attack       0.15 s
  a_decay        2 s
  a_sustain      0.9
  a_release      0.8 s
  volume         0.35
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36
  send reverb    0.10

patch "Slow Strings" family=ensemble  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "Low"
  set macro4 "Edge"
  set macro5 "Res"
  set macro6 "Air"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.4
  mac2_d1  #17
  mac2_a1  0.2
  mac3_d1  #9
  mac3_a1  0.4
  mac4_d1  #15
