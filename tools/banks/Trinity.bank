  m01_depth      0.35
  m02_src        #14
  m02_dest       #6
  m02_depth      -0.3
  f1_type        #3
  f1_freq        4000 Hz
  f1_res         0.1
  f1_env         0
  a_attack       0.8 s
  a_decay        3 s
  a_sustain      0.85
  a_release      2.5 s
  volume         0.59
