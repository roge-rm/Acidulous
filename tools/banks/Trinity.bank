  a_sustain      0.7
  a_release      0.2 s
  volume         1.00

patch "Wide Bass" family=bass  note=36 range=24..55 role=bass
  # Unison on the bass, which normally muddies it: the filter is low enough
  # that the detuning stays under the note instead of smearing across it.
  o1_wave        #0
