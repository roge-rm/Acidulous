  mac8_d1  #3
  mac8_a1  0.006
  # Saws and the nasal table through two band passes side by side, a
  # formant each, with a slow LFO pulling them apart and back so the vowel
  # moves while the chord is held.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.25
  o1_drift       0.3
  o1_level       1.00
