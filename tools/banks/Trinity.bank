patch "Synth Strings" family=ensemble  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "PW"
  set macro4 "Octave"
  set macro5 "Res"
  set macro6 "Air"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #17
  mac2_a1  0.4
  mac3_d1  #12
  mac3_a1  0.25
  mac4_d1  #10
  mac4_a1  0.4
  mac5_d1  #25
  mac5_a1  0.3
  mac6_d1  #18
  mac6_a1  0.1
  mac7_d1  #19
  mac7_a1  0.25
  mac8_d1  #3
  mac8_a1  0.006
  # A saw of three voices and a pulse whose width swings slowly, into a
  # chorus. Filter 2 takes out the offset the pulse width leaves.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.38
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.35
  o2_density     #2
