patch "Chain FM" family=bass  note=36 range=24..55 role=bass
  # An octave up from the key, where this bass has its character.
  octave         1
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "FM"
  set macro4 "Upper FM"
  set macro5 "Grit"
  set macro6 "Body"
  set macro7 "Beat"
  set macro8 "Ring"
  # Macros: each knob adds its depth to the destinations below.
