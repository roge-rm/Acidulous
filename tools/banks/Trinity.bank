patch Shimmer family=pad  note=55 range=36..79 role=pad
  set macro1 "Sparkle"
  set macro2 "Scan"
  set macro3 "Root"
  set macro4 "Ring"
  set macro5 "FM"
  set macro6 "Beat"
  set macro7 "Air"
  set macro8 "Thin"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #9
  mac1_a1  0.3
  mac2_d1  #5
  mac2_a1  0.3
  mac2_d2  #6
  mac2_a2  0.2
  mac3_d1  #10
  mac3_a1  0.3
  mac4_d1  #19
  mac4_a1  0.3
  mac5_d1  #21
  mac5_a1  0.2
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #18
  mac7_a1  0.08
  mac8_d1  #23
  mac8_a1  0.3
  # The glass table an octave and a fifth up over a root that stays the
  # loudest thing in it. Written the other way round the played pitch was
  # thirty decibels under the twelfth above it, which is a patch that
  # transposes what you play.
  # The glass table an octave and a fifth up over a root, with both
  # drifting. High, bright, and thin enough to sit over anything.
  o1_wave        #5
  o1_pos         0.5
  o1_level       1.00
  o2_wave        #5
  o2_coarse      #43
  o2_pos         0.75
  o2_level       0.45
  # The sine sits on the note rather than an octave over it, so there is a
  # fundamental under the shimmer. Without one the patch played an octave
  # above whatever key you pressed, which a shimmer may do to a reverb tail
  # but should not do to a keyboard.
  o3_wave        #3
  o3_level       0.55
  o1_drift       0.5
  o2_drift       0.45
  # The high-pass follows the keyboard. Fixed at 400 Hz it removed the note
  # itself over the bottom half of the range - eighty decibels down at the
  # lowest, with the sixth harmonic the loudest thing in it - so the patch
  # played a different pitch depending where you put your hand.
  f1_type        #5
  f1_freq        120 Hz
  f1_key         0.9
  a_attack       1.6 s
  a_decay        4 s
  a_sustain      0.85
  a_release      3.5 s
  volume         0.73

patch Halo family=pad  note=55 range=36..79 role=pad
  set macro1 "Shine"
  set macro2 "Bloom"
  set macro3 "Ring"
  set macro4 "Glow"
  set macro5 "Dark"
  set macro6 "Octave"
  set macro7 "Beat"
  set macro8 "Air"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #21
  mac1_a1  0.3
  mac2_d1  #22
  mac2_a1  0.3
  mac3_d1  #19
  mac3_a1  0.3
  mac4_d1  #10
  mac4_a1  0.3
  mac5_d1  #23
  mac5_a1  -0.4
  mac6_d1  #9
  mac6_a1  0.3
  mac7_d1  #3
  mac7_a1  0.006
  mac8_d1  #18
  mac8_a1  0.08
  # A sine with an octave above it as a modulator, the index rising over
  # three seconds, and a high twelfth drifting a few cents sharp. FM that
  # shimmers instead of clangs. Filter 2 takes out the offset FM leaves.
  # It plays an octave up from the key, where a sine pad sits better.
  o1_wave        #3
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #36
  o2_level       0.00
  o3_wave        #3
  o3_coarse      #43
  o3_fine        4
  o3_level       0.15
  o3_drift       0.4
  fm21           0.12
  e3_attack      3 s
  e3_decay       4 s
  e3_sustain     0.8
  e3_release     3 s
  m01_src        #9
  m01_dest       #21
  m01_depth      0.2
  f1_type        #1
  f1_freq        9000 Hz
  f1_env         0
  f2_type        #5
  f2_freq        20 Hz
  a_attack       1.2 s
  a_decay        3 s
  a_sustain      0.85
  a_release      3 s
  volume         0.38
  octave         1
  insert Chorus
    voices       #1
    rate         #14
    depth        0.3
    spread       0.9
    mix          0.20
  send reverb    0.08

patch Mist family=pad  note=55 range=36..79 role=pad
  set macro1 "Air"
  set macro2 "Bright"
  set macro3 "Thin"
  set macro4 "Width"
  set macro5 "Glass"
  set macro6 "Ring"
  set macro7 "Scan"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #18
  mac1_a1  0.2
  mac2_d1  #24
  mac2_a1  0.4
  mac3_d1  #23
  mac3_a1  0.4
  mac3_d2  #29
  mac3_a2  0.313
  mac4_d1  #17
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.3
  mac7_d1  #6
  mac7_a1  0.4
  mac8_d1  #3
  mac8_a1  0.006
  # A wide stack of saws and the glass table an octave up, high-passed with
  # the keyboard, with white noise in the same band. More air than note,
  # but the note is still there at the bottom of the range.
  o1_wave        #0
  o1_density     #5
  o1_detune      0.35
  o1_level       0.7
  o2_wave        #5
