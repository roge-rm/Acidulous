patch "Ring Bass" family=bass  note=36 range=24..55 role=bass
  # Ring modulation between the first two oscillators, which is metal rather
  # than harmony, kept low enough to still be a bass.
  o1_wave        #3
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #19
  o2_level       1.00
  ring12         0.65
