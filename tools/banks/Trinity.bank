patch "Glass Scan" family=pad  note=55 range=36..79 role=pad
  set macro1 "Scan"
  set macro2 "Bright"
  set macro3 "FM"
  set macro4 "Ring"
  set macro5 "Width"
  set macro6 "Air"
  set macro7 "Octave"
