  f1_env         0
  f2_type        #1
  f2_freq        9000 Hz
  a_attack       1 s
  a_decay        3 s
  a_sustain      0.85
  a_release      3 s
  volume         0.64
  insert Chorus
    voices       #1
    rate         #14
    depth        0.4
    spread       1
    mix          0.4
  send reverb    0.3

patch "Breath Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Tone"
  set macro2 "Open"
  set macro3 "Res"
  set macro4 "Fifth"
  set macro5 "Ring"
  set macro6 "Beat"
  set macro7 "FM"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #8
  mac1_a1  0.3
  mac2_d1  #23
  mac2_a1  0.3
  mac3_d1  #25
  mac3_a1  0.25
  mac4_d1  #9
  mac4_a1  0.3
  mac5_d1  #19
  mac5_a1  0.3
  mac6_d1  #3
  mac6_a1  0.006
  mac7_d1  #21
  mac7_a1  0.3
  mac8_d1  #10
  mac8_a1  0.3
  # Mostly noise, with just enough oscillator under it to give the noise a
  # pitch. The band-pass is what makes it a note rather than a hiss.
  o1_wave        #3
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #31
  o2_level       0.60
  noise          1.00
