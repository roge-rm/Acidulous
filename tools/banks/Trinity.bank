  mac5_d1  #25
  mac5_a1  0.3
  mac6_d1  #18
  mac6_a1  0.1
  mac7_d1  #19
  mac7_a1  0.25
  mac8_d1  #4
  mac8_a1  0.006
  # A long bow in and a long fade out, and the filter opening a little
  # behind the level. A triangle an octave down warms the bottom.
  o1_wave        #0
