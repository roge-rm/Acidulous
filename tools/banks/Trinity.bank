patch "Glass Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Scan"
  set macro2 "Bright"
  set macro3 "Res"
  set macro4 "Ring"
  set macro5 "FM"
  set macro6 "Beat"
