  m01_depth      0.4
  m01_dest       #5
  m01_src        #13
  m02_depth      0.15
  m02_dest       #23
  m02_src        #14
  m03_depth      0.5
  m03_dest       #5
  m03_src        #2
  m04_depth      0.45
  m04_dest       #23
  m04_src        #3
  o1_level       0.75
  o1_pos         0.2
  o1_wave        #5
  o2_fine        6
  o2_pos         0.6
  o2_wave        #4

patch "Bell Keys"
  a_attack       0.002 s
