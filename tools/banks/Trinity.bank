patch "Gate Pad" family=pad  note=55 range=36..79 role=pad
  set macro1 "Open"
  set macro2 "Res"
  set macro3 "Width"
  set macro4 "Ring"
  set macro5 "Sync"
  set macro6 "Air"
  set macro7 "Octave"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.4
  mac2_d1  #25
  mac2_a1  0.35
  mac3_d1  #17
  mac3_a1  0.3
  mac4_d1  #19
  mac4_a1  0.3
  mac5_d1  #14
  mac5_a1  0.3
  mac6_d1  #18
  mac6_a1  0.1
  mac7_d1  #10
  mac7_a1  0.35
  mac8_d1  #3
  mac8_a1  0.006
  # A square LFO in sixteenths, restarting with each note, opens and shuts
  # the low pass, so a held chord plays as a rhythm. The slew softens the
  # edges so it chops without clicking.
  o1_wave        #0
  o1_density     #3
  o1_detune      0.25
  o1_level       1.00
  o2_wave        #1
  o2_fine        6
  o2_level       0.7
  l1_wave        #4
  l1_sync        #3
  l1_slew        0.35
  m01_src        #13
  m01_dest       #23
  m01_depth      0.4
  f1_type        #3
  f1_freq        900 Hz
  f1_res         0.25
  f1_env         0
  a_attack       0.05 s
  a_decay        2 s
  a_sustain      0.9
  a_release      0.8 s
  volume         0.37
  f2_type        #5
  f2_freq        20 Hz
  # Silent until a macro reaches them.
