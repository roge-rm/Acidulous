patch Grind family=bass  note=36 range=24..55 role=bass
  # An octave up from the key, where this bass has its character.
  octave         1
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Crush"
  set macro4 "Dust"
  set macro5 "Sub"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #28
  mac3_a1  0.6
  mac4_d1  #6
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.5
  mac6_d1  #21
  mac6_a1  0.4
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #3
  mac8_a1  0.008
  # A saw and the dust table through the crush stage and a fuzz. For something
  # harsh.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #28
  o2_pos         0.4
  o2_fine        6
  o2_level       0.7
  o3_wave        #3
  o3_coarse      #12
  f1_type        #3
  f1_freq        900 Hz
  f1_res         0.3
  f1_env         0.3
  f1_drivetype   #5
  f1_drive       0.4
  a_attack       0.004 s
  a_decay        1.2 s
  a_sustain      0.8
  a_release      0.15 s
  voicemode      #1
  volume         0.60
  insert Distortion
    mode         #1
    drive        15
    tone         7000 Hz
    mix          0.5
    gain         -5.2 dB

patch "Square Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "PW"
  set macro4 "Edge"
  set macro5 "Beat"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Octave"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.35
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #11
  mac3_a1  0.35
  mac3_d2  #12
  mac3_a2  -0.3
  mac4_d1  #14
  mac4_a1  0.4
  mac5_d1  #3
  mac5_a1  0.008
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #10
  mac8_a1  0.4
  # One square, one filter, one envelope, played high. If a synth cannot do
  # this it cannot do anything.
  o1_wave        #1
  o1_pw          0.5
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.45
  o2_fine        -6
  o2_level       0.64
  f1_type        #3
  f1_freq        2600 Hz
  f1_res         0.2
  f1_env         0.35
  a_attack       0.01 s
  a_decay        1 s
  a_sustain      0.8
  a_release      0.25 s
  glide          0.03 s
  volume         0.27
  # Silent until a macro reaches them.
  o3_wave        #1
  o3_coarse      #36

patch "Saw Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Thin"
  set macro4 "Ring"
  set macro5 "Fizz"
  set macro6 "Edge"
  set macro7 "Beat"
  set macro8 "Noise"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.5
  mac2_d1  #25
  mac2_a1  0.5
  mac3_d1  #9
  mac3_a1  -0.9
  mac3_d2  #10
  mac3_a2  -0.7
  mac3_d3  #29
  mac3_a3  0.221
  mac4_d1  #19
  mac4_a1  0.35
  mac5_d1  #21
  mac5_a1  0.3
  mac6_d1  #14
  mac6_a1  0.4
  mac7_d1  #3
  mac7_a1  0.008
  mac8_d1  #18
  mac8_a1  0.15
  # Three saws, two of them a cent or two out, with the filter tracking the
  # keyboard so the top of the range does not turn to mud.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #0
  o2_fine        4
  o2_level       1.00
  o3_wave        #0
  o3_fine        -5
  o3_level       0.83
  f1_type        #3
  f1_freq        1800 Hz
  f1_res         0.25
  f1_key         0.8
  f1_env         0.3
  a_attack       0.008 s
  a_decay        1.2 s
  a_sustain      0.85
  a_release      0.3 s
  volume         0.39
  # Crunch first, then eighth-note echoes across the stereo field.
  insert Distortion
    drive        6
    tone         5000 Hz
    mix          0.6
    gain         -3.5 dB
  insert Delay
    time         #2
    feedback     0.35
    tone         6000 Hz
    pingpong     #1
    mix          0.25

patch "Fifth Lead" family=lead  note=67 range=48..91 role=lead
