patch "Wobble Knob" family=bass  note=36 range=24..55 role=bass
  set macro1 "Wobble"
  set macro2 "Speed"
  set macro3 "Open"
  set macro4 "Bite"
  set macro5 "Edge"
  set macro6 "Sub"
  set macro7 "FM"
  set macro8 "Beat"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #27
  mac1_a1  1
  mac2_d1  #31
  mac2_a1  0.25
  mac3_d1  #23
  mac3_a1  0.35
