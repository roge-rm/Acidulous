  mac6_a1  0.008
  mac7_d1  #10
  mac7_a1  0.3
  mac8_d1  #18
  mac8_a1  0.1
  # A saw ring-modulated by a sine an octave and a fifth up, the ring
  # falling back after the attack, so each note clangs and then sings.
  o1_wave        #0
  o1_level       1.00
  o2_wave        #3
  o2_coarse      #43
  o2_level       0.00
  ring12         0.3
  e3_attack      0.001 s
  e3_decay       0.4 s
  e3_sustain     0
  m01_src        #9
  m01_dest       #19
