  mac1_a1  0.3
  mac2_d1  #23
  mac2_a1  0.3
  mac3_d1  #5
  mac3_a1  0.4
  mac4_d1  #9
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.5
  mac6_d1  #14
  mac6_a1  0.4
