  mac1_d2  #29
  mac1_a2  0.353
  mac2_d1  #6
  mac2_a1  0.5
  mac3_d1  #23
  mac3_a1  0.35
  mac4_d1  #25
  mac4_a1  0.3
  mac5_d1  #17
  mac5_a1  0.4
  mac6_d1  #19
  mac6_a1  0.3
  mac7_d1  #18
  mac7_a1  0.1
  mac8_d1  #3
  mac8_a1  0.006
