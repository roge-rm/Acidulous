patch "Hard Sync" family=lead  note=67 range=48..91 role=lead
  set macro1 "Tear"
  set macro2 "Open"
  set macro3 "Bite"
  set macro4 "Edge"
  set macro5 "Body"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Sub"
  # Macros: each knob adds its depth to the destinations below.
