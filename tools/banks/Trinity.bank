  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #19
  mac6_a1  0.2
  mac7_d1  #25
  mac7_a1  0.4
  mac8_d1  #3
  mac8_a1  -0.006
  # The choir table on two oscillators a few cents apart with a slow vowel
