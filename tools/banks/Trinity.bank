patch Ensemble family=ensemble  note=55 range=36..79 role=pad
  # Six voices of unison on each of two oscillators, drifting apart at
  # different rates. The size comes from the drift and not from the detune,
  # which is the difference between an ensemble and a chorus pedal.
  o1_wave        #0
  o1_density     #5
  o1_detune      0.32
  o1_drift       0.45
  o1_level       1.00
  o2_wave        #2
  o2_density     #4
  o2_detune      0.28
  o2_drift       0.3
  o2_fine        -7
  o2_level       0.97
  f1_type        #2
  f1_freq        3200 Hz
  f1_res         0.1
  a_attack       0.35 s
  a_decay        2.5 s
  a_sustain      0.85
  a_release      1.2 s
  volume         0.38

patch "Brass Section" family=ensemble  note=55 range=40..79 role=keys
  # The filter envelope arriving late and hard, which is what a brass attack
  # is. Three oscillators, the third an octave down for weight.
  o1_wave        #0
  o1_density     #2
  o1_detune      0.22
  o1_level       1.00
  o2_wave        #0
  o2_fine        9
  o2_level       1.00
  o3_wave        #1
  o3_coarse      #12
  o3_level       0.59
  f1_type        #3
  f1_freq        700 Hz
  f1_res         0.22
  f1_env         0.75
  f1_key         0.4
  f_attack       0.06 s
  f_decay        0.5 s
  f_sustain      0.45
  a_attack       0.04 s
  a_decay        1.5 s
  a_sustain      0.85
  a_release      0.3 s
  volume         0.40

patch "Soft Horn" family=ensemble  note=55 range=36..79 role=pad
  # The same idea with the envelope taken off and the filter left low: round
  # and slow, and it stops being brass the moment it stops being bright.
  o1_wave        #0
  o1_density     #1
  o1_level       1.00
  o2_wave        #2
  o2_fine        -5
  o2_level       0.92
  o3_wave        #3
  o3_coarse      #12
  o3_level       0.50
  f1_type        #3
  f1_freq        1100 Hz
  f1_res         0.1
  f1_env         0.2
  a_attack       0.3 s
  a_decay        2 s
  a_sustain      0.8
  a_release      0.8 s
  volume         0.35

patch "Analog Strings" family=ensemble  note=55 range=36..79 role=pad
  set macro1 "Bright"
  set macro2 "Width"
  set macro3 "Hollow"
  set macro4 "Wander"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
