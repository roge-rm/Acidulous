  f1_res         0.1
  f1_env         0
  a_attack       0.5 s
  a_decay        3 s
  a_sustain      0.85
  a_release      2 s
  volume         0.38
  f2_type        #5
  f2_freq        20 Hz
  # Silent until a macro reaches them.
  o3_wave        #0
  o3_coarse      #36
