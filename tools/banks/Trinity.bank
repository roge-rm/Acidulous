  a_release      0.2 s
  volume         0.62

patch "Square Bass" family=bass  note=36 range=24..55 role=bass
  # A hollow square with the pulse width just off centre and no resonance at
  # all. The plain one, which every bank needs and few have.
  o1_wave        #1
  o1_pw          0.38
  o1_level       1.00
  o2_wave        #1
  o2_pw          0.5
  o2_coarse      #12
