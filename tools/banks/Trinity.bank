  mac6_a1  0.008
  mac7_d1  #10
  mac7_a1  0.3
  mac8_d1  #18
  mac8_a1  0.1
  # A saw ring-modulated by a sine an octave and a fifth up, the ring
  # falling back after the attack, so each note clangs and then sings.
  o1_wave        #0
