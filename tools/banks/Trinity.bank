  a_release      0.2 s
  a_sustain      0.85
  f1_freq        7000 Hz
  glide          0.12 s
  m01_depth      0.7
  m01_dest       #14
  m01_src        #2
  m02_depth      0.3
  m02_dest       #23
  m02_src        #4
  o1_level       1.00
  o1_sync        0.25
  o2_fine        5
  o2_level       0.49
  o2_wave        #1
  voicemode      #2
  volume         0.45

patch "Hard Sync" family=lead  note=67 range=48..91 role=lead
  set macro1 "Tear"
  set macro2 "Open"
  set macro3 "Bite"
  set macro4 "Edge"
  set macro5 "Body"
  set macro6 "FM"
  set macro7 "Ring"
  set macro8 "Sub"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #3
  mac1_a1  0.25
  mac2_d1  #23
  mac2_a1  0.3
  mac3_d1  #25
  mac3_a1  0.35
  mac4_d1  #14
  mac4_a1  0.4
  mac5_d1  #8
  mac5_a1  0.4
  mac6_d1  #21
  mac6_a1  0.3
  mac7_d1  #19
  mac7_a1  0.5
  mac8_d1  #10
  mac8_a1  0.4
  # Oscillator two hard-synced to oscillator one and tuned a long way above
  # it, so its pitch becomes a timbre. The envelope sweeps it.
  o1_wave        #0
  o1_level       0.82
  o2_wave        #0
  o2_sync        1
  o2_hard        1
  o2_coarse      #43
  o2_level       1.00
  f1_type        #2
  f1_freq        4000 Hz
  f1_res         0.15
  f1_env         0.4
  a_attack       0.005 s
  a_decay        1 s
  a_sustain      0.8
  a_release      0.2 s
  volume         0.52
  # Silent until a macro reaches them.
  o3_wave        #1
  o3_coarse      #12

patch "Drift Lead" family=lead  note=67 range=48..91 role=lead
  set macro1 "Open"
  set macro2 "Bite"
  set macro3 "Soft"
  set macro4 "Beat"
  set macro5 "FM"
  set macro6 "Ring"
  set macro7 "Sub"
  set macro8 "Noise"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #23
  mac1_a1  0.3
  mac2_d1  #25
  mac2_a1  0.4
  mac3_d1  #24
  mac3_a1  -0.5
  mac4_d1  #3
  mac4_a1  0.01
  mac5_d1  #21
  mac5_a1  0.3
  mac6_d1  #19
  mac6_a1  0.5
  mac7_d1  #10
  mac7_a1  0.4
  mac8_d1  #18
  mac8_a1  0.15
  # A saw and a triangle drifting apart and back, a slow vibrato, and tape to
  # wear the edges.
  o1_wave        #0
  o1_level       1.00
  o1_drift       0.7
  o2_wave        #2
  o2_fine        -6
  o2_level       0.7
  o2_drift       0.7
  o3_wave        #1
  o3_coarse      #12
  l1_rate        4.5 Hz
  l1_delay       0.6 s
  m01_src        #13
  m01_dest       #1
  m01_depth      0.003
  f1_type        #3
  f1_freq        2200 Hz
  f1_res         0.2
  f1_env         0.25
  f1_key         0.5
  a_attack       0.01 s
  a_decay        1.2 s
  a_sustain      0.85
  a_release      0.3 s
  voicemode      #2
  glide          0.06 s
  volume         0.4
  insert Tape
    wow          0.1
    flutter      0.08
    drive        0.4
    tone         9000 Hz
    hiss         0
    age          0.3

patch "Soft Flute" family=lead  note=67 range=48..91 role=lead
  set macro1 "Breath"
  set macro2 "Open"
  set macro3 "Tone"
  set macro4 "Octave"
  set macro5 "Reed"
