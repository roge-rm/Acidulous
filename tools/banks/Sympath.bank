# Sympath - plucked strings over a buzzing bridge.
#
# Each note is a string lying over a wide, curved bridge. Once it swings far
# enough it strikes the bridge, and every strike rings it: a bright buzz on
# every cycle that lasts as long as the string swings wide enough to reach.
# `bridge` is how much, `curve` how wide a swing it takes.
#
# Under the played strings lie sympathetic strings tuned to `sa` (the tonic)
# and `scale`, which ring on the notes of the scale. `chikari` strikes the
# drone strings with each note. A tanpura plucks its four strings by itself
# through a `cycle` of beats while a note is held, its first string set by
# `first`. With one voice, `meend` slides from note to note; `gamak` (and
# the mod wheel) shakes the note, and pressure pulls the string up.
#
# Families: sitar, tanpura, veena, shamisen, bridge.

machine Sympath
role tune

patch Init family=sitar note=61 range=48..84

patch Sitar family=sitar note=61 range=48..84 role=lead
  # One string, sliding between notes, the sympathetic strings ringing under it.
  voices         #0
  meend          120 ms
  tarbs          0.6

patch "Sitar Chikari" family=sitar note=61 range=48..84 role=lead
  # Each note struck with the drone strings, as a phrase ends.
  voices         #0
  meend          120 ms
  chikari        0.5

patch "Sitar Gamak" family=sitar note=61 range=48..84 role=lead
  # Notes shaken fast and wide.
  voices         #0
  meend          80 ms
  gamak          0.5

patch "Bright Sitar" family=sitar note=64 range=48..88 role=lead
  # A hard plectrum near the bridge, a strong buzz.
  voices         #0
  meend          100 ms
  pluck          0.85
  position       0.07
  bridge         0.85

patch "Sitar Kafi" family=sitar note=61 range=48..84 role=lead
  # The sympathetic strings tuned to a minor-sounding scale.
  voices         #0
  meend          140 ms
  scale          #2
  tarbs          0.8

patch "Sitar Bhairav" family=sitar note=61 range=48..84 role=lead
  # Flat second and sixth in the sympathetic strings.
  voices         #0
  meend          140 ms
  scale          #5
  tarbs          0.8

patch "Sitar Chords" family=sitar note=61 range=48..84 role=chord
  # Four strings at once, no slides.
  tarbs          0.5
  sustain        0.6

patch Tanpura family=tanpura note=49 range=36..60 role=drone
  # Pa, Sa, Sa and low Sa, plucked in turn while the note's held.
  model          #1

patch "Tanpura Ma" family=tanpura note=49 range=36..60 role=drone
  # The first string tuned to Ma, for ragas without Pa.
  model          #1
  first          #1

patch "Tanpura Ni" family=tanpura note=49 range=36..60 role=drone
  # The first string tuned to Ni.
  model          #1
  first          #2

patch "Slow Tanpura" family=tanpura note=49 range=36..60 role=drone
  # Eight beats a cycle, the strings ringing long.
  model          #1
  cycle          #3
  sustain        0.75

patch "Quick Tanpura" family=tanpura note=49 range=36..60 role=drone
  # Two beats a cycle.
  model          #1
  cycle          #0
  sustain        0.4

patch "High Tanpura" family=tanpura note=61 range=48..72 role=drone
  # A smaller tanpura, an octave up.
  model          #1
  bright         0.6

patch "Soft Tanpura" family=tanpura note=49 range=36..60 role=drone
  # Less of the buzz: round and calm.
  model          #1
  bridge         0.3
  bright         0.35

patch Veena family=veena note=50 range=36..79 role=lead
  # Plucked with the nail, sliding along the frets.
  model          #2
  voices         #0
  meend          150 ms

patch "Veena Tala" family=veena note=50 range=36..79 role=lead
  # The side strings struck with each note.
  model          #2
  voices         #0
  meend          150 ms
  chikari        0.6

patch "Veena Gamak" family=veena note=50 range=36..79 role=lead
  # Deep, slow shakes of the note.
  model          #2
  voices         #0
  meend          200 ms
  gamak          0.6

patch "Low Veena" family=veena note=43 range=31..67 role=bass
  # The low strings, warm and long.
  model          #2
  bright         0.35
  sustain        0.7

patch "Veena Chords" family=veena note=50 range=36..79 role=chord
  # Several strings at once.
  model          #2
  pluck          0.35

patch Shamisen family=shamisen note=57 range=45..81 role=tune
  # A big plectrum striking string and skin together.
  model          #3

patch "Shamisen Sawari" family=shamisen note=57 range=45..81 role=tune
  # The low string tuned to A and buzzing on the neck under every A and E.
  model          #3
  sa             #9
  tarbs          1

patch "Soft Shamisen" family=shamisen note=57 range=45..81 role=tune
  # Played with the fingers: no snap.
  model          #3
  pluck          0.1
  tarbs          0.4

patch "Shamisen Slide" family=shamisen note=57 range=45..81 role=lead
  # One string, sliding between notes.
  model          #3
  voices         #0
  meend          90 ms
  sustain        0.7

patch "Low Shamisen" family=shamisen note=50 range=40..72 role=tune
  # The thick-necked kind, lower and longer.
  model          #3
  sustain        0.75
  bright         0.4

patch "Plain Bridge" family=bridge note=55 range=40..84 role=tune
  # The sitar's string with a sharp-edged bridge: no buzz at all.
  bridge         0
  tarbs          0.4

patch "Grazing Bridge" family=bridge note=55 range=40..84 role=tune
  # A low curve: even soft notes buzz.
  bridge         0.8
  curve          0

patch "Heavy Buzz" family=bridge note=50 range=36..79 role=tune
  # As much bridge as there is.
  bridge         1
  curve          0.1
  volume         0.6

patch "Sympathy Only" family=bridge note=61 range=48..84 role=pad
  # Short notes and long sympathetic strings: the scale rings on behind.
  sustain        0.15
  tarbs          1
  scale          #6

patch "Buzz Bass" family=bridge note=37 range=28..55 role=bass
  # A low string, the bridge buzzing hard.
  model          #2
  bridge         0.9
