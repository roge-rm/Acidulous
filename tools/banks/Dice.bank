  mac4_d2  #15
  mac4_a2  0.06
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Darker"
  mac6_d1  #12
  mac6_a1  -0.3
  set macro7 "Peak"
  mac7_d1  #13
  mac7_a1  0.5
  mac7_d2  #15
  mac7_a2  -0.049
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.3
  mac8_d2  #15
  mac8_a2  -0.086

patch Pitched family=tone
  # The whole loop down a fourth, and a few cents under, without touching the
  # rate: `pitch` moves the read speed of every slice together, so the loop
  # gets longer and darker in the way tape does, while `rate` alone would
  # have done it without the transposition being the point.
  slices         #14
  pitch          -5
  fine           -8 cents
  gate           1.0
  volume         1.03
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.069
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  mac2_d2  #15
  mac2_a2  -0.068
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.23
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.165
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Darker"
  mac6_d1  #12
  mac6_a1  -0.3
  set macro7 "Peak"
  mac7_d1  #13
  mac7_a1  0.5
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.346

