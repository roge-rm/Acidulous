# Dice - twenty-six patches, voiced against the debug build.
#
# A slicer's patches are not sounds. Every other bank here stores a voice;
# this one stores a *way of treating a loop you supply*. Mount a different
# break and every patch still means the same thing - which is why there are
# twenty-six and not fifty: the machine has five dice and four cut controls,
# and a bank that sweeps each probability across its range would be thirty
# near-duplicates of one drum loop.
#
# So each patch does something you can name. The `dice` family turns exactly
# one control up and leaves the rest alone, because a probability you cannot
# hear in isolation is a probability nobody will ever set.
#
# The harness mounts two bars at 120 bpm with real onsets, so `cut #0` has
# something to detect and slicing is being tested rather than the fallback
# that divides evenly.
#
# Stepped parameters are written as `#n`, where n is the value:
# `#n` is the *step index*, not the value, and it bites wherever a stepped
# parameter does not start at zero: `slices` runs 2..16, so sixteen slices is
# `#14`; `stutterdiv` runs 2..8, so an eight-stroke roll is `#6`; `jumprange`
# runs 1..12, so a full octave is `#11`.
#   cut        #0 at the loop's own onsets  #1 on an even grid
#   dir        #0 forwards  #1 reversed
#   hold       #0 free  #1 seeded, so every pass is identical
#   filtertype #0 LP6 #1 LP12 #2 LP18 #3 LP24  #4 HP6 ... #7 HP24
#              #8 BP6 #9 BP12 #10 notch #11 peak
#
# A per-slice `decay` of 4 s means *no* decay - the top of the range is the
# off position, so a loop played straight is not faded slice by slice.
#
# Families: straight, dice, perform, tone, slice.
#
# Every patch but Init has eight macros. The first five are the dice, the
# same on every patch: each takes its die from where the patch has it to
# certainty (drop to 0.6), or, where the patch already has it at certainty,
# back to none (Settle, Forwards, Smooth, Steady). The last three are named
# for the family. Their destinations by step:
#   #1 swap  #2 reverse  #3 stutter  #4 drop  #5 jump  #6 times  #7 up to
#   #8 seed  #9 slices  #10 gate  #11 rate  #12 cutoff  #13 reso  #14 drive
#   #15 volume  #16 pan  #17 accent  #18 pitch
# The volume routes keep each macro within about a decibel of the patch.
#
# The demo plays the loop straight through, each slice where the machine cut
# it, so the dice are heard against the loop they change. `material swing`
# (92 bpm, swung, room tone ahead and a tail past the bar) is the check pass
# for cutting and follow.

machine Dice

patch Init family=straight

patch Straight family=straight
  # The loop reproduced as faithfully as a slicer can: sixteen pieces cut at
  # its own transients, nothing rolled, every slice running to its own end.
  # This is the one to hear the break itself on, and the one every other
  # patch here is a departure from.
  slices         #14
  gate           1.0
  volume         1.01
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.08
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.208
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.158
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Tighter"
  mac6_d1  #10
  mac6_a1  -0.75
  mac6_d2  #15
  mac6_a2  0.327
  set macro7 "Darker"
  mac7_d1  #12
  mac7_a1  -0.45
  mac7_d2  #13
  mac7_a2  0.15
  mac7_d3  #15
  mac7_a3  0.083
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.34

patch Grid family=straight
  # The same loop cut by the clock rather than by the music. Sixteen equal
  # pieces, so a hit that did not fall exactly on a sixteenth is split across
  # two slices and its attack arrives in the middle of one. Worth having in
  # the bank because it is what every slicer that cannot find onsets does,
  # and the difference is the argument for the detector.
  cut            #1
  slices         #14
  gate           1.0
  volume         1.08
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.256
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Tighter"
  mac6_d1  #10
  mac6_a1  -0.75
  mac6_d2  #15
  mac6_a2  0.28
  set macro7 "Darker"
  mac7_d1  #12
  mac7_a1  -0.45
  mac7_d2  #13
  mac7_a2  0.15
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.34

patch "Half Time" family=straight
  # Rate at a half: each slice plays at half speed, which is an octave down
  # and twice as long. The groove does not change - the tempo of the material
  # inside it does.
  slices         #6
  rate           0.5
  gate           1.0
  volume         0.80
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.07
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  mac2_d2  #15
  mac2_a2  0.041
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.076
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Tighter"
  mac6_d1  #10
  mac6_a1  -0.75
  mac6_d2  #15
  mac6_a2  0.467
  set macro7 "Darker"
  mac7_d1  #12
  mac7_a1  -0.45
  mac7_d2  #13
  mac7_a2  0.15
  mac7_d3  #15
  mac7_a3  0.075
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.254

patch "Double Time" family=straight
  # The other way: twice the speed, an octave up, each slice done in half the
  # time. Thin and hurried, and the gaps it leaves are where a fill goes.
  slices         #14
  rate           2.0
  gate           0.9
  volume         1.50
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.091
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.308
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Tighter"
  mac6_d1  #10
  mac6_a1  -0.65
  set macro7 "Darker"
  mac7_d1  #12
  mac7_a1  -0.45
  mac7_d2  #13
  mac7_a2  0.15
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.462

patch "Back to Front" family=straight
  # Every slice played backwards, in order: the loop keeps its groove, but
  # each hit swells up into where its attack was. Nothing is rolled, so it is
  # the same every pass. A reversed slice is not stretched, so away from the
  # loop's own tempo it plays faster or slower like tape.
  slices         #14
  reverse        1.0
  gate           1.0
  volume         1.03
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.066
  set macro2 "Forwards"
  mac2_d1  #2
  mac2_a1  -1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  0.101
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.161
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Tighter"
  mac6_d1  #10
  mac6_a1  -0.5
  mac6_d2  #15
  mac6_a2  0.313
  set macro7 "Darker"
  mac7_d1  #12
  mac7_a1  -0.45
  mac7_d2  #13
  mac7_a2  0.15
  mac7_d3  #15
  mac7_a3  0.108
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.349

patch Swap family=dice
  # Swap alone, at certainty. Every trigger plays *some* slice, never the one
  # the pad names, so the same sixteen hits come out in a different order
  # every bar. The material is untouched; only the sequence is rolled.
  slices         #14
  swap           1.0
  gate           1.0
  volume         1.01
  set macro1 "Settle"
  mac1_d1  #1
  mac1_a1  -1.0
  mac1_d2  #15
  mac1_a2  0.091
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.203
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.055
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.184
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  mac7_d3  #15
  mac7_a3  -0.244
  set macro8 "Tighter"
  mac8_d1  #10
  mac8_a1  -0.75
  mac8_d2  #15
  mac8_a2  0.327

patch Reverse family=dice
  # Reverse alone. Half the hits are played tail-first, so each one is a swell
  # that arrives *at* its transient instead of starting on it - the sound of a
  # cymbal sucked backwards, on a snare.
  slices         #14
  reverse        0.5
  gate           1.0
  volume         1.01
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.048
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  0.5
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.197
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.176
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  mac5_d2  #15
  mac5_a2  0.052
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.221
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  mac7_d3  #15
  mac7_a3  -0.25
  set macro8 "Tighter"
  mac8_d1  #10
  mac8_a1  -0.75
  mac8_d2  #15
  mac8_a2  0.327

patch Stutter family=dice
  # Stutter alone: about half the hits repeat four times inside their own
  # length, so the loop keeps its shape and its length while individual hits
  # ratchet. A stutter is the same piece again, not the next one.
  slices         #14
  stutter        0.55
  stutterdiv     #2
  gate           1.0
  volume         0.68
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.039
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  mac2_d2  #15
  mac2_a2  0.216
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  0.45
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.114
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  mac7_d3  #15
  mac7_a3  -0.051
  set macro8 "Tighter"
  mac8_d1  #10
  mac8_a1  -0.75
  mac8_d2  #15
  mac8_a2  0.324

patch Drop family=dice
  # Drop alone. Half the triggers play nothing at all, and because the roll is
  # per trigger the holes are somewhere else next time round. This is the die
  # that makes a loop breathe.
  #
  # A half rather than a third, because a third was not enough to be the point
  # of the patch: over the two bars bank_test plays, the dice rolled no drops
  # at all and it came out byte-identical to Straight next door. A patch called
  # Drop should be unmistakably dropping.
  slices         #14
  drop           0.5
  gate           1.0
  volume         1.01
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.16
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.215
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.25
  mac4_d2  #15
  mac4_a2  0.078
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  mac5_d2  #15
  mac5_a2  -0.048
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.209
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  mac7_d3  #15
  mac7_a3  -0.209
  set macro8 "Tighter"
  mac8_d1  #10
  mac8_a1  -0.75
  mac8_d2  #15
  mac8_a2  0.327

patch "Off Pitch" family=dice
  # Jump again, but only two semitones either way: hits come out a little
  # sharp or flat, like a record with a warp in it, rather than in another
  # register.
  slices         #14
  jump           0.6
  jumprange      #1
  gate           1.0
  volume         1.02
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.085
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.213
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.169
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  0.4
  mac5_d2  #15
  mac5_a2  0.053
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.246
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  mac7_d3  #15
  mac7_a3  -0.264
  set macro8 "Tighter"
  mac8_d1  #10
  mac8_a1  -0.75
  mac8_d2  #15
  mac8_a2  0.32

patch Jump family=dice
  # Jump alone, a full octave either way. Half the hits arrive transposed, so
  # a drum loop turns melodic without anything having been tuned - and the
  # pitch moves the slice's length with it, which is what keeps it musical
  # rather than just detuned.
  slices         #14
  jump           0.5
  jumprange      #11
  gate           1.0
  volume         1.02
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.056
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.193
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.208
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  0.5
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.22
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  mac7_d3  #15
  mac7_a3  -0.23
  set macro8 "Tighter"
  mac8_d1  #10
  mac8_a1  -0.75
  mac8_d2  #15
  mac8_a2  0.32

patch Fill family=perform
  # The end of a bar. Three dice at once and the gate short, which is the
  # difference between a fill and a mess: the hits are cut before they can
  # smear into each other, so what is left is dense but still legible.
  slices         #14
  swap           0.6
  stutter        0.5
  stutterdiv     #4
  jump           0.3
  jumprange      #6
  gate           0.45
  drive          0.2
  volume         0.79
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  0.4
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  0.6
  mac2_d2  #15
  mac2_a2  0.09
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  0.5
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  0.7
  mac5_d2  #15
  mac5_a2  0.094
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  0.043
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  set macro8 "Faster"
  mac8_d1  #11
  mac8_a1  0.25
  mac8_d2  #15
  mac8_a2  0.057

patch Roll family=perform
  # Every hit an eight-stroke roll. Stutter at certainty with the division at
  # its maximum, gated short so each stroke is an attack rather than a piece
  # of the loop - a drum roll built out of whatever you mounted.
  slices         #6
  stutter        1.0
  stutterdiv     #6
  gate           0.3
  drive          0.15
  volume         1.01
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  mac1_d2  #15
  mac1_a2  -0.057
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  0.6
  mac2_d2  #15
  mac2_a2  0.11
  set macro3 "Smooth"
  mac3_d1  #3
  mac3_a1  -1.0
  mac3_d2  #15
  mac3_a2  0.179
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.144
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  set macro7 "Rolls"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.67
  set macro8 "Faster"
  mac8_d1  #11
  mac8_a1  0.25

patch Ghost family=perform
  # The loop as ghost notes: the gate low enough that a slice is its attack
  # and almost none of its body, a few of them dropped, and the level down.
  # What survives is the rhythm without the weight, which is what you put
  # under something else.
  slices         #14
  gate           0.18
  drop           0.2
  volume         1.50
  set macro1 "Swap"
