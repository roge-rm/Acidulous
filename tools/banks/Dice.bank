  mac3_a2  -0.2
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
