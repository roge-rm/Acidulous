patch Scratch family=perform
  # Half the hits backwards, half of them a few semitones off, a few doubled
  # and the gate short, so the loop jerks back and forth like a record pushed
  # around under a hand.
  slices         #14
  reverse        0.5
  jump           0.5
  jumprange      #2
  stutter        0.25
  stutterdiv     #0
  gate           0.2
  drive          0.15
  volume         1.36
  set macro1 "Swap"
  mac1_d1  #1
