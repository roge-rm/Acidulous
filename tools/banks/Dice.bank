patch Scattered family=slice
  # The per-slice settings, which is the one thing in this machine that does
  # *not* port to another loop - and the reason only this family uses
  # them. Alternate pads hard left and right, two of them pitched, so
  # the loop spreads across the image and picks up a melody it did not have.
  slices         #6
  gate           1.0
  s00_pan        -0.8
  s01_pan        0.8
  s02_pan        -0.5
  s03_pan        0.5
  s03_pitch      7
  s04_pan        -0.8
  s05_pan        0.8
  s05_pitch      -5
  s06_pan        -0.5
  s07_pan        0.5
  volume         0.98
  set macro1 "Swap"
