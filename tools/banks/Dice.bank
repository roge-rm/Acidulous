patch Held family=perform
  # The dice, held. Hold on means the rolls come from the slice and the seed
  # alone, so this pattern is elaborate and *identical every pass* - which is
  # the difference between a machine that surprises you and one you can
  # record. Change `seed` for a different permanent pattern.
  slices         #14
  hold           #1
  seed           #11
  swap           0.45
  reverse        0.25
  stutter        0.3
  gate           0.8
  volume         1.12
  set macro1 "Swap"
  mac1_d1  #1
