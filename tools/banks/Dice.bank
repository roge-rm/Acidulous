patch Dust family=tone
  # Low-passed hard and resonant, with a third of the hits dropped: the loop
  # heard through a wall, in another room, some time ago. The resonance is
  # what stops it being merely quiet.
  cut            #1
  slices         #12
  cutoff         2200 Hz
  resonance      0.15
  filtertype     #1
  drop           0.3
  swap           0.35
  reverse        0.2
  gate           0.45
  volume         1.50
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  0.65
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  0.4
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.231
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.3
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Darker"
  mac6_d1  #12
  mac6_a1  -0.3
  set macro7 "Peak"
  mac7_d1  #13
  mac7_a1  0.5
  set macro8 "Dirt"
  mac8_d1  #14
  mac8_a1  0.6
  mac8_d2  #15
  mac8_a2  -0.32

patch Driven family=tone
  # The drive stage hard. Until today this knob bought dirt by spending
  # level - `tanh(x * k) / sqrt(k)` is a ceiling that falls as you turn it -
  # so the patch is voiced against the corrected law and is thick without
  # being quiet.
  slices         #14
  drive          0.7
  cutoff         9000 Hz
  gate           1.0
  volume         0.58
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
  set macro3 "Stutter"
  mac3_d1  #3
  mac3_a1  1.0
  mac3_d2  #15
  mac3_a2  -0.111
