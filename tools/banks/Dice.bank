  mac3_a2  -0.117
  set macro4 "Drop"
  mac4_d1  #4
  mac4_a1  0.6
  mac4_d2  #15
  mac4_a2  0.131
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.167
  set macro7 "Tighter"
  mac7_d1  #10
  mac7_a1  -0.75
  mac7_d2  #15
  mac7_a2  0.347
  set macro8 "Lower"
  mac8_d1  #18
  mac8_a1  -0.5
  mac8_d2  #15
  mac8_a2  0.055

patch "Tuned Slices" family=slice
  # Each of eight slices tuned to a step of a minor pentatonic, so the loop
  # plays a tune as it goes round. Follow keeps the lengths, so only the
  # pitch moves. Which hit lands on which note depends on the loop.
  slices         #6
  gate           1.0
  s01_pitch      3
  s02_pitch      5
  s03_pitch      7
  s04_pitch      10
  s05_pitch      7
  s06_pitch      5
  s07_pitch      -2
  volume         0.9
  set macro1 "Swap"
  mac1_d1  #1
