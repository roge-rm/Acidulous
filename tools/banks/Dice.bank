patch "Triplet Feel" family=perform
  # Eight slices on the grid, a beat each, and every one stuttered three
  # times: each beat plays its first third three times over, so the loop
  # comes out in triplets.
  cut            #1
  slices         #6
  stutter        1.0
  stutterdiv     #1
  gate           1.0
  volume         0.74
  set macro1 "Swap"
  mac1_d1  #1
  mac1_a1  1.0
  set macro2 "Reverse"
  mac2_d1  #2
  mac2_a1  1.0
