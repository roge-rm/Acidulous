patch Backspin family=slice
  # The last two of eight slices reversed, every time, so the end of the bar
  # sucks back into the downbeat. The dice can reverse a slice but not
  # choose which; this is the one that does.
  slices         #6
  gate           1.0
  s06_dir        #1
  s07_dir        #1
  volume         0.9
  set macro1 "Swap"
  mac1_d1  #1
