patch "Live Hold" family=live input=break
  # Reading the live ring rather than the file: the last several seconds of
  # whatever went in, granulated while more arrives. On a phone that is you.
  #
  # **It used to ship with `freeze` on**, and a frozen ring at load time has
  # nothing in it - the patch was silent until something had been captured,
  # which is not a patch, it is a trap. Freeze is a performance control: you
  # hit it when there is something worth holding. The long buffer here is
  # what gives you time to decide.
  source         #1
  capture        1
  buffer         6 s
  size           150 ms
  density        55 /s
  spray          0.3
  panspread      0.8
  ampattack      0.3 s
  amprelease     2.5 s
  volume         1.13
  set macro1 "Feedback"
  mac1_d1  #26
  mac1_a1  0.4
  set macro2 "Further Back"
  mac2_d1  #1
  mac2_a1  0.4
  mac2_d2  #29
  mac2_a2  0.247
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  set macro4 "Longer"
  mac4_d1  #6
  mac4_a1  0.194
  mac4_d2  #29
  mac4_a2  -0.428
  set macro5 "Scatter"
  mac5_d1  #12
  mac5_a1  0.4
  mac5_d2  #29
  mac5_a2  0.102
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  mac6_d2  #29
  mac6_a2  0.173
  set macro7 "Bloom"
  mac7_d1  #13
  mac7_a1  0.6
  mac7_d2  #29
  mac7_a2  -0.214
  set macro8 "Narrow"
  mac8_d1  #16
  mac8_a1  -0.5
  mac8_d2  #17
  mac8_a2  -0.6

patch "Eat Itself" family=live input=break
  # The output goes back into the ring, so the cloud granulates itself
  # granulating itself. Kept under the point where it runs away.
  source         #1
  capture        1
  feedback       0.72
  size           140 ms
  density        52 /s
  spray          0.35
  panspread      0.85
  cutoff         6000 Hz
  ampattack      0.3 s
  amprelease     3.5 s
