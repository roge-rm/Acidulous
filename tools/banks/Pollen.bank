patch Telephone family=texture
  # Band-passed and bit-reduced together: a narrow, gritty middle with little
  # above or below it.
  #
  # The band was at 1400 Hz and twelve decibels a slope, which on a drum
  # break is a telephone and on a plucked chord is nothing at all - the seed's
  # energy is almost entirely under 600 Hz, and the patch measured fourteen
  # decibels below the rest of the bank with the volume knob already at its
  # ceiling. Down to 800 and a gentler slope. The same mistake as Mosaic's
  # Clav, which is worth knowing: a band-pass has to be told where the
  # material *is*.
  filtertype     #8
  cutoff         700 Hz
  resonance      0.35
  bits           6
  size           110 ms
  density        60 /s
  spray          0.3
  drive          0.75
  ampattack      0.08 s
  amprelease     1.2 s
  volume         1.50
  set macro1 "Crush"
  mac1_d1  #18
  mac1_a1  -0.333
  mac1_d2  #29
  mac1_a2  -0.324
  set macro2 "Rate"
  mac2_d1  #19
  mac2_a1  0.5
  set macro3 "Wobble"
  mac3_d1  #20
  mac3_a1  0.5
  set macro4 "Gentle"
  mac4_d1  #25
  mac4_a1  -0.3
  mac4_d2  #29
  mac4_a2  0
  set macro5 "Dark"
  mac5_d1  #21
  mac5_a1  -0.219
  mac5_d2  #29
  mac5_a2  -0.593
  set macro6 "Ring"
  mac6_d1  #22
  mac6_a1  0.5
  mac6_d2  #21
  mac6_a2  -0.15
  set macro7 "Spray"
  mac7_d1  #3
  mac7_a1  0.4
  mac7_d2  #29
  mac7_a2  -0.563
  set macro8 "Thicker"
  mac8_d1  #8
  mac8_a1  0.201
  mac8_d2  #29
  mac8_a2  -0.487

