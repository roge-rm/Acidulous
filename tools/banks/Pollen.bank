  set macro2 "Thicker"
  mac2_d1  #8
  mac2_a1  0.201
  mac2_d2  #29
  mac2_a2  -0.161
  set macro3 "Octave Up"
  mac3_d1  #11
  mac3_a1  0.5
  mac3_d2  #29
  mac3_a2  -0.072
  set macro4 "Spray"
  mac4_d1  #3
