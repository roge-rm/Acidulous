# Pollen - fifty-four patches in seven families.
#
# Granular, both ways round: a cloud per note over a buffer, and that buffer
# can be what is coming into the phone. Ninety-six grains across eight voices,
# stereo, with four things that are this machine's own -
#
#   **Pollination.** A dying grain seeds a child near where it was, mutated,
#   and that child seeds another, to a depth you set. A cloud *grows* from a
#   seed rather than being a fixed spray. `bloom` is how likely, `mutate` how
#   far, `generations` how deep - and `bloom` at nothing means the other two
#   do nothing at all, which is worth knowing before you conclude they are
#   broken.
#
#   **Harmonic scatter.** The per-grain pitch random is quantised: to octaves,
#   fifths, a triad, or a scale. `spread` is the size of the random and
#   `scatter` is what it lands on - so `scatter` alone does nothing, for the
#   same reason.
#
#   **Onset snap.** The buffer's transients are found, and `snap` pulls grains
#   onto them. The harness mounts two bars of a drum break with real onsets,
#   so there is something to snap to.
#
#   **Self-seeding.** The output goes back into the live ring, and the texture
#   eats itself.
#
# **The live patches declare `input break`.** Reading the live ring with
# nothing on the input bus is silence - -200 dB - so they are auditioned
# against the same drum loop the others granulate. On a phone that input is
# you.
#
# Patches set only how the buffer is played, so every one works on whatever
# file is loaded (on the norns too, where the file is loaded by hand).
#
# Stepped parameters are written as `#n`:
#   window    #0 Hann  #1 Tukey  #2 percussive  #3 reversed
#   scatter   #0 free  #1 octaves  #2 fifths  #3 triad  #4 in scale
#   scale     #1 Dorian  #9 major pentatonic (the list the modifiers use); key #0 is C
#   source    #0 the mounted file  #1 the live ring
#   filtertype #0 LP6 #1 LP12 #2 LP18 #3 LP24  #4 HP6 ... #7 HP24
#              #8 BP6 #9 BP12 #10 notch #11 peak
#
# Families: cloud 8, pitch 9, stretch 6, bloom 8, rhythm 8, texture 8, live 7.
# The stretch family walks through the file slower or faster than it was
# recorded, at the key's pitch.
#
# Every patch but Init carries eight named macros. Destinations are numbered
# as in Pollen.h's MacroDest: #1 position, #2 scan, #3 spray, #4 snap,
# #5 reverse, #6 size, #7 size spread, #8 density, #9 jitter, #10 skew,
# #11 pitch (24 semitones a unit), #12 scatter amount, #13 bloom, #14 drift,
# #15 mutate, #16 pan spread, #17 width, #18 bits, #19 rate, #20 wobble,
# #21 cutoff, #22 resonance, #23 attack, #24 release, #25 drive,
# #26 feedback, #27 thru, #28 velocity, #29 volume. Each family has its own
# set of eight. A macro whose knob has no room left goes the other way under
# the opposite name (Thinner, Shorter, Bright, Narrow, Bare...). Where a
# macro at full moves the level by more than 1 dB, a volume route takes it
# back out.
#
# Values are in each parameter's own units; `audition params Pollen` lists
# them. A patch names only what it changes.

machine Pollen
material seed
# A melody rather than one held note: one note is what one note sounds
# like, and a bank can pass that patch by patch and still be the same
# sound all the way down.
role    tune

patch Init family=cloud

patch Drift family=cloud
  # The plain one: a medium cloud wandering slowly through the buffer. What
  # the rest of the bank is heard against.
  size           150 ms
  density        50 /s
  jitter         0.35
  spray          0.25
  scan           0.02
  panspread      0.7
  ampattack      0.6 s
  amprelease     2.5 s
  volume         0.66
  set macro1 "Thicker"
  mac1_d1  #8
  mac1_a1  0.231
  mac1_d2  #29
  mac1_a2  -0.201
  set macro2 "Longer"
  mac2_d1  #6
  mac2_a1  0.194
  mac2_d2  #8
  mac2_a2  -0.15
  mac2_d3  #29
  mac2_a3  -0.136
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  mac3_d2  #29
  mac3_a2  -0.052
  set macro4 "Wander"
  mac4_d1  #2
  mac4_a1  0.05
  set macro5 "Wide"
  mac5_d1  #16
  mac5_a1  0.3
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  set macro7 "Bloom"
  mac7_d1  #13
  mac7_a1  0.7
  set macro8 "Swell"
  mac8_d1  #23
  mac8_a1  0.25
  mac8_d2  #24
  mac8_a2  0.15
  mac8_d3  #29
  mac8_a3  0.196

patch Mist family=cloud
  # Grains too small and too many to hear separately: the break stops being a
  # break and becomes a continuous haze of its own timbre.
  size           45 ms
  sizespread     0.4
  density        200 /s
  jitter         0.5
  spray          0.5
  window         #0
  panspread      0.9
  ampattack      0.8 s
  amprelease     3 s
  volume         0.64
  set macro1 "Thinner"
  mac1_d1  #8
  mac1_a1  -0.25
  mac1_d2  #29
  mac1_a2  0.377
  set macro2 "Longer"
  mac2_d1  #6
  mac2_a1  0.2
  mac2_d2  #8
  mac2_a2  -0.15
  mac2_d3  #29
  mac2_a3  -0.099
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  set macro4 "Wander"
  mac4_d1  #2
  mac4_a1  0.05
  set macro5 "Narrow"
  mac5_d1  #16
  mac5_a1  -0.5
  mac5_d2  #17
  mac5_a2  -0.6
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  set macro7 "Bloom"
  mac7_d1  #13
  mac7_a1  0.7
  set macro8 "Swell"
  mac8_d1  #23
  mac8_a1  0.25
  mac8_d2  #24
  mac8_a2  0.15
  mac8_d3  #29
  mac8_a3  0.242

patch Boulders family=cloud
  # The other end: long grains, sparse enough that each one arrives as a
  # recognisable chunk of the source.
  #
  # Six a second rather than three. At three, with grains most of half a
  # second long, the tail is lumpy at a quarter-second scale - long enough
  # gaps between grains that a render ending on a grain's onset is six
  # decibels up on the quarter second before it, which is what bank_test's
  # runaway check looks for. The check is right to look: a cloud whose tail
  # grows is usually feedback. This one just needed to be less sparse than
  # the point where one grain is the whole sound.
  size           380 ms
  sizespread     0.15
  density        6 /s
  jitter         0.3
  spray          0.03
  window         #1
  ampattack      0.2 s
  amprelease     2 s
  volume         0.61
  set macro1 "Thicker"
  mac1_d1  #8
  mac1_a1  0.25
  mac1_d2  #29
  mac1_a2  -0.193
  set macro2 "Shorter"
  mac2_d1  #6
  mac2_a1  -0.2
  mac2_d2  #8
  mac2_a2  0.15
  mac2_d3  #29
  mac2_a3  0.253
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  set macro4 "Wander"
  mac4_d1  #2
  mac4_a1  0.05
  set macro5 "Wide"
  mac5_d1  #16
  mac5_a1  0.5
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  set macro7 "Bloom"
  mac7_d1  #13
  mac7_a1  0.7
  set macro8 "Swell"
  mac8_d1  #23
  mac8_a1  0.25
  mac8_d2  #24
  mac8_a2  0.15

patch Shiver family=cloud
  # Short grains with the birth timer at its most irregular. Nothing lands
  # where you expect it to, which is the difference between a texture and a
  # tremble.
  size           45 ms
  sizespread     0.6
  density        190 /s
  jitter         0.65
  spray          0.15
  panspread      0.8
  ampattack      0.05 s
  amprelease     1.2 s
  volume         0.71
  set macro1 "Thinner"
  mac1_d1  #8
  mac1_a1  -0.25
  mac1_d2  #29
  mac1_a2  0.312
  set macro2 "Longer"
  mac2_d1  #6
  mac2_a1  0.2
  mac2_d2  #8
  mac2_a2  -0.15
  mac2_d3  #29
  mac2_a3  -0.122
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  set macro4 "Wander"
  mac4_d1  #2
  mac4_a1  0.05
  set macro5 "Narrow"
  mac5_d1  #16
  mac5_a1  -0.5
  mac5_d2  #17
  mac5_a2  -0.6
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  set macro7 "Bloom"
