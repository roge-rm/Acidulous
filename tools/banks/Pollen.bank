  mac3_a1  0.4
  mac3_d2  #29
  mac3_a2  0.142
  set macro4 "Longer"
  mac4_d1  #6
  mac4_a1  0.2
  mac4_d2  #29
  mac4_a2  -0.424
  set macro5 "Scatter"
  mac5_d1  #12
  mac5_a1  0.4
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  mac6_d2  #29
  mac6_a2  0.12
  set macro7 "Bloom"
