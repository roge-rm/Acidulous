# Pollen - thirty-five patches and an Init, voiced against the debug build.
#
# Granular, both ways round: a cloud per note over a buffer, and that buffer
# can be what is coming into the phone. Ninety-six grains across eight voices,
# stereo, with four things that are this machine's own -
#
#   **Pollination.** A dying grain seeds a child near where it was, mutated,
#   and that child seeds another, to a depth you set. A cloud *grows* from a
#   seed rather than being a fixed spray. `bloom` is how likely, `mutate` how
#   far, `generations` how deep - and `bloom` at nothing means the other two
#   do nothing at all, which is worth knowing before you conclude they are
#   broken.
#
#   **Harmonic scatter.** The per-grain pitch random is quantised: to octaves,
#   fifths, a triad, or a scale. `spread` is the size of the random and
#   `scatter` is what it lands on - so `scatter` alone does nothing, for the
#   same reason.
#
#   **Onset snap.** The buffer's transients are found, and `snap` pulls grains
#   onto them. The harness mounts two bars of a drum break with real onsets,
#   so there is something to snap to.
#
#   **Self-seeding.** The output goes back into the live ring, and the texture
#   eats itself.
#
# **The live patches declare `input break`.** Reading the live ring with
# nothing on the input bus is silence - -200 dB - so they are auditioned
# against the same drum loop the others granulate. On a phone that input is
# you.
#
# Stepped parameters are written as `#n`:
#   window    #0 Hann  #1 Tukey  #2 percussive  #3 reversed
#   scatter   #0 free  #1 octaves  #2 fifths  #3 triad  #4 in scale
#   scale     #1 Dorian (the list the eventors use); key #0 is C
#   source    #0 the mounted file  #1 the live ring
#   filtertype #0 LP6 #1 LP12 #2 LP18 #3 LP24  #4 HP6 ... #7 HP24
#              #8 BP6 #9 BP12 #10 notch #11 peak
#
# Families: cloud, pitch, bloom, rhythm, texture, live.
#
# Values are in each parameter's own units; `audition params Pollen` lists
# them. A patch names only what it changes.

machine Pollen
material seed
# A melody rather than one held note: one note is what one note sounds
# like, and a bank can pass that patch by patch and still be the same
# sound all the way down.
role    tune

patch Init family=cloud

patch Drift family=cloud
  # The plain one: a medium cloud wandering slowly through the buffer. What
  # the rest of the bank is heard against.
  size           150 ms
  density        50 /s
  jitter         0.35
  spray          0.25
  scan           0.02
  panspread      0.7
  ampattack      0.6 s
  amprelease     2.5 s
  volume         0.66

patch Mist family=cloud
  # Grains too small and too many to hear separately: the break stops being a
  # break and becomes a continuous haze of its own timbre.
  size           45 ms
  sizespread     0.4
  density        200 /s
  jitter         0.5
  spray          0.5
  window         #0
  panspread      0.9
  ampattack      0.8 s
  amprelease     3 s
  volume         0.64

patch Boulders family=cloud
  # The other end: long grains, sparse enough that each one arrives as a
  # recognisable chunk of the source.
  #
  # Six a second rather than three. At three, with grains most of half a
  # second long, the tail is lumpy at a quarter-second scale - long enough
  # gaps between grains that a render ending on a grain's onset is six
  # decibels up on the quarter second before it, which is what bank_test's
  # runaway check looks for. The check is right to look: a cloud whose tail
  # grows is usually feedback. This one just needed to be less sparse than
  # the point where one grain is the whole sound.
  size           380 ms
  sizespread     0.15
  density        6 /s
  jitter         0.3
  spray          0.03
  window         #1
  ampattack      0.2 s
  amprelease     2 s
  volume         0.61

patch Shiver family=cloud
  # Short grains with the birth timer at its most irregular. Nothing lands
  # where you expect it to, which is the difference between a texture and a
  # tremble.
  size           45 ms
  sizespread     0.6
  density        190 /s
  jitter         0.65
  spray          0.15
  panspread      0.8
  ampattack      0.05 s
  amprelease     1.2 s
  volume         0.71

patch Stillness family=cloud
  # The read point fixed and the grains long: one moment of the break held
  # open and looked at. Spray is what stops it being a loop of one buffer.
  position       0.34
  scan           0
  spray          0.02
  size           380 ms
  density        8 /s
  jitter         0.1
  window         #1
  ampattack      1.2 s
  amprelease     4 s
  volume         0.97

patch "Chord Dust" family=pitch
  # The pitch random quantised to a triad, so a spray that would be a smear
  # lands as a chord instead. This is the one to hear the idea on.
  spread         14 st
  scatter        #3
  size           130 ms
  density        60 /s
  jitter         0.4
  spray          0.3
  panspread      0.8
  ampattack      0.4 s
  amprelease     2.5 s
  volume         0.68

patch Octaves family=pitch
  # The same spray snapped to octaves only: as wide as the machine gets and
  # still consonant, because octaves cannot be wrong.
  spread         24 st
  scatter        #1
  size           150 ms
  density        55 /s
  spray          0.3
  panspread      0.85
  ampattack      0.5 s
  amprelease     3 s
  volume         0.78

patch Fifths family=pitch
  # Snapped to fifths. Hollow where Octaves is solid - a stack of fifths has
  # no third in it to say whether it is happy.
  spread         19 st
  scatter        #2
  size           120 ms
  density        85 /s
  spray          0.28
  panspread      0.8
  ampattack      0.45 s
  amprelease     2.8 s
  volume         0.68

patch "Dorian Spray" family=pitch
  # Snapped to a scale rather than an interval, so the cloud is in a key and
  # a line played over it agrees with it.
  spread         20 st
  scatter        #4
  scale          #1
  key            #0
  size           120 ms
  density        65 /s
  jitter         0.45
  spray          0.35
  panspread      0.85
  ampattack      0.5 s
  amprelease     3 s
  volume         0.80

patch Descent family=pitch
  # Pitched down a fifth with the read point running forward: the cloud falls
  # while the buffer moves on under it.
  pitch          -7 st
  scan           0.35
  size           170 ms
  density        50 /s
  spray          0.2
  spread         5 st
  scatter        #1
  ampattack      0.3 s
  amprelease     2.4 s
  volume         0.69

patch Choir family=pitch
  # A small spread, densely, in a scale: not a chord so much as many voices
  # very nearly in unison, which is what makes a choir sound like more than
  # one person.
  spread         4 st
  scatter        #4
  scale          #1
  size           220 ms
  density        60 /s
  jitter         0.6
  spray          0.4
  panspread      1
  cutoff         4500 Hz
  ampattack      1.4 s
  amprelease     4 s
  volume         0.62

patch Pollinate family=bloom
  # The signature. Grains seed children near where they died, and those
  # children seed more - four deep, each generation quieter than the last, so
  # it settles rather than piling up.
  bloom          0.8
  mutate         0.35
  generations    4
  size           140 ms
  density        45 /s
  spray          0.2
  panspread      0.7
  ampattack      0.4 s
  amprelease     3 s
  volume         0.61

patch Cascade family=bloom
  # Six generations deep with the mutation wide: the cloud keeps travelling
  # outward from wherever it started and does not come back.
  bloom          0.95
  mutate         0.8
  generations    6
  size           150 ms
  density        40 /s
  spray          0.15
  panspread      0.95
  ampattack      0.6 s
  amprelease     4 s
  volume         0.49

patch Seedling family=bloom
  # One generation and a light bloom: the effect at its most restrained,
  # where it reads as a doubling rather than as a cloud.
  bloom          0.3
  mutate         0.15
  generations    1
  size           160 ms
  density        45 /s
  spray          0.12
  ampattack      0.25 s
  amprelease     2 s
  volume         0.62

patch Spore family=bloom
  # Bloom with the mutation moved onto position and pan rather than pitch, so
  # the children scatter through the buffer and across the stereo field
  # instead of away from the note.
  bloom          0.85
  mutate         1
  generations    5
  spray          0.55
  panspread      1
  width          1
  size           110 ms
  density        55 /s
  ampattack      0.5 s
  amprelease     3.5 s
  volume         0.60

patch Thicket family=bloom
  # Bloom on top of a cloud that was already dense. Deliberately too much -
  # one patch in a bank should show what the control does at the end of its
  # travel.
  bloom          1
  mutate         0.5
  generations    6
  size           60 ms
  density        90 /s
  jitter         0.7
  spray          0.45
  panspread      0.9
  ampattack      0.3 s
  amprelease     2.5 s
  volume         0.61

patch Settle family=bloom
  # Bloom with a short amp decay under it, so the first generation is loud and
  # what follows is the sound falling away through its own children.
  bloom          0.9
  mutate         0.4
  generations    5
  size           150 ms
  density        42 /s
  spray          0.25
  ampattack      0.01 s
  ampdecay       1.6 s
  ampsustain     0.15
  amprelease     3 s
  volume         0.90

patch Slicer family=rhythm material=break
  # Snap full: grains land on the break's transients instead of wherever the
  # timer put them, so the cloud inherits the loop's rhythm rather than
  # averaging it away.
  snap           1
  size           120 ms
  density        16 /s
  jitter         0.15
  spray          0.05
  window         #2
  ampattack      0.01 s
  amprelease     1 s
  volume         1.50

patch Stutter family=rhythm material=break
  # Snap with short grains, densely, and hardly any spray: the same transient
  # found over and over, which is a stutter rather than a slice.
  snap           1
  spray          0.03
  size           40 ms
  density        45 /s
  jitter         0.05
  window         #2
  ampattack      0.005 s
  amprelease     0.4 s
  volume         1.50

patch "Scan Up" family=rhythm
  # The read point sweeping forward while a note is held, so a held chord
  # walks through the whole loop instead of sitting on one bar of it.
  scan           0.9
  position       0
  size           130 ms
  density        55 /s
  jitter         0.3
  spray          0.1
  ampattack      0.05 s
  amprelease     1.5 s
  volume         0.58

patch "Scan Down" family=rhythm
  # The same, backwards through the buffer. Not the same as playing the
  # grains reversed - the grains still run forwards, it is the window that
  # travels the other way.
  scan           -0.9
  position       1
  size           130 ms
  density        55 /s
  jitter         0.3
  spray          0.1
  ampattack      0.05 s
  amprelease     1.5 s
  volume         0.79

patch Ratchet family=rhythm material=break
  # Snap with the jitter at nothing, so the births are metronomic and land
  # exactly on transients. Machine-gun, and the one patch here with no
  # randomness in its timing at all.
  snap           1
  jitter         0
  spray          0.02
  size           55 ms
  density        32 /s
  window         #2
  ampattack      0.002 s
  amprelease     0.3 s
  volume         1.50

patch "Backwards Roll" family=rhythm material=break
  # Grains played tail-first but still landing on the beat: each hit arrives
  # as its own decay running up to a stop.
  reverse        1
  snap           0.85
  size           180 ms
  density        45 /s
  jitter         0.2
  spray          0.4
  window         #3
  ampattack      0.02 s
  amprelease     1.4 s
  volume         1.50

patch Crushed family=texture
  # Four bits. The quiet parts of the break turn to steps and the loud parts
  # survive, which is what bit reduction does and why it sounds like that.
  bits           4
  size           130 ms
  density        55 /s
  spray          0.3
  cutoff         7000 Hz
  ampattack      0.1 s
  amprelease     1.6 s
  volume         0.85

patch Downsampled family=texture
  # Rate reduction rather than bit depth: the aliases land underneath the
  # sound instead of on top of it, and follow the pitch the wrong way.
  crush          20
  size           150 ms
  density        50 /s
  spray          0.3
  ampattack      0.1 s
  amprelease     1.6 s
  volume         0.73

patch Wobbler family=texture
  # Per-grain pitch wobble, slowly. Tape that cannot hold its speed - and
  # because it is per grain, no two grains agree about how far off they are.
  wobble         35 cents
  wobblerate     0.55 Hz
  size           200 ms
  density        45 /s
  spray          0.25
  panspread      0.7
  ampattack      0.4 s
  amprelease     2.5 s
  volume         0.72

patch Underwater family=texture
  # Low and resonant. Everything above a few hundred hertz gone, and what is
  # left ringing round the corner.
  cutoff         420 Hz
  resonance      0.55
  filtertype     #3
  size           180 ms
  density        50 /s
  spray          0.35
  ampattack      0.6 s
  amprelease     3 s
  volume         0.78

patch Driven family=texture
  # The drive stage hard, which on a cloud is not the same as on one note:
  # every grain saturates against every other grain that happens to overlap
  # it, so the dirt comes and goes with the density.
  drive          0.8
  size           120 ms
  density        60 /s
  spray          0.3
  cutoff         6000 Hz
  ampattack      0.15 s
  amprelease     1.8 s
  volume         0.43

patch Telephone family=texture
  # Band-passed and bit-reduced together: a narrow, gritty middle with little
  # above or below it.
  #
  # The band was at 1400 Hz and twelve decibels a slope, which on a drum
  # break is a telephone and on a plucked chord is nothing at all - the seed's
  # energy is almost entirely under 600 Hz, and the patch measured fourteen
  # decibels below the rest of the bank with the volume knob already at its
  # ceiling. Down to 800 and a gentler slope. The same mistake as Mosaic's
  # Clav, which is worth knowing: a band-pass has to be told where the
  # material *is*.
  filtertype     #8
  cutoff         700 Hz
  resonance      0.35
  bits           6
  size           110 ms
  density        60 /s
  spray          0.3
  drive          0.75
  ampattack      0.08 s
  amprelease     1.2 s
  volume         1.50

patch "Live Hold" family=live input=break
  # Reading the live ring rather than the file: the last several seconds of
  # whatever went in, granulated while more arrives. On a phone that is you.
  #
  # **It used to ship with `freeze` on**, and a frozen ring at load time has
  # nothing in it - the patch was silent until something had been captured,
  # which is not a patch, it is a trap. Freeze is a performance control: you
  # hit it when there is something worth holding. The long buffer here is
  # what gives you time to decide.
  source         #1
  capture        1
  buffer         6 s
  size           150 ms
  density        55 /s
  spray          0.3
  panspread      0.8
  ampattack      0.3 s
  amprelease     2.5 s
  volume         1.13

patch "Eat Itself" family=live input=break
  # The output goes back into the ring, so the cloud granulates itself
  # granulating itself. Kept under the point where it runs away.
  source         #1
  capture        1
  feedback       0.72
  size           140 ms
  density        52 /s
  spray          0.35
  panspread      0.85
  cutoff         6000 Hz
  ampattack      0.3 s
  amprelease     3.5 s
  volume         1.22

patch "Feedback Bloom" family=live input=break
  # Feedback and pollination at once, which is this machine being the most
  # itself it can be: children of children, fed back in to be granulated
  # again.
  source         #1
  capture        1
  feedback       0.6
  bloom          0.8
  mutate         0.45
  generations    4
  size           120 ms
  density        50 /s
  spray          0.3
  panspread      0.9
  ampattack      0.4 s
  amprelease     4 s
  volume         0.77

patch "Ring Scan" family=live input=break
  # A moving window on recent input: the ring keeps filling while the read
  # point walks through it, so what you hear is always a few seconds behind
  # and always moving.
  source         #1
  capture        1
  scan           0.5
  size           140 ms
  density        55 /s
  jitter         0.3
  spray          0.12
  panspread      0.75
  ampattack      0.2 s
  amprelease     2 s
  volume         1.13

patch Capture family=live input=break
  # The ring recording while you play over it, unfrozen, so the buffer is
  # always the last few seconds and the cloud is always slightly behind what
  # just happened.
  source         #1
  capture        1
  buffer         2 s
  size           100 ms
  density        70 /s
  jitter         0.4
  spray          0.45
  panspread      0.8
  ampattack      0.1 s
  amprelease     1.8 s
  volume         0.77

patch Infinite family=live input=break
  # Fed back hard into a long ring, so what goes in keeps going round through
  # the grains and takes a long time to die. The one patch here that does not
  # really decay on its own.
  #
  # Not frozen, for the same reason Live Hold is not: a patch that loads
  # frozen loads silent. Hit freeze once it is going and it will hold there.
  source         #1
  capture        1
  buffer         6 s
  feedback       0.88
  size           200 ms
  density        45 /s
  spray          0.25
  panspread      0.9
  cutoff         5000 Hz
  ampattack      1 s
  amprelease     6 s
  volume         1.13
