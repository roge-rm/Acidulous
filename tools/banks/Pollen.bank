patch Infinite family=live input=break
  # Fed back hard into a long ring, so what goes in keeps going round through
  # the grains and takes a long time to die. The one patch here that does not
  # really decay on its own.
  #
  # Not frozen, for the same reason Live Hold is not: a patch that loads
  # frozen loads silent. Hit freeze once it is going and it will hold there.
  source         #1
  capture        1
  buffer         6 s
  feedback       0.88
  size           200 ms
  density        45 /s
  spray          0.25
  panspread      0.9
  cutoff         5000 Hz
  ampattack      1 s
  amprelease     6 s
  volume         1.13
  set macro1 "Less Feedback"
  mac1_d1  #26
  mac1_a1  -0.4
  set macro2 "Further Back"
  mac2_d1  #1
  mac2_a1  0.4
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  set macro4 "Longer"
  mac4_d1  #6
  mac4_a1  0.147
  mac4_d2  #29
  mac4_a2  -0.278
  set macro5 "Scatter"
  mac5_d1  #12
  mac5_a1  0.4
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  mac6_d2  #29
  mac6_a2  0.132
  set macro7 "Bloom"
  mac7_d1  #13
  mac7_a1  0.6
  mac7_d2  #29
  mac7_a2  -0.195
  set macro8 "Narrow"
  mac8_d1  #16
  mac8_a1  -0.5
  mac8_d2  #17
  mac8_a2  -0.6

