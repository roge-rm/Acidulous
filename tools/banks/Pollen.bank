  mac8_a2  -0.6

patch "Feedback Bloom" family=live input=break
  # Feedback and pollination at once, which is this machine being the most
  # itself it can be: children of children, fed back in to be granulated
  # again.
  source         #1
  capture        1
  feedback       0.6
  bloom          0.8
  mutate         0.45
  generations    4
  size           120 ms
  density        50 /s
  spray          0.3
  panspread      0.9
  ampattack      0.4 s
  amprelease     4 s
  volume         0.77
  set macro1 "Feedback"
  mac1_d1  #26
  mac1_a1  0.368
  set macro2 "Further Back"
  mac2_d1  #1
  mac2_a1  0.4
  mac2_d2  #29
  mac2_a2  0.22
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  set macro4 "Longer"
  mac4_d1  #6
  mac4_a1  0.2
  mac4_d2  #29
  mac4_a2  -0.241
  set macro5 "Scatter"
  mac5_d1  #12
  mac5_a1  0.4
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  mac6_d2  #29
  mac6_a2  0.237
  set macro7 "Bare"
  mac7_d1  #13
  mac7_a1  -0.6
  mac7_d2  #29
  mac7_a2  0.246
  set macro8 "Narrow"
  mac8_d1  #16
  mac8_a1  -0.5
  mac8_d2  #17
  mac8_a2  -0.6

patch "Ring Scan" family=live input=break
  # A moving window on recent input: the ring keeps filling while the read
  # point walks through it, so what you hear is always a few seconds behind
  # and always moving.
  source         #1
  capture        1
  scan           0.5
  size           140 ms
  density        55 /s
  jitter         0.3
  spray          0.12
  panspread      0.75
  ampattack      0.2 s
  amprelease     2 s
  volume         1.13
  set macro1 "Feedback"
  mac1_d1  #26
  mac1_a1  0.4
  set macro2 "Further Back"
  mac2_d1  #1
  mac2_a1  0.4
  mac2_d2  #29
  mac2_a2  -0.195
  set macro3 "Spray"
  mac3_d1  #3
  mac3_a1  0.4
  mac3_d2  #29
  mac3_a2  0.228
  set macro4 "Longer"
  mac4_d1  #6
  mac4_a1  0.2
  mac4_d2  #29
  mac4_a2  -0.344
  set macro5 "Scatter"
  mac5_d1  #12
  mac5_a1  0.4
  set macro6 "Dark"
  mac6_d1  #21
  mac6_a1  -0.4
  mac6_d2  #29
