  mac7_d2  #29
  mac7_a2  -0.11
  set macro8 "Swell"
  mac8_d1  #23
  mac8_a1  0.25
  mac8_d2  #24
  mac8_a2  0.15

patch Stillness family=cloud
  # The read point fixed and the grains long: one moment of the break held
  # open and looked at. Spray is what stops it being a loop of one buffer.
  position       0.34
  scan           0
  spray          0.02
  size           380 ms
  density        8 /s
  jitter         0.1
  window         #1
  ampattack      1.2 s
  amprelease     4 s
