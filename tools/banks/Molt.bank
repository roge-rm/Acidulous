patch Pluck family=shape
  # The words as a rhythm part: a syllable struck and mostly gone.
  #
  # Not all the way gone. A note that empties inside a tenth of a second
  # spends most of the window the bank is levelled in silent, and reads eight
  # decibels under everything around it - so it would be levelled up until it
  # peaked, which is the wrong end to fix it at. A third of the voice left
  # standing is still plainly plucked and sits with the rest of the bank.
  ampattack      0.004 s
  ampdecay       0.3 s
  ampsustain     0.34
  amprelease     0.12 s
  volume         1.5
  set macro1 "Slow In"
  mac1_d1  #8
  mac1_a1  0.35
  set macro2 "Longer"
  mac2_d1  #11
  mac2_a1  0.3
  set macro3 "More Hold"
  mac3_d1  #10
  mac3_a1  0.5
  mac3_d2  #14
  mac3_a2  -0.527
  set macro4 "Darker"
  mac4_d1  #6
  mac4_a1  -0.25
  set macro5 "Bigger"
  mac5_d1  #4
  mac5_a1  -0.2
  mac5_d2  #14
  mac5_a2  -0.088
  set macro6 "Grit"
  mac6_d1  #13
  mac6_a1  0.5
  mac6_d2  #14
  mac6_a2  -0.548
  set macro7 "Later"
  mac7_d1  #1
  mac7_a1  0.3
  set macro8 "Octave Down"
  mac8_d1  #16
  mac8_a1  -0.5
  mac8_d2  #14
  mac8_a2  -0.149

