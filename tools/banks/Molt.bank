patch Whisper family=play
  # Velocity doing most of the work, and the take started past its first
  # syllable so a short note lands on a vowel rather than on the breath in
  # front of it.
  velocity       0.9
  start          0.18
  cutoff         6000 Hz
  filtertype     #1
  drive          0.1
  volume         1.05
  set macro1 "Octave Down"
  mac1_d1  #16
  mac1_a1  -0.5
  mac1_d2  #14
  mac1_a2  -0.111
  set macro2 "Fifth Up"
