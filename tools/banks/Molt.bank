  mac6_a1  -0.25
  set macro7 "Grit"
  mac7_d1  #13
  mac7_a1  0.5
  mac7_d2  #14
  mac7_a2  -0.309
  set macro8 "Longer"
  mac8_d1  #11
  mac8_a1  0.3

patch "Octave Down" family=play
  # An octave below what is written, at the original size. Pitch and formant
  # separated, stated as plainly as the machine can state it.
  octave         #2
  formant        +4 st
  volume         0.79
  set macro1 "Octave Up"
  mac1_d1  #16
  mac1_a1  0.5
  set macro2 "Fifth Up"
