patch "Run Round" family=play
  # The take from nearly a third of the way in, round and round for as long
  # as the note is held, so a long note keeps talking.
  loop           #1
  start          0.3
  tune           0.9
  rate           30 ms
  volume         1.27
  set macro1 "Octave Down"
  mac1_d1  #16
