patch "Up High" family=play
  # An octave above what is written, with the throat taken a little back
  # down so it's the same singer up high rather than a chipmunk.
  octave         #4
  formant        -2 st
  volume         1.44
  set macro1 "Octave Down"
  mac1_d1  #16
  mac1_a1  -0.5
