patch Hollow family=tone
  # Tone down on everything that has one: the snare nearly all noise, the kick
  # with no click, the metal dark. What is left is the shape of the kit
  # without any of its edges.
  set macro1 "Tighter"
  set macro2 "Pitch"
  set macro3 "Bright"
  set macro4 "Snap"
  set macro5 "Click"
  set macro6 "Toms"
