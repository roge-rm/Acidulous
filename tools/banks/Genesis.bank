patch Plunge family=tone
  # The kick at the top of its tuning with the longest sweep, so it falls
  # two octaves on every hit, and the toms bending all the way down with it.
  # Everything pitched is up high and drifting. A kit of falling things.
  set macro1 "Tighter"
  set macro2 "Pitch"
  set macro3 "Bend"
  set macro4 "Sweep"
  set macro5 "Toms"
  set macro6 "Drift"
  set macro7 "Duck"
  set macro8 "Room"
  kicktune       90 Hz
