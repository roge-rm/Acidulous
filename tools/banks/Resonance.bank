patch Floorboards family=wood role=beat
  # A wooden room played as a kit: a stomp on the floor, heels, a creaking
  # board, a door, a table, a stair and a chair leg, with the floor
  # answering all of them. Pads: stomp, creak, heel, door, table, stair,
  # floor, chair leg.
  set macro1 "Pitch"
