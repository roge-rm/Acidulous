  mac1_a2  0.1
  mac2_d1  #1
  mac2_a1  0.8
  mac2_d2  #13
  mac2_a2  -0.05
  mac3_d1  #3
  mac3_a1  0.1
  mac3_d2  #7
  mac3_a2  0.3
  mac4_d1  #2
  mac4_a1  0.5
  mac5_d1  #15
  mac5_a1  -0.4
  mac5_d2  #17
  mac5_a2  -0.2
  mac6_d1  #17
  mac6_a1  0.3
  mac7_d1  #5
  mac7_a1  0.4
  mac7_d2  #6
  mac7_a2  0.2
  mac8_d1  #24
  mac8_a1  -0.5
  partials       64
  tilt           -16 dB/oct
  bandwidth      180 cents
  bbandwidth     -120 cents
  bwscale        1.4
  detune         14 cents
  drift          14 cents
  driftrate      0.07 Hz
  width          0.9
  cutoff         6000 Hz
  ampattack      2.5 s
  amprelease     5 s
  spread         #2
  volume         1.12

# Narrow bands and a high tilt: the partials stay separate, so it rings
# rather than washes. Bright without being hard.
patch Halo note=72 range=48..96 family=pad
  set macro1 "Brighten"
  set macro2 "Bloom"
  set macro3 "Width"
  set macro4 "Shimmer"
  set macro5 "Slow"
  set macro6 "Tail"
