# Starts closed and opens over three seconds of each note, from the
# filter's own envelope.
patch "Slow Bloom" note=60 range=36..84 family=pad
  set macro1 "Open"
  set macro2 "Bloom"
  set macro3 "Peak"
  set macro4 "Width"
  set macro5 "Morph"
  set macro6 "Tail"
  set macro7 "Drift"
