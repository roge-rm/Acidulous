  filtdecay      4 s
  filtsustain    0.6
  filtrelease    3 s
  ampattack      1.2 s
  amprelease     3 s
  volume         1.05
  send reverb    0.12

# Bands six semitones wide, which stops being a chorus and becomes
# weather. The second spectrum is *narrower*, so the morph pulls it back
# into focus rather than opening it further.
patch "Deep Wash" note=48 range=33..72 family=pad
  set macro1 "Brighten"
  set macro2 "Focus"
  set macro3 "Width"
  set macro4 "Shimmer"
  set macro5 "Quick"
  set macro6 "Tail"
  set macro7 "Drift"
  set macro8 "Sink"
  # Macros: each knob adds its depth to the destinations below.
