  amprelease     2.4 s
  volume         0.96

# And this is what happens when the notches *do* move: LFO1 walks the
# morph from a deep comb to its opposite, so the peaks and the troughs
# trade places over half a minute.
patch "Phase Cloud" note=60 range=36..84 family=comb role=drone
  set macro1 "Turn"
  set macro2 "Bright"
  set macro3 "Width"
  set macro4 "Weather"
  set macro5 "Sweep"
  set macro6 "Shimmer"
  set macro7 "Fade"
  set macro8 "Drive"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.8
  mac2_d1  #8
  mac2_a1  0.35
  mac2_d2  #9
  mac2_a2  0.1
  mac3_d1  #3
  mac3_a1  0.4
  mac3_d2  #7
  mac3_a2  0.3
  mac3_d3  #13
  mac3_a3  -0.1
  mac4_d1  #5
  mac4_a1  0.4
  mac4_d2  #6
  mac4_a2  0.3
  mac4_d3  #4
  mac4_a3  -0.2
  mac5_d1  #20
  mac5_a1  0.5
  mac5_d2  #19
  mac5_a2  0.3
  mac6_d1  #2
  mac6_a1  0.35
  mac6_d2  #13
  mac6_a2  -0.1
  mac7_d1  #15
  mac7_a1  0.3
  mac7_d2  #17
  mac7_a2  0.3
  mac8_d1  #12
  mac8_a1  0.5
  mac8_d2  #13
  mac8_a2  -0.1
  partials       60
  tilt           -11 dB/oct
  bandwidth      45 cents
  bbandwidth     20 cents
  comb           0.85
  combperiod     2.5
  bcomb          -1
  btilt          4 dB/oct
  lfo1morph      1
  lfo1rate       0.035 Hz
  detune         10 cents
  drift          12 cents
  width          0.9
  cutoff         9500 Hz
  ampattack      1.6 s
  amprelease     3.6 s
  volume         1.01

# A comb with the octave reader over it and the LFO turning the comb
# slowly, like light through a fence.
patch "Slatted Light" note=64 range=45..88 family=comb role=drone
  set macro1 "Turn"
  set macro2 "Bright"
  set macro3 "Width"
  set macro4 "Weather"
  set macro5 "Sweep"
