<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MIDI in. USB needs nothing but the feature; Bluetooth needs a scan,
      and a scan needs permission - which differs either side of Android 12,
      where the old "BLE scanning can infer location" rule was replaced by a
      permission that says outright what it is for.
    -->
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!--
      The permissions below would otherwise make Bluetooth, location and
      Wi-Fi required hardware - a store infers it from them - and a device
      without one would be told the app is not for it. Each is only for
      MIDI or Link, and the app works without both.
    -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!--
      Ableton Link: a tempo shared over the local network. Peers are found by
      multicast, which a Wi-Fi chip drops unless the app holds a
      MulticastLock - hence the third of these. None is a runtime permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Sampling and the vocoder both listen to what is coming in. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Playing is a thing the user can see, so it is a foreground service.
        Without one the process is cached the moment the activity is not in
        front: trimmable, freezable, and the first thing the scheduler gives up
        on. POST_NOTIFICATIONS is not requested at runtime anywhere - the
        service is asked for and, if the platform refuses it, playing carries
        on exactly as it did before.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Acidulous">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|navigation|fontScale"
            android:label="@string/app_name"
            android:theme="@style/Theme.Acidulous"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A MIDI file, a song bundle or a sound, opened with the app
                 or shared to it: the same place as File > Import. One task,
                 so it lands in the running app rather than a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="application/x-midi" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="audio/wav" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/vnd.wave" />
                <data android:mimeType="audio/aiff" />
                <data android:mimeType="audio/x-aiff" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/x-flac" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp3" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="application/x-midi" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="audio/wav" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/vnd.wave" />
                <data android:mimeType="audio/aiff" />
                <data android:mimeType="audio/x-aiff" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/x-flac" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp3" />
            </intent-filter>
        </activity>

        <!-- What the app hands to the share sheet: a song bundle it built. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>