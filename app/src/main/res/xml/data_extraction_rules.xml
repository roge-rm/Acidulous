<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up. The cloud backup keeps what backup_rules.xml keeps, and
    for the same reason: small, and yours. Moving to a new phone has no size
    limit, so it takes the samples too - everything under user/ - but still
    not the freeze renders or the cache, which the songs make again.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="user/songs" />
        <include domain="file" path="user/session.json" />
        <include domain="file" path="user/patches" />
        <include domain="file" path="user/tunings" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="user" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
