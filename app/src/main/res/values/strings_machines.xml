<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ui/MachinePanel.kt: what the panels say besides their controls' labels, which are in strings_panel_words.xml. -->

    <!-- A track with no patch chosen. -->
    <string name="machine_patch">patch</string>
    <!-- A patch that has been changed since it was loaded. -->
    <string name="machine_patch_edited">%s *</string>
    <string name="machine_patch_menu">%s ▾</string>
    <string name="machine_patch_name">Patch name</string>

    <!-- The drum kit (Forage) -->
    <string name="kit_clear_title">Clear the kit</string>
    <string name="kit_clear">Clear</string>
    <string name="kit_clear_note">Removes the samples from all thirteen pads and the slice file. The files stay in the app under samples….</string>
    <string name="kit_pad">pad %d</string>
    <string name="kit_not_loaded">%s (not loaded)</string>
    <string name="kit_no_sample">no sample</string>
    <!-- A pad's sample: its name, its length, and stereo or mono. -->
    <string name="kit_sample_info">%1$s  %2$s %3$s</string>
    <string name="kit_stereo_short">st</string>
    <string name="kit_mono">mono</string>
    <!-- A pad playing part of the slice file, and which part. -->
    <string name="kit_slice_of">slice %1$d of %2$s  %3$.0f%%-%4$.0f%%</string>
    <string name="kit_load">load…</string>
    <string name="kit_samples">samples…</string>
    <string name="kit_edit">edit…</string>
    <string name="kit_clear_pad">clear</string>
    <string name="kit_kit">kit…</string>
    <string name="kit_slice">slice…</string>
    <string name="kit_slicing">slicing…</string>
    <!-- Level the pads against each other. -->
    <string name="kit_match">match</string>
    <string name="kit_clear_kit">clear</string>

    <!-- Slicing a file across the pads -->
    <string name="slice_title">Slice across the pads</string>
    <string name="slice_confirm">Slice</string>
    <string name="slice_no_file">no file chosen</string>
    <string name="slice_choose">choose…</string>
    <string name="slice_change">change…</string>
    <string name="slice_where">where to cut</string>
    <string-array name="slice_modes">
        <item>transients</item>
        <item>even</item>
    </string-array>
    <string name="slice_transients_note">Cuts at the hits. If there are too many, the loudest are used; too few and it cuts evenly.</string>
    <string name="slice_even_note">Equal pieces.</string>
    <string name="slice_count">slices</string>
    <string name="slice_count_note" tools:ignore="PluralsCandidate">Pads 1 to %d get a slice each. Pads that already have their own sample keep it; clear them to use the slice.</string>

    <!-- The organ\'s input, and other listening -->
    <string name="machine_input">input</string>
    <string name="machine_listening">listening</string>
    <string name="machine_open">open</string>

