<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ui/MainScreen.kt: the song grid, its header, menus and readout. -->
    <string name="main_freezing">Freezing</string>

    <!-- The readout under the grid -->
    <!-- Clip mode with nothing playing; then what a tapped clip waits for. -->
    <string name="main_where_clips_idle">clip  -  q:%s</string>
    <!-- Clip mode: each playing track as track>scene bar.beat/cycle, then the quantise. -->
    <string name="main_where_clips">clip  %1$s  q:%2$s</string>
    <string name="main_counting_in">counting in… %d</string>
    <!-- S scene/scenes, the scene\'s name, r repeat/repeats, then bar.beat.tick. -->
    <string name="main_where_song">S%1$d/%2$d %3$-8s r%4$d/%5$d  %6$d.%7$d.%8$03d</string>

    <!-- The bar at the foot -->
    <string name="main_quantise_pill">q: %s</string>
    <!-- Play runs to the end of the song and stops. -->
    <string name="main_loop_end">⇥ end</string>
    <string name="main_loop_scene">⟳ scene</string>
    <string name="main_loop_song">⟳ song</string>

    <!-- The header -->
    <string name="main_save">save</string>
    <string name="main_file">file ▾</string>
    <string name="main_new_song">New song…</string>
    <string name="main_demo_songs">Demo songs…</string>
    <string name="main_save_as">Save as…</string>
    <string name="main_songs">Songs…</string>
